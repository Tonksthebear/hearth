<% content_for :title, "Meals · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="meal-week-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @meal_week.person.name %>'s weekly review</p>
      <h1 id="meal-week-heading" class="mt-2 text-3xl font-semibold tracking-tight">Meals</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        <%= @meal_week.start_date.to_fs(:long) %>–<%= @meal_week.end_date.to_fs(:long) %>.
        Household plans and <%= @meal_week.person.name %>'s own meals are kept separate.
      </p>
    </div>
    <% if @meal_week.unchecked_shopping_count.positive? %>
      <%= link_to "Shopping list (#{@meal_week.unchecked_shopping_count})", shopping_list_path(date: @meal_week),
        data: { turbo_prefetch: false },
        class: yass(btn: [ :base, { lg: :base }, { neutral: :solid } ]) %>
    <% end %>
  </div>

  <nav aria-label="Meal week" class="mt-6 flex items-center justify-between rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-4">
    <%= link_to "Previous week", meal_week_path(date: @meal_week.previous_date), class: "font-medium text-primary-800 dark:text-primary-300 underline hover:no-underline" %>
    <%= link_to "Next week", meal_week_path(date: @meal_week.next_date), class: "font-medium text-primary-800 dark:text-primary-300 underline hover:no-underline" %>
  </nav>

  <div class="mt-8">
    <%= render "shared/nutrition_summary",
      summary: @meal_week.nutrition_summary,
      id: "week-nutrition-heading",
      title: "Known nutrition this week",
      description: "Selected-person totals from historical meal snapshots; incomplete values stay visibly partial." %>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section aria-labelledby="plan-meal-heading" class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <h2 id="plan-meal-heading" class="text-xl font-semibold">Plan a meal</h2>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Choose whether this plan is shared or assigned to one person.</p>

      <% if @meal_week.planned_meal.errors.any? %>
        <%= render "layouts/alert", id: "planned-meal-errors", title: "The planned meal could not be saved:", messages: @meal_week.planned_meal.errors.full_messages, class: "mt-4" %>
      <% end %>

      <%= form_with model: @meal_week.planned_meal, class: "mt-5 grid gap-4" do |form| %>
        <%= hidden_field_tag :date, @meal_week.to_param %>
        <div>
          <%= form.label :planned_on, "Date", class: :label %>
          <%= form.date_field :planned_on, class: :text_field %>
        </div>
        <div>
          <%= form.label :recipe_id, "Planned recipe", class: :label %>
          <%= form.elements_autocomplete :recipe_id, @recipe_options,
            { value: @meal_week.planned_meal.recipe_id },
            { placeholder: "Choose a recipe", required: true } %>
        </div>
        <div>
          <%= form.label :person_id, "Plan for", class: :label %>
          <%= form.elements_autocomplete :person_id, @person_options,
            { value: @meal_week.planned_meal.person_id },
            { placeholder: "Whole household" } %>
        </div>
        <%= form.submit "Add to plan", class: { btn: [ :base, { lg: :base }, { primary: :solid }, "justify-self-start" ] } %>
      <% end %>
    </section>

    <section aria-labelledby="log-meal-heading" class="rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-gray-800/50">
      <h2 id="log-meal-heading" class="text-xl font-semibold">Log what was eaten</h2>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Record a complete meal with recipes, ingredients, free text, portions, and notes for <%= @meal_week.person.name %>.</p>
      <%= link_to "Log meal", new_meal_path(date: @meal_week.logging_date), class: yass(btn: [ :base, { lg: :base }, { primary: :solid }, "mt-5" ]) %>
    </section>
  </div>

  <div class="mt-8 grid gap-4">
    <% @meal_week.days.each do |day| %>
      <section aria-labelledby="day-<%= day.iso8601 %>" class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
        <h2 id="day-<%= day.iso8601 %>" class="text-lg font-semibold"><%= day.to_fs(:long) %></h2>
        <% day_nutrition = @meal_week.nutrition_for(day) %>
        <% if day_nutrition.totals.any? %>
          <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600 dark:text-gray-400">
            <% day_nutrition.totals.each do |total| %><div><dt class="inline font-medium"><%= total.name %></dt> <dd class="inline"><%= total.formatted_amount %></dd></div><% end %>
            <div><dt class="sr-only">Nutrition status</dt><dd class="inline font-medium"><%= day_nutrition.status.humanize %></dd></div>
          </dl>
        <% end %>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Planned</h3>
            <% if @meal_week.planned_meals_for(day).any? %>
              <ul class="mt-2 grid gap-2">
                <% @meal_week.planned_meals_for(day).each do |planned_meal| %>
                  <li class="rounded-lg bg-primary-50 p-3 dark:bg-primary-500/10">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="font-medium"><%= link_to planned_meal.recipe.title, planned_meal.recipe, class: "underline" %></p>
                        <p class="text-sm text-gray-600 dark:text-gray-400"><%= planned_meal.person ? planned_meal.person.name : "Whole household" %></p>
                      </div>
                      <div class="flex flex-col items-end gap-2">
                        <% if (meal = @meal_week.converted_meal_for(planned_meal)) %>
                          <%= link_to "View logged meal", meal, class: "text-sm font-semibold text-primary-800 underline dark:text-primary-300" %>
                        <% elsif planned_meal.convertible_by?(@meal_week.person) %>
                          <%= button_to "Log as eaten", planned_meal_meal_path(planned_meal), class: yass(btn: [ :base, { sm: :base }, { primary: :solid } ]) %>
                        <% end %>
                        <% if planned_meal.meals.empty? %>
                          <%= button_to "Remove", planned_meal_path(planned_meal), method: :delete,
                            params: { date: @meal_week.to_param },
                            form: { data: { turbo_confirm: "Remove this meal from the plan?" } },
                            class: "text-sm font-medium text-gray-700 underline hover:no-underline dark:text-gray-300" %>
                        <% end %>
                      </div>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Nothing planned.</p>
            <% end %>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Eaten</h3>
            <% if @meal_week.meals_for(day).any? %>
              <ul class="mt-2 grid gap-2">
                <% @meal_week.meals_for(day).each do |meal| %>
                  <li class="rounded-lg bg-gray-100 dark:bg-white/5 p-3">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="font-medium"><%= link_to meal.description, meal, class: "underline" %></p>
                        <p class="text-sm text-gray-600 dark:text-gray-400"><%= pluralize(meal.meal_items.size, "item") %></p>
                      </div>
                      <%= button_to "Remove", meal_path(meal), method: :delete,
                        params: { date: @meal_week.to_param },
                        form: { data: { turbo_confirm: "Remove this meal?" } },
                        class: "text-sm font-medium text-gray-700 dark:text-gray-300 underline hover:no-underline" %>
                    </div>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Nothing logged.</p>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</section>
