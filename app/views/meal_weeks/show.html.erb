<% content_for :title, "Meals · Hearth" %>
<%= render "layouts/meals_navigation" %>

<div class="max-w-7xl">
<section aria-labelledby="meal-week-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 id="meal-week-heading" class="text-balance text-3xl font-semibold tracking-tight">Meals</h1>
      <p class="mt-2 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">
        <%= @meal_week.start_date.to_fs(:long) %>–<%= @meal_week.end_date.to_fs(:long) %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= render Elements::DisclosureComponent.new(id: "plan-meal", hidden: @meal_week.planned_meal.errors.empty?) do |disclosure| %>
        <%= disclosure.button("Plan meal", class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ])) %>
        <%= link_to "Log meal", new_meal_path(date: @meal_week.logging_date), class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>

        <%= disclosure.panel do %>
          <section aria-labelledby="plan-meal-heading" class="mt-5 w-full rounded-xl bg-white p-5 ring-1 ring-gray-950/10 dark:bg-white/5 dark:ring-white/10">
            <h2 id="plan-meal-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Plan a meal</h2>
            <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Add a recipe for the household or one person.</p>

            <% if @meal_week.planned_meal.errors.any? %>
              <%= render "layouts/alert", id: "planned-meal-errors", title: "The planned meal could not be saved:", messages: @meal_week.planned_meal.errors.full_messages, class: "mt-4" %>
            <% end %>

            <%= form_with model: @meal_week.planned_meal, class: "mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)_minmax(0,1fr)_auto] lg:items-end" do |form| %>
              <%= hidden_field_tag :date, @meal_week.to_param %>
              <div>
                <%= form.label :planned_on, "Date", class: :label %>
                <%= form.date_field :planned_on, class: :text_field %>
              </div>
              <div>
                <%= form.label :recipe_id, "Recipe", class: :label %>
                <%= form.elements_autocomplete :recipe_id, @recipe_options,
                  { value: @meal_week.planned_meal.recipe_id },
                  { placeholder: "Choose a recipe", required: true } %>
              </div>
              <div>
                <%= form.label :person_id, "Plan for", class: :label %>
                <%= form.elements_autocomplete :person_id, @person_options,
                  { value: @meal_week.planned_meal.person_id },
                  { placeholder: "Whole household" } %>
              </div>
              <%= form.submit "Add to plan", class: class_names(yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]), "justify-self-start") %>
            <% end %>
          </section>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render "shared/shopping_attention",
    count: @meal_week.unchecked_shopping_count,
    date: @meal_week,
    class: "mt-6" %>

  <nav aria-label="Meal week" class="mt-6 flex flex-wrap items-center gap-2">
    <%= link_to "Previous", meal_week_path(date: @meal_week.previous_date), class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
    <%= link_to "Current week", meal_week_path, aria: ({ current: "page" } if @meal_week.current_week?), class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
    <%= link_to "Next", meal_week_path(date: @meal_week.next_date), class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
  </nav>

  <div class="mt-8 space-y-8">
    <section aria-labelledby="meal-agenda-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <h2 id="meal-agenda-heading" class="text-balance text-xl font-semibold"><%= @meal_week.current_week? ? "Today and upcoming" : "Week" %></h2>
          <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">See what is planned and record what was eaten.</p>
        </div>
      </div>
      <div class="mt-4 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/10 dark:divide-white/10 dark:bg-gray-800/50 dark:ring-white/10">
        <% if @meal_week.agenda_days.any? %>
          <% @meal_week.agenda_days.each do |day| %>
            <%= render "meal_weeks/day", meal_week: @meal_week, day: day %>
          <% end %>
          <% if @meal_week.current_week? && @meal_week.agenda_days.one? %>
            <div class="px-4 py-4 sm:px-6">
              <p class="text-pretty text-base/7 text-gray-500 sm:text-sm/6 dark:text-gray-400">Nothing else is planned this week.</p>
            </div>
          <% end %>
        <% else %>
          <div class="px-4 py-8 text-center sm:px-6">
            <h3 class="text-balance font-semibold text-gray-900 dark:text-white">No meals this week</h3>
            <p class="mx-auto mt-1 max-w-[48ch] text-pretty text-base/7 text-gray-500 sm:text-sm/6 dark:text-gray-400">Plan a recipe or log what was eaten to start this week.</p>
          </div>
        <% end %>
      </div>
    </section>

    <% if @meal_week.earlier_days.any? %>
      <section aria-labelledby="earlier-meals-heading">
        <%= render Elements::DisclosureComponent.new(id: "earlier-meals", hidden: !@meal_week.earlier_days_need_attention?) do |disclosure| %>
          <h2>
            <%= disclosure.button(class: "flex w-full items-center justify-between gap-4 rounded-lg py-2 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-500") do %>
              <span class="flex items-baseline gap-2">
                <span id="earlier-meals-heading" class="text-xl font-semibold text-gray-900 dark:text-white"><%= @meal_week.earlier_days_need_attention? ? "Earlier plans need attention" : "Earlier this week" %></span>
                <span class="tabular-nums text-base text-gray-500 sm:text-sm dark:text-gray-400"><%= @meal_week.earlier_days.size %></span>
              </span>
              <span class="flex items-center gap-2 text-base/7 font-semibold text-primary-700 sm:text-sm/6 dark:text-primary-300">
                <span class="in-aria-expanded:hidden">Show</span>
                <span class="hidden in-aria-expanded:block">Hide</span>
                <%= icon "chevron-down", variant: :micro, class: "size-4 shrink-0 transition-transform in-aria-expanded:rotate-180" %>
              </span>
            <% end %>
          </h2>
          <%= disclosure.panel do %>
            <div class="mt-3 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/10 dark:divide-white/10 dark:bg-gray-800/50 dark:ring-white/10">
              <% @meal_week.earlier_days.each do |day| %>
                <%= render "meal_weeks/day", meal_week: @meal_week, day: day %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</section>

<section aria-labelledby="meal-week-details-heading" class="mt-10 border-t border-gray-950/10 pt-6 dark:border-white/10">
  <%= render Elements::DisclosureComponent.new(id: "meal-week-details") do |disclosure| %>
    <h2>
      <%= disclosure.button(class: "flex w-full items-start justify-between gap-4 rounded-lg py-2 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-500") do %>
        <span class="block">
          <span id="meal-week-details-heading" class="block text-xl font-semibold text-gray-900 dark:text-white">Week details</span>
          <span class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">
            <span>Nutrition<% if @meal_week.nutrition_summary.totals.any? %> <%= @meal_week.nutrition_summary.status.humanize.downcase %><% end %></span>
            <% if @meal_week.unchecked_shopping_count.positive? %><span><%= pluralize(@meal_week.unchecked_shopping_count, "shopping item") %></span><% end %>
          </span>
        </span>
        <%= icon "chevron-down", variant: :micro, class: "mt-1 size-4 shrink-0 transition-transform in-aria-expanded:rotate-180" %>
      <% end %>
    </h2>
    <%= disclosure.panel do %>
      <div class="mt-5 space-y-6">
        <% if @meal_week.unchecked_shopping_count.positive? %>
          <%= link_to "Open shopping list (#{@meal_week.unchecked_shopping_count})", shopping_list_path(date: @meal_week),
            data: { turbo_prefetch: false },
            class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
        <% end %>
        <%= render "shared/nutrition_summary",
          summary: @meal_week.nutrition_summary,
          id: "week-nutrition-heading",
          title: "Nutrition",
          description: "Known totals from logged meal snapshots; missing data is not counted as zero.",
          empty_title: "No nutrition logged this week",
          empty_description: "Log a meal with ingredient amounts to see nutrition totals for this week.",
          empty_action_label: "Log a meal",
          empty_action_path: new_meal_path(date: @meal_week.logging_date) %>
      </div>
    <% end %>
  <% end %>
</section>
</div>
