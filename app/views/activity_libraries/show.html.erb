<% content_for :title, "Activities library · Hearth" %>
<%= render "layouts/activities_navigation" %>

<div>
  <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @activity_library.person.name %>'s activities</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">Library</h1>
  <p class="mt-2 text-gray-600 dark:text-gray-400">Specialized training and recovery tools stay organized behind one Activities entry point.</p>
</div>

<div class="mt-10 grid gap-8 lg:grid-cols-2">
  <% @activity_library.sections.each do |section| %>
    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-800/50" aria-labelledby="library-<%= section.key %>-heading">
      <div class="flex items-start justify-between gap-4 border-b border-gray-200 px-5 py-4 dark:border-white/10">
        <div>
          <h2 id="library-<%= section.key %>-heading" class="font-semibold text-gray-900 dark:text-white"><%= section.title %></h2>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= section.description %></p>
        </div>
        <% case section.key %>
        <% when :workout_templates %>
          <%= link_to "All templates", workout_templates_path, class: "shrink-0 text-sm font-semibold text-primary-700 dark:text-primary-300" %>
        <% when :exercises %>
          <%= link_to "All exercises", exercises_path, class: "shrink-0 text-sm font-semibold text-primary-700 dark:text-primary-300" %>
        <% when :habits %>
          <%= link_to "All habits", habits_path, class: "shrink-0 text-sm font-semibold text-primary-700 dark:text-primary-300" %>
        <% when :recovery %>
          <%= link_to "Recovery today", recovery_day_path, class: "shrink-0 text-sm font-semibold text-primary-700 dark:text-primary-300" %>
        <% end %>
      </div>
      <ul role="list" class="divide-y divide-gray-100 dark:divide-white/5">
        <% section.records.each do |record| %>
          <li class="flex items-center justify-between gap-4 px-5 py-4">
            <p class="min-w-0 truncate text-sm font-semibold text-gray-900 dark:text-white">
              <% if record.is_a?(WorkoutTemplate) %>
                <%= link_to record.title, record, class: "hover:underline" %>
              <% elsif record.is_a?(Exercise) %>
                <%= link_to record.name, record, class: "hover:underline" %>
              <% elsif record.is_a?(Habit) %>
                <%= link_to record.name, edit_habit_path(record), class: "hover:underline" %>
              <% else %>
                <%= record.habit.name %>
              <% end %>
            </p>
            <% if record.is_a?(PersonHabit) %>
              <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= record.active? ? "Active" : "Inactive" %></span>
            <% end %>
          </li>
        <% end %>
        <% if section.records.empty? %>
          <li class="px-5 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Nothing in this section yet.</li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>

<p class="mt-8"><%= link_to "Open training week details", training_week_path, class: "font-semibold text-primary-700 underline dark:text-primary-300" %></p>
