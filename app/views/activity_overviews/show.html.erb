<% content_for :title, "Activities · Hearth" %>
<%= render "layouts/activities_navigation" %>

<div>
  <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @activity_overview.person.name %></p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight">Activities</h1>
  <p class="mt-2 text-gray-600 dark:text-gray-400">Training, recovery, and household activity catalogs in one place.</p>
</div>

<div class="mt-8 grid gap-5 md:grid-cols-2">
  <% @activity_overview.sections.each do |section| %>
    <% path = public_send("#{section.destination}_path") %>
    <article data-activity-section="<%= section.key %>" class="rounded-xl border border-gray-200 bg-white p-5 shadow-xs dark:border-white/10 dark:bg-gray-800/50">
      <h2 class="text-xl font-semibold"><%= link_to section.title, path, class: "text-primary-800 underline hover:no-underline dark:text-primary-300" %></h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400"><%= section.description %></p>
      <p class="mt-4 text-sm font-semibold"><%= pluralize(section.records.size, "item") %></p>
      <ul class="mt-3 space-y-1 text-sm text-gray-600 dark:text-gray-400">
        <% section.records.first(3).each do |item| %><li><%= item.title %></li><% end %>
      </ul>
      <%= link_to "Open #{section.title}", path, class: "mt-4 inline-flex text-sm font-semibold text-primary-800 underline dark:text-primary-300" %>
    </article>
  <% end %>
</div>
