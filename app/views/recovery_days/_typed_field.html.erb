<% field = TypedHabitValue::VALUE_COLUMNS.fetch(metric.value_type) %>
<%= form.label field, label, class: :label %>
<% case metric.value_type %>
<% when "number" %>
  <div class="flex items-center gap-2">
    <%= form.number_field field, step: "any", required: required, class: :text_field %>
    <span class="text-sm text-gray-500 dark:text-gray-400"><%= metric.unit %></span>
  </div>
<% when "duration" %>
  <div class="flex items-center gap-2">
    <%= form.number_field field, min: 0, step: 1, required: required, class: :text_field %>
    <span class="text-sm text-gray-500 dark:text-gray-400"><%= metric.unit %></span>
  </div>
<% when "time_of_day" %>
  <%= form.time_field field, required: required, class: :text_field %>
<% when "boolean" %>
  <%= form.elements_select field, [ [ "Yes", true ], [ "No", false ] ], { include_blank: required ? "Choose" : "No target" }, required: required %>
<% end %>
