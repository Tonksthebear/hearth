<% content_for :title, "Recovery" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-amber-700"><%= @current_person.name %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Recovery</h1>
    <p class="mt-3 text-stone-600"><%= @recovery_day.date.to_fs(:long) %> · Tracking tools, not medical advice.</p>
  </div>
  <%= link_to "Manage habits", habits_path, class: "rounded-lg border border-stone-300 px-4 py-2 font-semibold hover:bg-stone-100" %>
</div>

<section aria-labelledby="today-heading" class="mt-10">
  <h2 id="today-heading" class="text-2xl font-semibold">Today</h2>
  <div class="mt-5 space-y-5">
    <% @recovery_day.actionable_entries.each do |entry| %>
      <% check_in = @recovery_day.check_in_for(entry) %>
      <article id="today-person-habit-<%= entry.person_habit.id %>" class="rounded-xl border border-stone-200 bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h3 class="text-xl font-semibold"><%= entry.habit.name %></h3>
            <% if entry.habit.description.present? %><p class="mt-1 text-stone-600"><%= entry.habit.description %></p><% end %>
          </div>
          <%= link_to "Configure", edit_person_habit_path(entry.person_habit), class: "text-sm font-semibold text-amber-800 underline" %>
        </div>

        <% if entry.habit.habit_metrics.empty? %>
          <div class="mt-5 flex flex-wrap gap-3">
            <% if check_in.persisted? %>
              <span class="rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-800">Checked</span>
              <%= button_to "Clear", habit_check_in_path(check_in), method: :delete, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold" %>
            <% else %>
              <%= button_to "Check off", habit_check_ins_path, params: { habit_check_in: { person_habit_id: entry.person_habit.id } }, class: "rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white" %>
            <% end %>
          </div>
        <% else %>
          <%= form_with model: check_in, class: "mt-5 space-y-4" do |form| %>
            <%= form.hidden_field :person_habit_id, value: entry.person_habit.id %>
            <% if check_in.errors.any? %>
              <div id="check-in-errors" class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
                <ul class="list-disc pl-5"><% check_in.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
              </div>
            <% end %>
            <%= form.fields_for :habit_check_in_measurements do |measurement_form| %>
              <% measurement = measurement_form.object %>
              <% target = entry.person_habit.person_habit_metrics.find { |row| row.habit_metric_id == measurement.habit_metric_id && row.value? } %>
              <div class="rounded-lg border border-stone-200 p-4">
                <%= measurement_form.hidden_field :id if measurement.persisted? %>
                <%= measurement_form.hidden_field :habit_metric_id %>
                <%= render "recovery_days/typed_field", form: measurement_form, metric: measurement.habit_metric, label: measurement.habit_metric.label, required: true %>
                <% if target %>
                  <p class="mt-2 text-sm text-stone-500">Your target: <%= target.display_value %><%= " #{measurement.habit_metric.unit}" if measurement.habit_metric.unit.present? %></p>
                <% end %>
              </div>
            <% end %>
            <div>
              <%= form.label :notes, "Notes (optional)", class: "block text-sm font-medium" %>
              <%= form.text_area :notes, rows: 2, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
            </div>
            <div class="flex flex-wrap gap-3">
              <%= form.submit(check_in.persisted? ? "Correct today's check-in" : "Record today's check-in", class: "cursor-pointer rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white") %>
            </div>
          <% end %>
          <% if check_in.persisted? %>
            <%= button_to "Clear", habit_check_in_path(check_in), method: :delete, class: "mt-3 rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold" %>
          <% end %>
        <% end %>
      </article>
    <% end %>
    <% if @recovery_day.actionable_entries.empty? %>
      <p class="rounded-xl border border-dashed border-stone-300 p-8 text-center text-stone-600">No habits scheduled today.</p>
    <% end %>
  </div>
</section>

<section aria-labelledby="recent-heading" class="mt-12">
  <h2 id="recent-heading" class="text-2xl font-semibold">Recent adherence</h2>
  <p class="mt-2 text-sm text-stone-500">Unrecorded dates, including dates before activation, use your current schedule, so schedule edits can relabel them. Recorded check-ins remain checked.</p>
  <div class="mt-5 space-y-5">
    <% @recovery_day.entries.each do |entry| %>
      <article class="rounded-xl border border-stone-200 bg-white p-5">
        <div class="flex items-center justify-between gap-4">
          <h3 class="font-semibold"><%= entry.habit.name %></h3>
          <% if entry.history_only? %><span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-stone-600">History only</span><% end %>
        </div>
        <dl class="mt-4 grid gap-3 sm:grid-cols-7">
          <% @recovery_day.dates.each do |date| %>
            <% status = entry.status_on(date) %>
            <div class="rounded-lg border border-stone-200 p-3">
              <dt class="text-xs font-semibold text-stone-500"><%= date.strftime("%a %-m/%-d") %></dt>
              <dd class="mt-1 text-sm font-medium">
                <%= { checked: "Checked", not_checked: "Not checked", not_scheduled: "Not scheduled", no_record: "No record" }.fetch(status) %>
              </dd>
              <% if entry.check_in_on(date)&.recorded_measurements&.any? %>
                <ul class="mt-2 text-xs text-stone-500">
                  <% entry.check_in_on(date).recorded_measurements.each do |measurement| %>
                    <li><%= measurement.habit_metric.label %>: <%= measurement.display_value %><%= " #{measurement.habit_metric.unit}" if measurement.habit_metric.unit.present? %></li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>
        </dl>
      </article>
    <% end %>
  </div>
</section>
