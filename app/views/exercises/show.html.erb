<% content_for :title, "#{@exercise.name} · Hearth" %>
<article aria-labelledby="exercise-heading">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-amber-700"><%= @exercise.modality.humanize %> · <%= @exercise.movement_pattern.humanize %></p>
      <h1 id="exercise-heading" class="mt-2 text-3xl font-semibold tracking-tight"><%= @exercise.name %></h1>
    </div>
    <div class="flex gap-3">
      <%= link_to "Edit exercise", edit_exercise_path(@exercise), class: "rounded-lg border border-stone-300 px-4 py-2 font-semibold hover:bg-stone-100" %>
      <%= button_to "Delete exercise", exercise_path(@exercise), method: :delete, class: "rounded-lg border border-red-200 px-4 py-2 font-semibold text-red-800 hover:bg-red-50" %>
    </div>
  </div>
  <dl class="mt-8 grid gap-4 rounded-xl border border-stone-200 bg-white p-5 sm:grid-cols-2">
    <div><dt class="text-sm text-stone-500">Equipment</dt><dd class="mt-1"><%= @exercise.equipment.presence || "None recorded" %></dd></div>
    <div><dt class="text-sm text-stone-500">Guidance</dt><dd class="mt-1"><%= @exercise.guidance.presence || "None recorded" %></dd></div>
  </dl>
  <p class="mt-8"><%= link_to "Back to exercises", exercises_path, class: "font-medium text-amber-800 underline" %></p>
</article>
