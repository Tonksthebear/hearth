<section aria-label="Muscle targets" class="mt-8">
  <h2 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-white">Muscle targets</h2>
  <% if muscle_map.text_targets.any? %>
    <ul class="mt-4 space-y-2 rounded-xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-gray-800/50">
      <% muscle_map.text_targets.each do |target| %>
        <li class="flex flex-wrap items-baseline justify-between gap-3">
          <span class="font-medium text-gray-900 dark:text-white"><%= target.muscle.name %></span>
          <span class="text-sm text-gray-600 dark:text-gray-400"><%= target.role.humanize %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-gray-600 dark:text-gray-400">No muscle targets recorded.</p>
  <% end %>
</section>
