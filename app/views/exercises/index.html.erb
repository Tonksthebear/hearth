<% content_for :title, "Exercises · Hearth" %>

<section aria-labelledby="exercises-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">Shared household catalog</p>
      <h1 id="exercises-heading" class="mt-2 text-3xl font-semibold tracking-tight">Exercises</h1>
      <p class="mt-2 text-stone-600">Reusable structured movements for templates and workout logs.</p>
    </div>
    <%= link_to "Add exercise", new_exercise_path, class: "rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-600" %>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <% @exercises.each do |exercise| %>
      <article class="rounded-xl border border-stone-200 bg-white p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500"><%= exercise.modality.humanize %> · <%= exercise.movement_pattern.humanize %></p>
        <h2 class="mt-2 text-xl font-semibold"><%= link_to exercise.name, exercise, class: "text-amber-900 underline hover:no-underline" %></h2>
        <% if exercise.equipment.present? %><p class="mt-2 text-sm text-stone-600">Equipment: <%= exercise.equipment %></p><% end %>
      </article>
    <% end %>
  </div>

  <% if @exercises.empty? %>
    <p class="mt-8 rounded-xl border border-dashed border-stone-300 p-6 text-stone-600">No exercises yet.</p>
  <% end %>
</section>
