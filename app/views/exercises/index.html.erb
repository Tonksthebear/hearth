<% content_for :title, "Exercises · Hearth" %>

<section aria-labelledby="exercises-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared household catalog</p>
      <h1 id="exercises-heading" class="mt-2 text-3xl font-semibold tracking-tight">Exercises</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">Reusable structured movements for templates and workout logs.</p>
    </div>
    <%= link_to "Add exercise", new_exercise_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    <% @exercises.each do |exercise| %>
      <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= exercise.modality.humanize %> · <%= exercise.movement_pattern.humanize %></p>
        <h2 class="mt-2 text-xl font-semibold"><%= link_to exercise.name, exercise, class: "text-primary-900 underline hover:no-underline" %></h2>
        <% if exercise.equipment.present? %><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Equipment: <%= exercise.equipment %></p><% end %>
      </article>
    <% end %>
  </div>

  <% if @exercises.empty? %>
    <p class="mt-8 rounded-xl border border-dashed border-gray-300 p-6 text-gray-600 dark:text-gray-400">No exercises yet.</p>
  <% end %>
</section>
