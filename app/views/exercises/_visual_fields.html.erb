<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="grid gap-4 rounded-lg bg-gray-50 p-4 dark:bg-white/5">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= form.label :kind, class: :label %>
        <%= form.elements_select :kind, visual_kinds.map { |value| [ value.humanize, value ] }, {} %>
      </div>
      <div>
        <%= form.label :provenance_status, "Provenance", class: :label %>
        <%= form.elements_select :provenance_status, provenance_statuses.map { |value| [ value.humanize, value ] }, {} %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :alt_text, "Accessible description", class: :label %>
        <%= form.text_field :alt_text, required: true, class: :text_field %>
      </div>
      <div>
        <%= form.label :caption, class: :label %>
        <%= form.text_field :caption, class: :text_field %>
      </div>
      <div>
        <%= form.label :display_attribution, "Display attribution", class: :label %>
        <%= form.text_field :display_attribution, class: :text_field %>
      </div>
      <div>
        <%= form.label :frame_interval_ms, "Frame interval (ms)", class: :label %>
        <%= form.number_field :frame_interval_ms, min: 100, max: 5000, class: :text_field %>
        <p class="mt-1 text-sm/6 text-gray-500 dark:text-gray-400">Used for frame sequences. Leave blank for images and videos.</p>
      </div>
    </div>
    <div class="flex items-center justify-between gap-4">
      <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Files</h3>
      <%= form.button "Add file",
        name: "add_visual_item",
        value: form.index,
        formnovalidate: true,
        class: { btn: [ :base, { md: :base }, { neutral: :outline } ] },
        aria: { label: "Add file to visual #{form.object.position}" } %>
    </div>
    <div class="space-y-3">
      <%= form.fields_for :exercise_visual_items do |item_form| %>
        <%= render "visual_item_fields", form: item_form, visual_index: form.index %>
      <% end %>
    </div>
    <div>
      <%= form.button "Remove visual",
        name: "remove_visual",
        value: form.index,
        formnovalidate: true,
        class: { btn: [ :base, { md: :base }, { danger: :outline } ] },
        aria: { label: "Remove visual #{form.object.position}" } %>
    </div>
  </div>
<% end %>
