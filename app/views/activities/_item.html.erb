<li class="flex flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6"
    data-activity-kind="<%= item.kind %>"
    data-activity-status="<%= item.status %>"
    data-today-kind="<%= item.kind %>"
    data-today-status="<%= item.status %>">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <p class="font-semibold text-gray-900 dark:text-white">
        <% if item.destination.present? %>
          <%= link_to item.title, polymorphic_path(item.destination), class: "text-primary-800 underline hover:no-underline dark:text-primary-300" %>
        <% else %>
          <%= item.title %>
        <% end %>
      </p>
      <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-500/10 ring-inset dark:bg-gray-400/10 dark:text-gray-300 dark:ring-gray-400/20">
        <%= item.kind.to_s.humanize %>
      </span>
      <span class="inline-flex items-center rounded-md bg-primary-50 px-2 py-1 text-xs font-medium text-primary-700 ring-1 ring-primary-700/10 ring-inset dark:bg-primary-400/10 dark:text-primary-300 dark:ring-primary-400/30">
        <%= item.status.to_s.humanize %>
      </span>
    </div>
    <% if item.description.present? %>
      <p class="mt-1 text-sm/6 text-gray-500 dark:text-gray-400"><%= item.description %></p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% if item.record.is_a?(PlannedWorkout) && item.status == :planned %>
      <%= button_to "Start", training_sessions_path,
            params: { planned_workout_id: item.record.id },
            class: yass(btn: [ :base, { md: :base }, { primary: :solid } ]) %>
      <% if item.record.skippable? %>
        <%= form_with url: planned_workout_skip_path(item.record), scope: :planned_workout, class: "flex items-end gap-2" do |form| %>
          <div>
            <%= form.label :skip_reason, "Skip reason (optional)", class: "sr-only" %>
            <%= form.text_field :skip_reason, placeholder: "Skip reason", class: :text_field %>
          </div>
          <%= form.submit "Skip", class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
        <% end %>
      <% end %>
      <%= form_with model: item.record, class: "flex items-end gap-2" do |form| %>
        <div>
          <%= form.label :scheduled_on, "Reschedule date", class: "sr-only" %>
          <%= form.date_field :scheduled_on, class: :text_field, required: true %>
        </div>
        <%= form.submit "Reschedule", class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
      <% end %>
      <%= button_to "Remove", planned_workout_path(item.record),
            method: :delete,
            form: { data: { turbo_confirm: "Remove this workout from the plan?" } },
            class: yass(btn: [ :base, { md: :base }, { danger: :outline } ]) %>
    <% elsif item.record.is_a?(PlannedWorkout) && item.status == :skipped %>
      <%= button_to "Restore", planned_workout_skip_path(item.record),
            method: :delete,
            class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
    <% elsif item.kind == :simple_habit && item.status == :planned && actionable %>
      <%= button_to "Check off",
            habit_check_ins_path,
            params: { habit_check_in: { person_habit_id: item.record.id }, return_to: return_to, date: activity_date },
            class: yass(btn: [ :base, { md: :base }, { primary: :solid } ]) %>
    <% elsif item.kind == :measured_habit && item.status == :planned && actionable %>
      <%= link_to "Record details", recovery_day_path(anchor: "recovery-person-habit-#{item.record.id}"), class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
    <% end %>
  </div>
</li>
