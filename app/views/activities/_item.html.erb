<% today_execution = local_assigns[:today_execution] %>
<% show_status = local_assigns.fetch(:show_status, true) %>
<% planned_workout = item.record.is_a?(PlannedWorkout) && item.status == :planned %>
<% execution_button = local_assigns[:primary_action] ? { primary: :solid } : { neutral: :outline } %>

<li class="flex flex-col gap-4 px-4 py-4 <%= planned_workout ? "sm:grid sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center" : "sm:flex-row sm:items-center sm:justify-between" %> sm:px-6"
    data-activity-kind="<%= item.kind %>"
    data-activity-status="<%= item.status %>">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <p class="font-semibold text-gray-900 dark:text-white">
        <% if item.destination.present? && !(today_execution && item.status == :in_progress) %>
          <%= link_to item.title, polymorphic_path(item.destination), class: "text-primary-800 underline hover:no-underline dark:text-primary-300" %>
        <% else %>
          <%= item.title %>
        <% end %>
      </p>
      <% if show_status %>
        <span class="inline-flex items-center rounded-md bg-primary-50 px-2 py-1 text-base font-medium text-primary-700 ring-1 ring-primary-700/10 ring-inset sm:text-sm dark:bg-primary-400/10 dark:text-primary-300 dark:ring-primary-400/30">
          <%= item.status.to_s.humanize %>
        </span>
      <% end %>
      <% if item.record.is_a?(PlannedMeal) && item.status == :planned %>
        <%= render "shared/readiness_badge", readiness: item.readiness %>
      <% end %>
    </div>
    <% if item.description.present? %>
      <p class="mt-1 text-base/7 text-gray-500 sm:text-sm/6 dark:text-gray-400"><%= item.description %></p>
    <% end %>
  </div>

  <% if planned_workout %>
    <%= render "activities/planned_workout_actions", item:, return_to:, activity_date:, today_execution:, execution_button: %>
  <% else %>
    <div class="flex min-w-0 flex-wrap items-center gap-2">
      <% if today_execution && item.status == :in_progress && item.destination.present? %>
        <%= link_to "Resume", polymorphic_path(item.destination), class: yass(btn: [ :base, { lg: :base }, execution_button ]) %>
      <% elsif item.record.is_a?(PlannedMeal) && item.status == :planned %>
        <% if item.readiness&.needs_ingredient_check? %>
          <%= link_to "Review ingredients", planned_meal_ingredient_review_path(item.record),
            class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
        <% end %>
        <% if item.record.convertible_by?(Current.person) %>
          <%= button_to "Log as eaten", planned_meal_meal_path(item.record), class: yass(btn: [ :base, { md: :base }, today_execution ? execution_button : { primary: :solid } ]) %>
        <% end %>
      <% elsif item.record.is_a?(PlannedWorkout) && item.status == :skipped %>
        <%= button_to "Restore", planned_workout_skip_path(item.record),
              method: :delete,
              params: { return_to: return_to, date: activity_date },
              class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
      <% elsif item.kind == :simple_habit && item.status == :planned && actionable %>
        <%= button_to "Check off",
              habit_check_ins_path,
              params: { habit_check_in: { person_habit_id: item.record.id }, return_to: return_to, date: activity_date },
              class: yass(btn: [ :base, { md: :base }, today_execution ? execution_button : { primary: :solid } ]) %>
      <% elsif item.kind == :measured_habit && item.status == :planned && actionable %>
        <%= link_to "Record details", recovery_day_path(anchor: "recovery-person-habit-#{item.record.id}"), class: yass(btn: [ :base, { md: :base }, today_execution ? execution_button : { neutral: :outline } ]) %>
      <% end %>
    </div>
  <% end %>
</li>
