<% content_for :title, "Shopping · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="shopping-list-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Household-wide plan</p>
      <h1 id="shopping-list-heading" class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Shopping list</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Ingredients planned for <%= @shopping_list.start_date.to_fs(:long) %>–<%= @shopping_list.end_date.to_fs(:long) %>.
        Eaten meals do not change this list.
      </p>
    </div>
    <%= link_to "Back to meals", meal_week_path(date: @meal_week), class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
  </div>

  <% if @shopping_list.entries.any? %>
    <ul id="shopping-list" class="mt-8 divide-y divide-gray-200 overflow-hidden rounded-lg bg-white shadow-sm outline outline-1 -outline-offset-1 outline-gray-200 dark:divide-white/10 dark:bg-gray-800/50 dark:outline-white/10">
      <% @shopping_list.entries.each do |entry| %>
        <li class="flex items-baseline gap-3 px-5 py-4">
          <% if entry.amount.present? || entry.unit.present? %>
            <span class="min-w-24 font-semibold text-primary-700 dark:text-primary-400"><%= [ entry.amount, entry.unit ].compact.join(" ") %></span>
          <% end %>
          <span class="text-gray-900 dark:text-white"><%= entry.name %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-lg border border-dashed border-gray-300 bg-white p-10 text-center dark:border-white/10 dark:bg-gray-800/50">
      <%= icon "shopping-cart", class: "mx-auto size-12 text-gray-400" %>
      <h2 class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">Nothing to shop for yet</h2>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Add recipes to this week's plan to build the household list.</p>
    </div>
  <% end %>
</section>
