<% content_for :title, "Shopping · Hearth" %>
<%= render "layouts/meals_navigation" %>

<div class="max-w-5xl">
  <section aria-labelledby="shopping-list-heading">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Household-wide plan</p>
        <h1 id="shopping-list-heading" class="mt-2 text-balance text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">Shopping list</h1>
        <p class="mt-2 max-w-[64ch] text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">
          Confirmed shortfalls for <%= @shopping_list.week_start.to_fs(:long) %>–<%= @shopping_list.end_date.to_fs(:long) %>,
          after pantry evidence was allocated across the household's meals.
          Checking an item off is checklist state only — it never claims pantry inventory.
        </p>
      </div>

      <%= render Elements::DisclosureComponent.new(id: "add-shopping-item", hidden: @shopping_list_item.errors.empty?) do |disclosure| %>
        <%= disclosure.button("Add item", class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ])) %>
        <%= disclosure.panel do %>
          <section aria-labelledby="add-shopping-item-heading" class="mt-5 w-full rounded-xl bg-white p-5 ring-1 ring-gray-950/10 dark:bg-white/5 dark:ring-white/10">
            <h2 id="add-shopping-item-heading" class="text-balance text-xl font-semibold text-gray-900 dark:text-white">Add a manual item</h2>
            <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Manual items remain on this household week until someone deletes them.</p>
            <%= render "shopping_list_items/form", shopping_list_item: @shopping_list_item, shopping_list: @shopping_list, primary_submit: false %>
          </section>
        <% end %>
      <% end %>
    </div>

    <nav aria-label="Shopping week" class="mt-6 flex flex-wrap items-center gap-2">
      <%= link_to "Previous", shopping_list_path(date: @meal_week.previous_date), data: { turbo_prefetch: false }, class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
      <%= link_to "Current week", shopping_list_path, data: { turbo_prefetch: false }, aria: ({ current: "page" } if @meal_week.current_week?), class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
      <%= link_to "Next", shopping_list_path(date: @meal_week.next_date), data: { turbo_prefetch: false }, class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
    </nav>

    <div id="shopping-list" class="mt-8 space-y-8">
      <section aria-labelledby="shopping-remaining-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div>
            <h2 id="shopping-remaining-heading" class="text-balance text-xl font-semibold text-gray-900 dark:text-white">To get</h2>
            <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Check items off as they go into the cart.</p>
          </div>
          <p class="tabular-nums text-base/7 text-gray-500 sm:text-sm/6 dark:text-gray-400"><%= pluralize(@shopping_list.remaining_items.size, "item") %></p>
        </div>

        <% if @shopping_list.remaining_items.any? %>
          <ul role="list" class="mt-4 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/10 dark:divide-white/10 dark:bg-gray-800/50 dark:ring-white/10">
            <%= render partial: "shopping_lists/item", collection: @shopping_list.remaining_items, as: :item %>
          </ul>
        <% elsif @shopping_list.completed_items.any? %>
          <div class="mt-4 rounded-xl bg-success-50 p-6 ring-1 ring-success-600/15 dark:bg-success-500/10 dark:ring-success-400/20">
            <h3 class="text-balance font-semibold text-gray-900 dark:text-white">Everything is checked off</h3>
            <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Uncheck a completed item if it still needs to be picked up.</p>
          </div>
        <% else %>
          <div class="mt-4 rounded-xl border border-dashed border-gray-950/15 px-6 py-10 text-center dark:border-white/15">
            <%= icon "shopping-cart", class: "mx-auto size-10 text-gray-400" %>
            <h3 class="mt-3 text-balance font-semibold text-gray-900 dark:text-white">No confirmed shortfalls</h3>
            <p class="mx-auto mt-1 max-w-[48ch] text-pretty text-base/7 text-gray-500 sm:text-sm/6 dark:text-gray-400">
              A meal only adds shopping work once its ingredients are resolved and pantry evidence cannot cover them.
              Unresolved requirements stay off this list until the household checks them. Add a manual item above anytime.
            </p>
          </div>
        <% end %>
      </section>

      <% if @shopping_list.completed_items.any? %>
        <section aria-labelledby="shopping-completed-heading">
          <%= render Elements::DisclosureComponent.new(id: "completed-shopping-items") do |disclosure| %>
            <h2>
              <%= disclosure.button(class: "flex w-full items-center justify-between gap-4 rounded-lg py-2 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-500") do %>
                <span class="flex items-baseline gap-2">
                  <span id="shopping-completed-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Completed</span>
                  <span class="tabular-nums text-base text-gray-500 sm:text-sm dark:text-gray-400"><%= @shopping_list.completed_items.size %></span>
                </span>
                <span class="flex items-center gap-2 text-base/7 font-semibold text-primary-700 sm:text-sm/6 dark:text-primary-300">
                  <span class="in-aria-expanded:hidden">Show</span>
                  <span class="hidden in-aria-expanded:block">Hide</span>
                  <%= icon "chevron-down", variant: :micro, class: "size-4 shrink-0 transition-transform in-aria-expanded:rotate-180" %>
                </span>
              <% end %>
            </h2>
            <%= disclosure.panel do %>
              <ul role="list" class="mt-3 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/10 dark:divide-white/10 dark:bg-gray-800/50 dark:ring-white/10">
                <%= render partial: "shopping_lists/item", collection: @shopping_list.completed_items, as: :item %>
              </ul>
            <% end %>
          <% end %>
        </section>
      <% end %>
    </div>
  </section>

  <p class="mt-8 text-pretty text-base/7 text-gray-500 sm:text-sm/6 dark:text-gray-400">Hearth provides household planning tools, not medical advice.</p>
</div>
