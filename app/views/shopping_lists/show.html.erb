<% content_for :title, "Shopping · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="shopping-list-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Household-wide plan</p>
      <h1 id="shopping-list-heading" class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Shopping list</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Confirmed shortfalls for <%= @shopping_list.week_start.to_fs(:long) %>–<%= @shopping_list.end_date.to_fs(:long) %>,
        after your pantry evidence was allocated across the household's meals.
        Checking an item off is checklist state only — it never claims pantry inventory.
      </p>
    </div>
    <%= link_to "Back to meals", meal_week_path(date: @meal_week), class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
  </div>

  <div class="mt-8 overflow-hidden bg-white shadow-sm sm:rounded-md dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
    <ul id="shopping-list" role="list" class="divide-y divide-gray-200 dark:divide-white/10">
      <% @shopping_list_items.each do |item| %>
        <li id="shopping-list-item-<%= item.id %>" data-completed="<%= item.completed? %>" class="px-4 py-4 sm:px-6">
          <div class="flex items-start gap-3">
            <div class="flex h-6 shrink-0 items-center">
              <% completion_path = shopping_list_item_completion_path(item) %>
              <%= button_to completion_path,
                method: item.completed? ? :delete : :post,
                aria: { label: item.completed? ? "Uncheck #{item.name}" : "Check #{item.name}", pressed: item.completed? },
                class: "group grid size-6 grid-cols-1 appearance-none rounded-sm border border-gray-300 bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:border-white/10 dark:bg-white/5 dark:focus-visible:outline-primary-500 #{item.completed? ? 'border-primary-600! bg-primary-600! dark:border-primary-500! dark:bg-primary-500!' : ''}" do %>
                <%= icon "check", class: "pointer-events-none col-start-1 row-start-1 size-5 self-center justify-self-center stroke-white #{item.completed? ? '' : 'opacity-0'}" %>
              <% end %>
            </div>

            <div class="min-w-0 flex-1 text-sm/6">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="font-medium text-gray-900 dark:text-white <%= 'line-through text-gray-500! dark:text-gray-400!' if item.completed? %>">
                    <% if item.quantity.present? || item.unit.present? %>
                      <span class="mr-1 font-semibold text-primary-700 dark:text-primary-400"><%= [ item.quantity, item.unit ].compact.join(" ") %></span>
                    <% end %>
                    <%= item.name %>
                  </p>
                  <% if item.notes.present? %>
                    <p class="text-gray-500 dark:text-gray-400"><%= item.notes %></p>
                  <% end %>
                </div>
                <div class="flex items-center gap-3">
                  <% if item.confirmable_into_pantry? %>
                    <%= link_to "Confirm purchase", new_shopping_list_item_pantry_confirmation_path(item),
                      data: { turbo_prefetch: false },
                      class: yass(btn: [ :base, { md: :base }, { primary: :outline } ]) %>
                  <% end %>
                  <%= link_to "Edit", edit_shopping_list_item_path(item, date: @shopping_list.week_start),
                    data: { turbo_prefetch: false },
                    class: "font-semibold text-primary-700 underline hover:no-underline dark:text-primary-300" %>
                  <% if item.removable_by_person? %>
                    <%= button_to "Delete", shopping_list_item_path(item), method: :delete,
                      form: { data: { turbo_confirm: "Remove this item from the list?" } },
                      class: yass(btn: [ :base, { md: :base }, { danger: :outline } ]) %>
                  <% end %>
                </div>
              </div>

              <% if item.shopping_list_item_sources.any? %>
                <%# Sources own the row membership (unit-scoped). Allocation only enriches each source. %>
                <% allocation = @shopping_list.allocation %>
                <% stock_holders = [] %>
                <% if allocation && item.ingredient.present? && item.generated_key.to_s.start_with?("[\"deficit\"") %>
                  <% source_plan_ids = item.shopping_list_item_sources.map { |source| source.planned_meal.id }.to_set %>
                  <% source_units = item.shopping_list_item_sources.filter_map { |source|
                       req = source.planned_meal_ingredient
                       measurement = req.substituted? ? req.replacement_measurement : req.measurement
                       measurement.canonical_unit if measurement.known?
                     }.uniq %>
                  <% stock_holders = allocation.contributions_for(item.ingredient).select { |contribution|
                       reservation = contribution.reservation
                       next false if source_plan_ids.include?(contribution.planned_meal.id)
                       next false unless reservation.measurable? && reservation.reserved_quantity&.positive? && !reservation.deficit?
                       source_units.include?(reservation.measurement.canonical_unit)
                     } %>
                <% end %>
                <dl class="mt-2 divide-y divide-gray-900/10 dark:divide-white/10">
                  <%= render Elements::DisclosureComponent.new do |disclosure| %>
                    <div class="py-2">
                      <dt>
                        <%= disclosure.button(class: "flex w-full items-start justify-between text-left text-gray-700 dark:text-gray-300") do %>
                          <span class="font-semibold"><%= pluralize(item.shopping_list_item_sources.size, "contributing meal") %></span>
                          <span class="ml-6 flex h-6 items-center">
                            <%= icon "chevron-down", class: "size-5 transition in-aria-expanded:rotate-180" %>
                          </span>
                        <% end %>
                      </dt>
                      <%= disclosure.panel do %>
                        <dd class="mt-2 pr-8">
                          <ul class="grid gap-1 text-gray-600 dark:text-gray-400">
                            <% item.shopping_list_item_sources.each do |source| %>
                              <% planned_meal = source.planned_meal %>
                              <% requirement = source.planned_meal_ingredient %>
                              <% reservation = allocation&.reservations_for(planned_meal)&.find { |row|
                                   row.requirement.id == requirement.id
                                 } %>
                              <li data-shopping-ownership data-source-plan="<%= planned_meal.id %>">
                                <%= planned_meal.planned_on.to_fs(:long) %> ·
                                <%= link_to planned_meal.recipe.title, planned_meal.recipe, class: "underline" %> ·
                                <span data-confirmation-state="<%= source.confirmation_state %>"><%= source.confirmation_label %></span>
                                <% if source.substituted? %>
                                  · Substituted → <%= source.replacement_display_name %>
                                <% end %>
                                <% if reservation&.measurable? %>
                                  · reserved <%= Ingredient::Measurement.format_quantity(reservation.reserved_quantity) %>
                                  of <%= Ingredient::Measurement.format_quantity(reservation.required_quantity) %>
                                  <%= reservation.unit unless reservation.unit == Ingredient::Measurement::GENERIC_COUNT.normalized_label %>
                                  <% if reservation.deficit? %>
                                    · <span data-ownership-role="short">short <%= Ingredient::Measurement.format_quantity(reservation.deficit_quantity) %></span>
                                  <% end %>
                                <% end %>
                              </li>
                            <% end %>
                          </ul>
                          <% if stock_holders.any? %>
                            <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Stock reserved by earlier meals</p>
                            <ul class="mt-1 grid gap-1 text-gray-600 dark:text-gray-400">
                              <% stock_holders.each do |contribution| %>
                                <% planned_meal = contribution.planned_meal %>
                                <% reservation = contribution.reservation %>
                                <li data-stock-holder data-source-plan="<%= planned_meal.id %>">
                                  <%= planned_meal.planned_on.to_fs(:long) %> ·
                                  <%= link_to planned_meal.recipe.title, planned_meal.recipe, class: "underline" %> ·
                                  <span data-ownership-role="reserved">
                                    reserved <%= Ingredient::Measurement.format_quantity(reservation.reserved_quantity) %>
                                    of <%= Ingredient::Measurement.format_quantity(reservation.required_quantity) %>
                                    <%= reservation.unit unless reservation.unit == Ingredient::Measurement::GENERIC_COUNT.normalized_label %>
                                  </span>
                                </li>
                              <% end %>
                            </ul>
                          <% end %>
                        </dd>
                      <% end %>
                    </div>
                  <% end %>
                </dl>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <% if @shopping_list_items.empty? %>
      <div class="px-6 py-10 text-center">
        <%= icon "shopping-cart", class: "mx-auto size-10 text-gray-400" %>
        <h2 class="mt-3 font-semibold text-gray-900 dark:text-white">No confirmed shortfalls</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          A meal only adds shopping work once its ingredients are resolved and your pantry evidence cannot cover them.
          Unresolved requirements stay off this list until the household checks them. Add a manual item below anytime.
        </p>
      </div>
    <% end %>
  </div>

  <section aria-labelledby="add-shopping-item-heading" class="mt-10 border-b border-gray-900/10 pb-12 dark:border-white/10">
    <h2 id="add-shopping-item-heading" class="text-base/7 font-semibold text-gray-900 dark:text-white">Add an item</h2>
    <p class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">Manual items stay on this household week until someone deletes them.</p>
    <%= render "shopping_list_items/form", shopping_list_item: @shopping_list_item, shopping_list: @shopping_list %>
  </section>
</section>
