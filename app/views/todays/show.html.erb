<% content_for :title, "Today · Hearth" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @today.person.name %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Today</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400"><%= @today.date.to_fs(:long) %> · Your household tracking plan, not medical advice.</p>
  </div>
  <%= link_to "Household overview", household_week_path, class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
</div>

<div class="mt-10 space-y-10">
  <% @today.sections.each do |section| %>
    <section aria-labelledby="today-<%= section.key %>-heading">
      <div>
        <h2 id="today-<%= section.key %>-heading" class="text-xl font-semibold"><%= section.title %></h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= section.description %></p>
      </div>
      <ul role="list" class="mt-4 divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xs dark:divide-white/10 dark:border-white/10 dark:bg-gray-800/50">
        <% section.items.each do |item| %>
          <li class="flex flex-wrap items-center justify-between gap-4 px-5 py-4" data-today-kind="<%= item.kind %>" data-today-status="<%= item.status %>">
            <div class="min-w-0">
              <p class="font-semibold">
                <% if item.destination.present? %>
                  <%= link_to item.title, polymorphic_path(item.destination), class: "text-primary-800 underline hover:no-underline dark:text-primary-300" %>
                <% else %>
                  <%= item.title %>
                <% end %>
              </p>
              <% if item.description.present? %><p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= item.description %></p><% end %>
            </div>
            <div class="flex items-center gap-3">
              <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700 dark:bg-white/5 dark:text-gray-300"><%= item.status.to_s.humanize %></span>
              <% if item.kind == :simple_habit %>
                <%= button_to "Check off",
                      habit_check_ins_path,
                      params: { habit_check_in: { person_habit_id: item.record.id }, return_to: "today" },
                      class: yass(btn: [ :base, { md: :base }, { primary: :solid } ]) %>
              <% elsif item.kind == :measured_habit %>
                <%= link_to "Record details", recovery_day_path(anchor: "recovery-person-habit-#{item.record.id}"), class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
              <% end %>
            </div>
          </li>
        <% end %>
        <% if section.items.empty? %>
          <li class="px-5 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Nothing here yet.</li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
