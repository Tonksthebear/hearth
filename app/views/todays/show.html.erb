<% content_for :title, "Today · Hearth" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @today.person.name %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Today</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400"><%= @today.date.to_fs(:long) %> · Your household tracking plan, not medical advice.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <% if @today.unchecked_shopping_count.positive? %>
      <%= link_to "Shopping list (#{@today.unchecked_shopping_count})", shopping_list_path(date: @today.date),
        data: { turbo_prefetch: false },
        class: yass(btn: [ :base, { lg: :base }, { neutral: :solid } ]) %>
    <% end %>
    <%= link_to "Household overview", household_week_path, class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
  </div>
</div>

<div class="mt-10">
  <%= render "shared/nutrition_summary",
    summary: @today.nutrition_summary,
    id: "today-nutrition-heading",
    title: "Known nutrition today",
    description: "Concise context from logged meal snapshots; this is tracking information, not medical advice." %>
</div>

<div class="mt-10 space-y-10">
  <% @today.sections.each do |section| %>
    <section aria-labelledby="today-<%= section.key %>-heading">
      <div>
        <h2 id="today-<%= section.key %>-heading" class="text-xl font-semibold"><%= section.title %></h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= section.description %></p>
      </div>
      <ul role="list" class="mt-4 divide-y divide-gray-200 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xs dark:divide-white/10 dark:border-white/10 dark:bg-gray-800/50">
        <%= render partial: "activities/item", collection: section.items, as: :item, locals: { return_to: "today", activity_date: @today.date, actionable: true } %>
        <% if section.items.empty? %>
          <li class="px-5 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Nothing here yet.</li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
