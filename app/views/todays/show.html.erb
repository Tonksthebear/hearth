<% content_for :title, "Today · Hearth" %>

<div>
  <h1 class="text-balance text-3xl font-semibold tracking-tight">Today</h1>
  <p class="mt-2 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= @today.date.to_fs(:long) %></p>
</div>

<% sections = @today.sections.index_by(&:key) %>
<% in_progress = sections.fetch(:in_progress) %>
<% up_next = sections.fetch(:up_next) %>
<% done = sections.fetch(:done) %>
<% primary_in_progress_item = in_progress.items.first %>
<% primary_up_next_item = @today.primary_up_next_item if in_progress.items.empty? %>

<div class="mt-8 space-y-8">
  <% if in_progress.items.any? %>
    <section aria-labelledby="today-in-progress-heading" data-today-section="in-progress">
      <div>
        <h2 id="today-in-progress-heading" class="text-balance text-xl font-semibold"><%= in_progress.title %></h2>
        <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= in_progress.description %></p>
      </div>
      <ul role="list" class="mt-4 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-primary-600/20 shadow-xs dark:divide-white/10 dark:bg-gray-800/50 dark:ring-primary-400/30 dark:shadow-none">
        <% in_progress.items.each do |item| %>
          <%= render "activities/item", item:, return_to: "today", activity_date: @today.date, actionable: true,
            today_execution: true, show_status: false, primary_action: item.equal?(primary_in_progress_item) %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if up_next.items.any? %>
    <section aria-labelledby="today-up-next-heading" data-today-section="up-next">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <h2 id="today-up-next-heading" class="text-balance text-xl font-semibold"><%= up_next.title %></h2>
          <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= up_next.description %></p>
        </div>
        <p class="tabular-nums text-base/7 font-medium text-gray-500 sm:text-sm/6 dark:text-gray-400"><%= pluralize(up_next.items.size, "item") %></p>
      </div>
      <ul role="list" class="mt-4 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/10 dark:divide-white/10 dark:bg-gray-800/50 dark:ring-white/10">
        <% up_next.items.each do |item| %>
          <%= render "activities/item", item:, return_to: "today", activity_date: @today.date, actionable: true,
            today_execution: true, show_status: false,
            primary_action: item.equal?(primary_up_next_item) %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if in_progress.items.empty? && up_next.items.empty? && done.items.any? %>
    <section aria-labelledby="today-all-done-heading" class="rounded-xl bg-success-50 p-6 ring-1 ring-success-600/15 dark:bg-success-500/10 dark:ring-success-400/20">
      <h2 id="today-all-done-heading" class="text-balance font-semibold text-gray-900 dark:text-white">All done for today</h2>
      <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Everything planned for today has been completed or recorded.</p>
    </section>
  <% elsif in_progress.items.empty? && up_next.items.empty? && done.items.empty? %>
    <section aria-labelledby="today-empty-heading" class="rounded-xl border border-dashed border-gray-950/15 p-8 text-center dark:border-white/15">
      <h2 id="today-empty-heading" class="text-balance font-semibold text-gray-900 dark:text-white">Nothing planned today</h2>
      <p class="mt-1 text-pretty text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Plans and check-ins will appear here when they are scheduled or recorded.</p>
    </section>
  <% end %>

  <% if done.items.any? %>
    <section aria-labelledby="today-completed-heading" data-today-section="completed">
      <%= render Elements::DisclosureComponent.new(id: "today-completed-items") do |disclosure| %>
        <h2>
          <%= disclosure.button(class: "flex w-full items-center justify-between gap-4 rounded-lg py-2 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:focus-visible:outline-primary-500") do %>
            <span class="flex items-baseline gap-2">
              <span id="today-completed-heading" class="block text-xl font-semibold text-gray-900 dark:text-white"><%= done.title %></span>
              <span class="block tabular-nums text-base font-medium text-gray-500 sm:text-sm dark:text-gray-400"><%= done.items.size %></span>
            </span>
            <span class="flex items-center gap-2 text-base/7 font-semibold text-primary-700 sm:text-sm/6 dark:text-primary-300">
              <span class="in-aria-expanded:hidden">Show</span>
              <span class="hidden in-aria-expanded:block">Hide</span>
              <%= icon "chevron-down", variant: :micro, class: "size-4 shrink-0 transition-transform in-aria-expanded:rotate-180" %>
            </span>
          <% end %>
        </h2>
        <%= disclosure.panel do %>
          <ul role="list" class="mt-3 divide-y divide-gray-950/5 overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/10 dark:divide-white/10 dark:bg-gray-800/50 dark:ring-white/10">
            <%= render partial: "activities/item", collection: done.items, as: :item,
              locals: { return_to: "today", activity_date: @today.date, actionable: true, today_execution: true, show_status: true } %>
          </ul>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>

<section aria-labelledby="today-details-heading" class="mt-10 border-t border-gray-950/10 pt-6 dark:border-white/10">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="today-details-heading" class="text-balance text-xl font-semibold text-gray-900 dark:text-white">Day details</h2>
    <% if @today.unchecked_shopping_count.positive? %>
      <%= link_to "Open shopping list (#{@today.unchecked_shopping_count})", shopping_list_path(date: @today.date),
        data: { turbo_prefetch: false },
        class: yass(btn: [ :base, { md: :base }, { neutral: :outline } ]) %>
    <% end %>
  </div>
  <div class="mt-5">
    <%= render "shared/nutrition_summary",
      summary: @today.nutrition_summary,
      id: "today-nutrition-heading",
      title: "Nutrition",
      description: "Known totals from logged meal snapshots; missing data is not counted as zero.",
      empty_title: "No nutrition logged yet",
      empty_description: "Log a meal with ingredient amounts to see nutrition totals for today.",
      empty_action_label: "Log a meal",
      empty_action_path: new_meal_path(date: @today.date) %>
  </div>
</section>
