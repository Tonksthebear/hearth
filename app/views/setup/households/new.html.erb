<% content_for :title, "Set up Hearth" %>

<div class="flex min-h-full flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-lg">
    <div class="mx-auto flex size-12 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm dark:bg-primary-500">
      <%= icon "heart", variant: :solid, class: "size-8" %>
    </div>
    <p class="mt-6 text-center text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">First-run setup</p>
    <h1 class="mt-2 text-center text-2xl/9 font-bold tracking-tight text-gray-900 dark:text-white">Create your household</h1>
    <p class="mt-2 text-center text-sm/6 text-gray-600 dark:text-gray-400">Set up the household and owner account for this Hearth installation.</p>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-2xl">
    <div class="bg-white px-6 py-10 shadow-sm sm:rounded-lg sm:px-12 dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
      <% if @setup_error_messages.any? %>
        <div id="setup-errors" class="mb-8 rounded-md bg-danger-50 p-4 text-sm text-danger-800 dark:bg-danger-500/10 dark:text-danger-300" role="alert">
          <p class="font-semibold">Please correct the following:</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <% @setup_error_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with url: setup_household_path, scope: :setup, class: "space-y-8" do |form| %>
        <div class="border-b border-gray-900/10 pb-8 dark:border-white/10">
          <h2 class="text-base/7 font-semibold text-gray-900 dark:text-white">Household</h2>
          <div class="mt-6">
            <%= form.label :household_name, "Household name", class: :label %>
            <div class="mt-2">
              <%= form.text_field :household_name, value: @household.name, required: true, autofocus: true, class: :text_field %>
            </div>
          </div>
        </div>

        <div class="border-b border-gray-900/10 pb-8 dark:border-white/10">
          <h2 class="text-base/7 font-semibold text-gray-900 dark:text-white">Owner account</h2>
          <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <%= form.label :person_name, "Your name", class: :label %>
              <div class="mt-2">
                <%= form.text_field :person_name, value: @person.name, required: true, autocomplete: "name", class: :text_field %>
              </div>
            </div>
            <div class="sm:col-span-2">
              <%= form.label :email_address, "Email address", class: :label %>
              <div class="mt-2">
                <%= form.email_field :email_address, value: @user.email_address, required: true, autocomplete: "username", class: :text_field %>
              </div>
            </div>
            <div>
              <%= form.label :password, class: :label %>
              <div class="mt-2">
                <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: :text_field %>
              </div>
            </div>
            <div>
              <%= form.label :password_confirmation, "Confirm password", class: :label %>
              <div class="mt-2">
                <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: :text_field %>
              </div>
            </div>
          </div>
        </div>

        <%= form.submit "Create household", class: { btn: [ :base, { xl: :base }, { primary: :solid }, "w-full sm:w-auto" ] } %>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">Hearth tracks household health operations. It does not provide medical advice.</p>
  </div>
</div>
