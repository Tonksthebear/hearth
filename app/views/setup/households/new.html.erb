<div class="mx-auto max-w-xl">
  <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">First-run setup</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight">Create your household</h1>
  <p class="mt-3 text-stone-600">Set up the household and owner account for this Hearth installation.</p>

  <% if @setup_error_messages.any? %>
    <div id="setup-errors" class="mt-6 rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <p class="font-semibold">Please correct the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% @setup_error_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: setup_household_path, scope: :setup, class: "mt-8 space-y-6" do |form| %>
    <div>
      <%= form.label :household_name, "Household name", class: "block text-sm font-medium" %>
      <%= form.text_field :household_name, value: @household.name, required: true, autofocus: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :person_name, "Your name", class: "block text-sm font-medium" %>
      <%= form.text_field :person_name, value: @person.name, required: true, autocomplete: "name", class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :email_address, "Email address", class: "block text-sm font-medium" %>
      <%= form.email_field :email_address, value: @user.email_address, required: true, autocomplete: "username", class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>

    <%= form.submit "Create household", class: "w-full cursor-pointer rounded-lg bg-amber-700 px-4 py-3 font-semibold text-white hover:bg-amber-600" %>
  <% end %>

  <p class="mt-6 text-sm text-stone-500">Hearth tracks household health operations. It does not provide medical advice.</p>
</div>
