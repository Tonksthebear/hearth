<% content_for :title, "#{@recipe.title} · Hearth" %>
<%= render "layouts/meals_navigation" %>

<article aria-labelledby="recipe-heading">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 id="recipe-heading" class="mt-2 text-3xl font-semibold tracking-tight"><%= @recipe.title %></h1>
      <% if @recipe.description.present? %>
        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400"><%= @recipe.description %></p>
      <% end %>
    </div>
    <%= link_to "Edit recipe", edit_recipe_path(@recipe), class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
  </div>

  <dl class="mt-8 grid gap-4 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5 sm:grid-cols-2">
    <div>
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Source</dt>
      <dd class="mt-1 font-semibold">
        <%= @recipe.source_label %>
        <% if @recipe.source_url.present? %>
          <span class="block break-all text-sm font-normal text-gray-600 dark:text-gray-400"><%= @recipe.source_url %></span>
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Provenance</dt>
      <dd class="mt-1 text-sm text-gray-700 dark:text-gray-300"><%= @recipe.provenance_status.humanize %> · <%= @recipe.provenance_description %></dd>
    </div>
    <% if @recipe.yield.present? %>
      <div>
        <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Yield</dt>
        <dd class="mt-1 font-semibold"><%= @recipe.yield %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-8 grid gap-8 lg:grid-cols-2">
    <section aria-labelledby="ingredients-heading" class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <h2 id="ingredients-heading" class="text-xl font-semibold">Ingredients</h2>
      <ul class="mt-4 space-y-3">
        <% @recipe.recipe_ingredients.each do |ingredient| %>
          <li>
            <span class="font-medium"><%= [ ingredient.amount, ingredient.unit, ingredient.name ].compact_blank.join(" ") %></span>
            <% if ingredient.notes.present? %>
              <span class="text-gray-600 dark:text-gray-400">— <%= ingredient.notes %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section aria-labelledby="instructions-heading" class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <h2 id="instructions-heading" class="text-xl font-semibold">Instructions</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5">
        <% @recipe.recipe_instructions.each do |instruction| %>
          <li class="pl-2"><%= instruction.body %></li>
        <% end %>
      </ol>
    </section>
  </div>

  <p class="mt-8 text-sm text-gray-500 dark:text-gray-400">Source and provenance are attribution, not clinical endorsement. Hearth tracks household health information and does not provide medical advice.</p>

  <p class="mt-8"><%= link_to "Back to recipes", recipes_path, class: "font-medium text-primary-800 dark:text-primary-300 underline hover:no-underline" %></p>
</article>
