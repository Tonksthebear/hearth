<% content_for :title, "#{@recipe.title} · Hearth" %>
<%= render "layouts/meals_navigation" %>

<article aria-labelledby="recipe-heading">
  <div class="grid gap-10 lg:grid-cols-2 lg:gap-x-8">
    <div class="lg:max-w-lg lg:self-end">
      <nav aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-2 text-sm">
          <li><%= link_to "Recipes", recipes_path, class: "font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" %></li>
          <li aria-hidden="true" class="text-gray-300 dark:text-gray-600">/</li>
          <li class="font-medium text-gray-500 dark:text-gray-400"><%= @recipe.title %></li>
        </ol>
      </nav>
      <h1 id="recipe-heading" class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"><%= @recipe.title %></h1>

      <section aria-labelledby="recipe-information-heading" class="mt-4">
        <h2 id="recipe-information-heading" class="sr-only">Recipe information</h2>
        <% if @recipe.yield.present? %>
          <p class="text-lg text-gray-900 sm:text-xl dark:text-white"><%= @recipe.yield %></p>
        <% end %>
        <% if @recipe.description.present? %>
          <p class="mt-4 text-base/7 text-gray-600 dark:text-gray-400"><%= @recipe.description %></p>
        <% end %>
      </section>

      <div class="mt-8">
        <%= link_to "Edit recipe", edit_recipe_path(@recipe), class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
      </div>
    </div>

    <div class="lg:col-start-2 lg:row-span-2 lg:self-center">
      <% if @recipe.cover.attached? %>
        <%= image_tag @recipe.cover.variant(:hero),
          alt: "#{@recipe.title} cover",
          class: "aspect-square w-full rounded-lg object-cover outline -outline-offset-1 outline-black/5 dark:outline-white/10" %>
      <% else %>
        <div role="img" aria-label="No cover image for <%= @recipe.title %>" class="flex aspect-square w-full items-center justify-center rounded-lg bg-gray-100 text-gray-400 outline -outline-offset-1 outline-black/5 dark:bg-gray-800 dark:text-gray-500 dark:outline-white/10">
          <%= icon "book-open", variant: :solid, class: "size-20" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-12 grid gap-8 lg:grid-cols-2">
    <section aria-labelledby="ingredients-heading" class="rounded-lg bg-white p-6 shadow-sm dark:bg-gray-800/50 dark:shadow-none dark:inset-ring dark:inset-ring-white/10">
      <h2 id="ingredients-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Ingredients</h2>
      <ul class="mt-4 space-y-3 text-gray-900 dark:text-gray-100">
        <% @recipe.recipe_ingredients.each do |ingredient| %>
          <li>
            <span class="font-medium"><%= [ ingredient.amount, ingredient.unit, ingredient.name ].compact_blank.join(" ") %></span>
            <% if ingredient.notes.present? %>
              <span class="text-gray-600 dark:text-gray-400">— <%= ingredient.notes %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section aria-labelledby="instructions-heading" class="rounded-lg bg-white p-6 shadow-sm dark:bg-gray-800/50 dark:shadow-none dark:inset-ring dark:inset-ring-white/10">
      <h2 id="instructions-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Instructions</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-5 text-gray-900 dark:text-gray-100">
        <% @recipe.recipe_instructions.each do |instruction| %>
          <li class="pl-2"><%= instruction.body %></li>
        <% end %>
      </ol>
    </section>
  </div>

  <section aria-labelledby="source-details-heading" class="mt-12 overflow-hidden bg-white shadow-sm sm:rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:inset-ring dark:inset-ring-white/10">
    <div class="px-4 py-6 sm:px-6">
      <h2 id="source-details-heading" class="text-base/7 font-semibold text-gray-900 dark:text-white">Source details</h2>
      <p class="mt-1 max-w-2xl text-sm/6 text-gray-500 dark:text-gray-300">Attribution for this recipe.</p>
    </div>
    <div class="border-t border-gray-100 dark:border-white/5">
      <dl class="divide-y divide-gray-100 dark:divide-white/5">
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-gray-100">Source</dt>
          <dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0 dark:text-gray-300">
            <%= @recipe.source_label %>
            <% if @recipe.source_url.present? %>
              <span class="block break-all text-gray-600 dark:text-gray-400"><%= @recipe.source_url %></span>
            <% end %>
          </dd>
        </div>
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-900 dark:text-gray-100">Provenance</dt>
          <dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0 dark:text-gray-300"><%= @recipe.provenance_status.humanize %> · <%= @recipe.provenance_description %></dd>
        </div>
      </dl>
    </div>
  </section>

  <p class="mt-4 text-sm/6 text-gray-500 dark:text-gray-400">Source and provenance are attribution, not clinical endorsement. Hearth tracks household health information and does not provide medical advice.</p>
  <p class="mt-8"><%= link_to "Back to recipes", recipes_path, class: "font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300" %></p>
</article>
