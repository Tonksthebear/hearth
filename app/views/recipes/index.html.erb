<% content_for :title, "Recipes · Hearth" %>

<section aria-labelledby="recipes-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">Shared household catalog</p>
      <h1 id="recipes-heading" class="mt-2 text-3xl font-semibold tracking-tight">Recipes</h1>
      <p class="mt-2 max-w-2xl text-stone-600">Find meals by recipe, source, or ingredient and keep their provenance visible.</p>
    </div>
    <%= link_to "Add recipe", new_recipe_path, class: "rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-600" %>
  </div>

  <%= form_with url: recipes_path, method: :get, class: "mt-8 grid gap-4 rounded-xl border border-stone-200 bg-white p-5 sm:grid-cols-[1fr_auto_auto]" do |form| %>
    <div>
      <%= form.label :q, "Search", class: "block text-sm font-medium" %>
      <%= form.search_field :q, value: @query, placeholder: "Title, source, or ingredient", class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :status, "Provenance", class: "block text-sm font-medium" %>
      <%= form.select :status,
        options_for_select([ [ "All statuses", "" ] ] + @provenance_statuses.map { |status| [ status.humanize, status ] }, @status),
        {},
        class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
    </div>
    <div class="flex items-end gap-3">
      <%= form.submit "Filter", class: "cursor-pointer rounded-lg bg-stone-900 px-4 py-2 font-semibold text-white hover:bg-stone-700" %>
      <% if @query.present? || @status.present? %>
        <%= link_to "Clear", recipes_path, class: "pb-2 text-sm font-medium text-stone-700 underline hover:no-underline" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8 rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-950">
    <p><strong>About provenance:</strong> Verified means checked against the cited source; adapted means intentionally changed from it; observed means recorded from practice without independent source verification.</p>
    <p class="mt-2">These labels are not clinical endorsement. Hearth tracks household health information and does not provide medical advice.</p>
  </div>

  <% if @recipes.any? %>
    <ul class="mt-8 grid gap-4">
      <% @recipes.each do |recipe| %>
        <li class="rounded-xl border border-stone-200 bg-white p-5">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold"><%= link_to recipe.title, recipe, class: "text-amber-800 underline hover:no-underline" %></h2>
              <% if recipe.description.present? %>
                <p class="mt-2 text-stone-600"><%= recipe.description %></p>
              <% end %>
            </div>
            <span class="rounded-full bg-stone-100 px-3 py-1 text-sm font-semibold"><%= recipe.provenance_status.humanize %></span>
          </div>
          <p class="mt-4 text-sm text-stone-600">
            Source:
            <span class="font-medium"><%= recipe.source_name %></span>
            <% if recipe.source_url.present? %>
              <span class="break-all">(<%= recipe.source_url %>)</span>
            <% end %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-stone-300 bg-white p-10 text-center">
      <h2 class="text-lg font-semibold">No recipes found</h2>
      <p class="mt-2 text-stone-600">Try a different search or add the first recipe to this household.</p>
    </div>
  <% end %>
</section>
