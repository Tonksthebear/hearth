<% content_for :title, "Recipes · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="recipes-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared household catalog</p>
      <h1 id="recipes-heading" class="mt-2 text-3xl font-semibold tracking-tight">Recipes</h1>
      <p class="mt-2 max-w-2xl text-gray-600 dark:text-gray-400">Find meals by recipe, source, or ingredient and keep their provenance visible.</p>
    </div>
    <%= link_to "Add recipe", new_recipe_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
  </div>

  <%= form_with url: recipes_path, method: :get, class: "mt-8 grid gap-4 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5 sm:grid-cols-[1fr_auto_auto]" do |form| %>
    <div>
      <%= form.label :q, "Search", class: :label %>
      <%= form.search_field :q, value: @query, placeholder: "Title, source, or ingredient", class: :text_field %>
    </div>
    <div>
      <%= form.label :status, "Provenance", class: :label %>
      <%= form.elements_select :status,
        [ [ "All statuses", "" ] ] + @provenance_statuses.map { |status| [ status.humanize, status ] },
        {},
        value: @status %>
    </div>
    <div class="flex items-end gap-3">
      <%= form.submit "Filter", class: { btn: [ :base, { lg: :base }, { neutral: :solid } ] } %>
      <% if @query.present? || @status.present? %>
        <%= link_to "Clear", recipes_path, class: "pb-2 text-sm font-medium text-gray-700 dark:text-gray-300 underline hover:no-underline" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8 text-sm text-gray-500 dark:text-gray-400">
    <p class="font-medium text-gray-700 dark:text-gray-300">About provenance</p>
    <dl class="mt-2 space-y-1">
      <% @provenance_statuses.each do |status| %>
        <div><dt class="inline font-medium"><%= status.humanize %>:</dt> <dd class="inline"><%= Recipe::PROVENANCE_DESCRIPTIONS.fetch(status) %></dd></div>
      <% end %>
    </dl>
    <p class="mt-2">These labels are not clinical endorsement. Hearth tracks household health information and does not provide medical advice.</p>
  </div>

  <% if @recipes.any? %>
    <ul class="mt-8 grid gap-4">
      <% @recipes.each do |recipe| %>
        <li class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold"><%= link_to recipe.title, recipe, class: "text-primary-800 dark:text-primary-300 underline hover:no-underline" %></h2>
              <% if recipe.description.present? %>
                <p class="mt-2 text-gray-600 dark:text-gray-400"><%= recipe.description %></p>
              <% end %>
            </div>
          </div>
          <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            Source:
            <span class="font-medium"><%= recipe.source_label %></span>
            <% if recipe.source_url.present? %>
              <span class="break-all">(<%= recipe.source_url %>)</span>
            <% end %>
          </p>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center dark:border-white/15 dark:bg-gray-800/50">
      <h2 class="text-lg font-semibold">No recipes found</h2>
      <p class="mt-2 text-gray-600 dark:text-gray-400">Try a different search or add the first recipe to this household.</p>
    </div>
  <% end %>
</section>
