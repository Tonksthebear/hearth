<% content_for :title, "Recipes · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="recipes-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared household catalog</p>
      <h1 id="recipes-heading" class="mt-2 text-3xl font-semibold tracking-tight">Recipes</h1>
      <p class="mt-2 max-w-2xl text-gray-600 dark:text-gray-400">Find something useful to cook from your household catalog.</p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Ingredient nutrition", ingredients_path, class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
      <%= link_to "Add recipe", new_recipe_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
    </div>
  </div>

  <%= form_with url: recipes_path, method: :get, class: "mt-8 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
    <div class="grow">
      <%= form.label :q, "Search", class: :label %>
      <div class="mt-2">
        <%= form.search_field :q, value: @query, placeholder: "Title, source, or ingredient", class: :text_field %>
      </div>
    </div>
    <% if @status.present? %>
      <%= form.hidden_field :status, value: @status %>
    <% end %>
    <div class="flex items-center gap-3">
      <%= form.submit "Search", class: { btn: [ :base, { lg: :base }, { neutral: :solid } ] } %>
      <% if @query.present? || @status.present? %>
        <%= link_to "Clear", recipes_path, class: "text-sm/6 font-semibold text-gray-900 hover:text-gray-700 dark:text-white dark:hover:text-gray-300" %>
      <% end %>
    </div>
  <% end %>

  <% if @recipes.any? %>
    <ul role="list" class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4 xl:gap-x-8">
      <% @recipes.each do |recipe| %>
        <li>
          <%= link_to recipe, class: "group block rounded-lg focus:outline-2 focus:outline-offset-2 focus:outline-primary-600 dark:focus:outline-primary-500" do %>
            <div class="overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800">
              <% if recipe.cover.attached? %>
                <%= image_tag recipe.cover.variant(:card),
                  alt: "",
                  class: "pointer-events-none aspect-10/7 w-full rounded-lg object-cover outline -outline-offset-1 outline-black/5 group-hover:opacity-75 dark:outline-white/10" %>
              <% else %>
                <div role="img" aria-label="No cover image for <%= recipe.title %>" class="flex aspect-10/7 items-center justify-center rounded-lg bg-gray-100 text-gray-400 outline -outline-offset-1 outline-black/5 group-hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-500 dark:outline-white/10 dark:group-hover:bg-gray-700">
                  <%= icon "book-open", variant: :solid, class: "size-12" %>
                </div>
              <% end %>
            </div>
            <h2 class="mt-2 block truncate text-sm font-medium text-gray-900 dark:text-white"><%= recipe.title %></h2>
            <p class="block truncate text-sm text-gray-500 dark:text-gray-400"><%= recipe.yield.presence || recipe.description.presence || "Household recipe" %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8 rounded-lg border border-dashed border-gray-300 bg-white px-6 py-10 text-center dark:border-white/15 dark:bg-gray-800/50">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white">No recipes found</h2>
      <p class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">Try a different search or add the first recipe to this household.</p>
    </div>
  <% end %>

  <aside aria-labelledby="source-details-heading" class="mt-12 overflow-hidden bg-white shadow-sm sm:rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:inset-ring dark:inset-ring-white/10">
    <div class="px-4 py-6 sm:px-6">
      <h2 id="source-details-heading" class="text-base/7 font-semibold text-gray-900 dark:text-white">Source details</h2>
      <p class="mt-1 max-w-2xl text-sm/6 text-gray-500 dark:text-gray-300">Filter imported attribution or review what each source status means.</p>
    </div>
    <div class="border-t border-gray-100 dark:border-white/5">
      <%= form_with url: recipes_path, method: :get, class: "px-4 py-6 sm:grid sm:grid-cols-3 sm:items-end sm:gap-4 sm:px-6" do |form| %>
        <%= form.hidden_field :q, value: @query if @query.present? %>
        <div class="sm:col-span-2">
          <%= form.label :status, "Provenance", class: :label %>
          <div class="mt-2">
            <%= form.elements_select :status,
              [ [ "All statuses", "" ] ] + @provenance_statuses.map { |status| [ status.humanize, status ] },
              {},
              value: @status %>
          </div>
        </div>
        <div class="mt-4 sm:mt-0">
          <%= form.submit "Filter", class: { btn: [ :base, { lg: :base }, { neutral: :outline } ] } %>
        </div>
      <% end %>
      <dl class="divide-y divide-gray-100 border-t border-gray-100 dark:divide-white/5 dark:border-white/5">
        <% @provenance_statuses.each do |status| %>
          <div class="px-4 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= status.humanize %>:</dt>
            <dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0 dark:text-gray-300"><%= Recipe::PROVENANCE_DESCRIPTIONS.fetch(status) %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </aside>

  <p class="mt-4 text-sm/6 text-gray-500 dark:text-gray-400">These labels are not clinical endorsement. Hearth tracks household health information and does not provide medical advice.</p>
</section>
