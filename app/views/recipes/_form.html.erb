<div id="recipe_form">
  <%= form_with model: recipe, class: "mt-8 space-y-8" do |form| %>
    <% if recipe.errors.any? %>
      <div id="recipe-errors" class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5">
          <% recipe.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="grid gap-5 rounded-xl border border-stone-200 bg-white p-5 sm:grid-cols-2">
      <legend class="px-2 text-lg font-semibold">Recipe details</legend>
      <div class="sm:col-span-2">
        <%= form.label :title, class: "block text-sm font-medium" %>
        <%= form.text_field :title, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :description, class: "block text-sm font-medium" %>
        <%= form.text_area :description, rows: 3, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :yield, "Yield", class: "block text-sm font-medium" %>
        <%= form.text_field :yield, placeholder: "4 servings", class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :provenance_status, "Provenance", class: "block text-sm font-medium" %>
        <%= form.select :provenance_status,
          provenance_statuses.map { |status| [ status.humanize, status ] },
          { include_blank: "Choose a status" },
          required: true,
          class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :source_name, "Source name", class: "block text-sm font-medium" %>
        <%= form.text_field :source_name, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :source_url, "Source URL", class: "block text-sm font-medium" %>
        <%= form.url_field :source_url, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-stone-200 bg-white p-5">
      <div class="flex items-center justify-between gap-4">
        <legend class="text-lg font-semibold">Ingredients</legend>
        <%= form.button "Add ingredient",
          name: "add_ingredient",
          value: "1",
          formnovalidate: true,
          class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold hover:bg-stone-100" %>
      </div>
      <div class="mt-5 space-y-4">
        <%= form.fields_for :recipe_ingredients do |ingredient_form| %>
          <%= render "ingredient_fields", form: ingredient_form %>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-stone-200 bg-white p-5">
      <div class="flex items-center justify-between gap-4">
        <legend class="text-lg font-semibold">Instructions</legend>
        <%= form.button "Add step",
          name: "add_instruction",
          value: "1",
          formnovalidate: true,
          class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold hover:bg-stone-100" %>
      </div>
      <div class="mt-5 space-y-4">
        <%= form.fields_for :recipe_instructions do |instruction_form| %>
          <%= render "instruction_fields", form: instruction_form %>
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit class: "cursor-pointer rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-600" %>
      <%= link_to "Cancel", recipe.persisted? ? recipe_path(recipe) : recipes_path, class: "text-sm font-medium text-stone-700 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
