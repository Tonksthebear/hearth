<div id="recipe_form">
  <%= form_with model: recipe, class: "mt-8 space-y-8" do |form| %>
    <% if recipe.errors.any? %>
      <div id="recipe-errors" class="rounded-lg border border-danger-200 bg-danger-50 dark:bg-danger-500/10 p-4 text-danger-800 dark:text-danger-300">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5">
          <% recipe.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="grid gap-5 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5 sm:grid-cols-2">
      <legend class="px-2 text-lg font-semibold">Recipe details</legend>
      <div class="sm:col-span-2">
        <%= form.label :title, class: :label %>
        <%= form.text_field :title, required: true, class: :text_field %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :description, class: :label %>
        <%= form.text_area :description, rows: 3, class: :text_field %>
      </div>
      <div>
        <%= form.label :yield, "Yield", class: :label %>
        <%= form.text_field :yield, placeholder: "4 servings", class: :text_field %>
      </div>
      <div>
        <%= form.label :provenance_status, "Provenance", class: :label %>
        <%= form.elements_select :provenance_status,
          provenance_statuses.map { |status| [ status.humanize, status ] },
          { include_blank: "Choose a status" },
          required: true %>
      </div>
      <div>
        <%= form.label :source_name, "Source name", class: :label %>
        <%= form.text_field :source_name, required: true, class: :text_field %>
      </div>
      <div>
        <%= form.label :source_url, "Source URL", class: :label %>
        <%= form.url_field :source_url, class: :text_field %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <div class="flex items-center justify-between gap-4">
        <legend class="text-lg font-semibold">Ingredients</legend>
        <%= form.button "Add ingredient",
          name: "add_ingredient",
          value: "1",
          formnovalidate: true,
          class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
      </div>
      <div class="mt-5 space-y-4">
        <%= form.fields_for :recipe_ingredients do |ingredient_form| %>
          <%= render "ingredient_fields", form: ingredient_form %>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <div class="flex items-center justify-between gap-4">
        <legend class="text-lg font-semibold">Instructions</legend>
        <%= form.button "Add step",
          name: "add_instruction",
          value: "1",
          formnovalidate: true,
          class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
      </div>
      <div class="mt-5 space-y-4">
        <%= form.fields_for :recipe_instructions do |instruction_form| %>
          <%= render "instruction_fields", form: instruction_form %>
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit class: { btn: [ :base, { lg: :base }, { primary: :solid } ] } %>
      <%= link_to "Cancel", recipe.persisted? ? recipe_path(recipe) : recipes_path, class: "text-sm font-medium text-gray-700 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
