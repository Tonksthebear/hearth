<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="grid gap-3 rounded-lg bg-gray-50 p-4 sm:grid-cols-[0.7fr_0.8fr_2fr_2fr_auto]">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div>
      <%= form.label :amount, class: :label %>
      <%= form.text_field :amount, class: :text_field %>
    </div>
    <div>
      <%= form.label :unit, class: :label %>
      <%= form.text_field :unit, class: :text_field %>
    </div>
    <div>
      <%= form.label :name, class: :label %>
      <%= form.text_field :name, required: true, class: :text_field %>
    </div>
    <div>
      <%= form.label :notes, class: :label %>
      <%= form.text_field :notes, class: :text_field %>
    </div>
    <div class="flex items-end">
      <%= form.button "Remove",
        name: "remove_ingredient",
        value: form.index,
        formnovalidate: true,
        class: "rounded-lg border border-danger-200 px-3 py-2 text-sm font-semibold text-danger-800 dark:text-danger-300 hover:bg-danger-50 dark:bg-danger-500/10",
        aria: { label: "Remove ingredient #{form.object.position}" } %>
    </div>
  </div>
<% end %>
