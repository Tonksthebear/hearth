<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="grid gap-3 rounded-lg bg-gray-50 p-4 dark:bg-white/5 sm:grid-cols-[0.7fr_0.8fr_2fr_2fr_auto]">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <%= form.hidden_field :form_key %>
    <div>
      <%= form.label :display_quantity, "Amount", class: :label %>
      <%= form.text_field :display_quantity, class: :text_field %>
    </div>
    <div>
      <%= form.label :unit, class: :label %>
      <%= form.text_field :unit, class: :text_field %>
    </div>
    <div>
      <%= form.label :display_name, "Ingredient", class: :label %>
      <%= form.elements_autocomplete :display_name,
        ingredient_name_options,
        { create: true, create_text: 'Add "{value}"' },
        {
          placeholder: "Choose or add an ingredient",
          required: true,
          data: {
            recipe_form_target: "ingredientName",
            recipe_form_key: form.object.form_key,
            action: "change->recipe-form#ingredientNameChanged"
          }
        } %>
    </div>
    <div>
      <%= form.label :notes, class: :label %>
      <%= form.text_field :notes, class: :text_field %>
    </div>
    <div class="flex items-end">
      <%= form.button "Remove",
        name: "remove_ingredient",
        value: form.index,
        formnovalidate: true,
        class: { btn: [ :base, { md: :base }, { danger: :outline } ] },
        aria: { label: "Remove ingredient #{form.object.position}" } %>
    </div>
  </div>
<% end %>
