<% content_for :title, "Edit #{@recipe.title} · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="edit-recipe-heading">
  <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared household catalog</p>
  <h1 id="edit-recipe-heading" class="mt-2 text-3xl font-semibold tracking-tight">Edit <%= @recipe.title %></h1>
  <%= render "form",
    recipe: @recipe,
    provenance_statuses: @provenance_statuses,
    ingredient_name_options: @ingredient_name_options,
    ingredient_reference_options: @ingredient_reference_options,
    nutrients: @nutrients %>
</section>
