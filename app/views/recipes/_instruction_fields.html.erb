<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="grid gap-4 rounded-lg bg-gray-50 p-4 dark:bg-white/5 sm:grid-cols-[auto_minmax(0,1fr)_auto]">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <span class="pt-8 font-semibold text-gray-500 dark:text-gray-400"><%= form.object.position %>.</span>
    <div class="min-w-0 space-y-5">
      <%= form.label :body, "Step", class: :label %>
      <%= form.text_area :body, rows: 2, required: true, class: :text_field %>

      <div class="grid gap-4 lg:grid-cols-2">
        <fieldset>
          <legend class="<%= yass(:label) %>">Duration cue</legend>
          <div class="mt-2 flex items-center rounded-md bg-white outline-1 -outline-offset-1 outline-gray-300 has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-primary-600 dark:bg-white/5 dark:outline-gray-600 dark:has-[input:focus-within]:outline-primary-500">
            <%= form.number_field :duration_amount,
              min: 0,
              step: "any",
              placeholder: "Optional",
              aria: { label: "Duration amount" },
              class: "block min-w-0 grow bg-transparent py-1.5 pr-3 pl-3 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 dark:text-white dark:placeholder:text-gray-500" %>
            <div class="grid shrink-0 grid-cols-1 focus-within:relative">
              <%= form.select :duration_unit,
                RecipeInstruction::DURATION_UNITS.map { |unit| [ unit.humanize, unit ] },
                { include_blank: "Unit" },
                {
                  aria: { label: "Duration unit" },
                  class: "col-start-1 row-start-1 w-full appearance-none rounded-md bg-transparent py-1.5 pr-8 pl-3 text-base text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 sm:text-sm/6 dark:text-gray-400 dark:*:bg-gray-800 dark:focus:outline-primary-500"
                } %>
              <%= icon "chevron-down", variant: :mini, class: "pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-gray-500 sm:size-4 dark:text-gray-400" %>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend class="<%= yass(:label) %>">Temperature cue</legend>
          <div class="mt-2 flex items-center rounded-md bg-white outline-1 -outline-offset-1 outline-gray-300 has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-primary-600 dark:bg-white/5 dark:outline-gray-600 dark:has-[input:focus-within]:outline-primary-500">
            <%= form.number_field :temperature_amount,
              step: "any",
              placeholder: "Optional",
              aria: { label: "Temperature amount" },
              class: "block min-w-0 grow bg-transparent py-1.5 pr-3 pl-3 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 dark:text-white dark:placeholder:text-gray-500" %>
            <div class="grid shrink-0 grid-cols-1 focus-within:relative">
              <%= form.select :temperature_unit,
                RecipeInstruction::TEMPERATURE_UNITS.map { |unit| [ "°#{unit}", unit ] },
                { include_blank: "Unit" },
                {
                  aria: { label: "Temperature unit" },
                  class: "col-start-1 row-start-1 w-full appearance-none rounded-md bg-transparent py-1.5 pr-8 pl-3 text-base text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-primary-600 sm:text-sm/6 dark:text-gray-400 dark:*:bg-gray-800 dark:focus:outline-primary-500"
                } %>
              <%= icon "chevron-down", variant: :mini, class: "pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-gray-500 sm:size-4 dark:text-gray-400" %>
            </div>
          </div>
        </fieldset>
      </div>

      <div>
        <%= form.label :ingredient_reference_keys, "Referenced ingredients", class: :label %>
        <p id="<%= form.field_id(:ingredient_reference_keys, :hint) %>" class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">Optional links to the ingredient lines used in this step.</p>
        <%= hidden_field_tag form.field_name(:ingredient_reference_keys, multiple: true), "", id: nil %>
        <div class="mt-2">
          <%= form.elements_autocomplete :ingredient_reference_keys,
            ingredient_reference_options,
            {
              value: form.object.ingredient_reference_keys,
              multiple: true,
              strict: true,
              settings: { closeOnSelect: false, keepOrder: true }
            },
            {
              multiple: true,
              placeholder: "Search recipe ingredients...",
              aria: { describedby: form.field_id(:ingredient_reference_keys, :hint) },
              data: { recipe_form_target: "ingredientReference" }
            } %>
        </div>
      </div>
    </div>
    <div class="flex items-end">
      <%= form.button "Remove",
        name: "remove_instruction",
        value: form.index,
        formnovalidate: true,
        class: { btn: [ :base, { md: :base }, { danger: :outline } ] },
        aria: { label: "Remove step #{form.object.position}" } %>
    </div>
  </div>
<% end %>
