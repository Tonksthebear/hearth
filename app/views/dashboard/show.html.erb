<% content_for :title, "Household week · Hearth" %>

<section aria-labelledby="household-week-heading">
  <div class="flex flex-wrap items-end justify-between gap-5">
    <div>
      <p data-household-name class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @household_week.household.name %></p>
      <h1 id="household-week-heading" class="mt-2 text-3xl font-semibold tracking-tight">Household week</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400"><%= @household_week.start_date.to_fs(:long) %>–<%= @household_week.end_date.to_fs(:long) %></p>
    </div>

    <div class="flex flex-wrap gap-2">
      <%= link_to "Log a meal", meal_week_path(date: @household_week.to_param), class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
      <%= link_to "Log a workout", new_training_session_path(date: @household_week.logging_date), class: yass(btn: [ :base, { lg: :base }, { neutral: :solid } ]) %>
      <%= link_to "Check in on habits", recovery_day_path, class: yass(btn: [ :base, { lg: :base }, { neutral: :solid } ]) %>
    </div>
  </div>

  <nav aria-label="Household week" class="mt-6 flex items-center justify-between rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-4">
    <%= link_to "Previous week", root_path(date: @household_week.previous_date), class: "font-medium text-primary-800 dark:text-primary-300 underline hover:no-underline" %>
    <%= link_to "Next week", root_path(date: @household_week.next_date), class: "font-medium text-primary-800 dark:text-primary-300 underline hover:no-underline" %>
  </nav>

  <section aria-labelledby="household-plans-heading" class="mt-10">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared operations</p>
        <h2 id="household-plans-heading" class="mt-1 text-2xl font-semibold">Household plans</h2>
      </div>
      <%= link_to "Open shopping list", shopping_list_path(date: @household_week.to_param), class: "font-semibold text-primary-800 dark:text-primary-300 underline hover:no-underline" %>
    </div>

    <div class="group/plans mt-5 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <ul id="household-plans" class="grid gap-3 has-[li]:sm:grid-cols-2">
        <% @household_week.planned_meals.each do |planned_meal| %>
          <li class="rounded-lg bg-primary-50 p-4 dark:bg-primary-500/10">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= planned_meal.planned_on.strftime("%a %-m/%-d") %></p>
            <p class="mt-1 font-semibold"><%= planned_meal.recipe.title %></p>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= planned_meal.person ? planned_meal.person.name : "Whole household" %></p>
          </li>
        <% end %>
      </ul>
      <div class="hidden py-5 text-center group-not-has-[li]/plans:block">
        <p class="font-semibold">Nothing planned for this week.</p>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Add a meal plan to start the household shopping view.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="people-activity-heading" class="mt-12">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Daily activity</p>
      <h2 id="people-activity-heading" class="mt-1 text-2xl font-semibold">Everyone at a glance</h2>
    </div>

    <div class="mt-5 grid gap-6">
      <% @household_week.person_summaries.each do |summary| %>
        <article data-current-person="<%= summary.person == @household_week.person %>" class="group/person rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5 data-[current-person=true]:border-primary-300 data-[current-person=true]:ring-2 data-[current-person=true]:ring-primary-100">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-xl font-semibold"><%= summary.person.name %></h3>
              <p class="mt-1 hidden text-sm font-semibold text-primary-800 dark:text-primary-300 group-data-[current-person=true]/person:block">Current person</p>
            </div>
            <%= link_to "Log meal for #{summary.person.name}", meal_week_path(date: @household_week.to_param), class: "text-sm font-semibold text-primary-800 dark:text-primary-300 underline hover:no-underline" if summary.person == @household_week.person %>
          </div>

          <div class="mt-5 grid gap-5 lg:grid-cols-3">
            <section aria-labelledby="person-<%= summary.person.id %>-meals" class="group/meals rounded-lg bg-gray-50 p-4 dark:bg-white/5">
              <h4 id="person-<%= summary.person.id %>-meals" class="font-semibold">Meals eaten</h4>
              <ul class="mt-3 grid gap-2">
                <% summary.meal_logs.each do |meal_log| %>
                  <li class="text-sm">
                    <span class="font-medium"><%= meal_log.description %></span>
                    <span class="block text-gray-500 dark:text-gray-400"><%= meal_log.eaten_on.strftime("%a %-m/%-d") %></span>
                  </li>
                <% end %>
              </ul>
              <p class="mt-3 hidden text-sm text-gray-500 dark:text-gray-400 group-not-has-[li]/meals:block">No meals logged this week.</p>
            </section>

            <section aria-labelledby="person-<%= summary.person.id %>-training" class="group/training rounded-lg bg-gray-50 p-4 dark:bg-white/5">
              <h4 id="person-<%= summary.person.id %>-training" class="font-semibold">Training</h4>
              <ul class="mt-3 grid gap-2">
                <% summary.training_sessions.each do |training_session| %>
                  <li class="text-sm">
                    <span class="font-medium"><%= training_session.snapshot_title %></span>
                    <span class="block text-gray-500 dark:text-gray-400"><%= training_session.performed_on.strftime("%a %-m/%-d") %> · <%= training_session.completed? ? "Completed" : "In progress" %></span>
                  </li>
                <% end %>
              </ul>
              <p class="mt-3 hidden text-sm text-gray-500 dark:text-gray-400 group-not-has-[li]/training:block">No training logged this week.</p>
            </section>

            <section aria-labelledby="person-<%= summary.person.id %>-habits" class="group/habits rounded-lg bg-gray-50 p-4 dark:bg-white/5">
              <h4 id="person-<%= summary.person.id %>-habits" class="font-semibold">Habits and recovery</h4>
              <ul class="mt-3 grid gap-3">
                <% summary.habits.each do |habit_summary| %>
                  <li>
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-sm font-medium"><%= habit_summary.habit.name %></span>
                      <% if habit_summary.history_only? %><span class="rounded-full bg-gray-200 px-2 py-1 text-xs font-semibold text-gray-600 dark:bg-white/10 dark:text-gray-300">History only</span><% end %>
                    </div>
                    <dl class="mt-2 grid grid-cols-7 gap-1">
                      <% habit_summary.days.each do |day| %>
                        <div class="text-center" title="<%= day.status.to_s.humanize %>">
                          <dt class="text-[0.65rem] font-semibold text-gray-500 dark:text-gray-400"><%= day.date.strftime("%a").first %></dt>
                          <dd data-status="<%= day.status %>" class="mt-1 h-2 rounded-full bg-gray-300 data-[status=checked]:bg-success-500 data-[status=not_checked]:bg-primary-400 data-[status=not_scheduled]:bg-gray-200 data-[status=no_record]:bg-gray-400 dark:bg-gray-600 dark:data-[status=not_scheduled]:bg-white/10 dark:data-[status=no_record]:bg-gray-600">
                            <span class="sr-only"><%= day.status.to_s.humanize %></span>
                          </dd>
                        </div>
                      <% end %>
                    </dl>
                  </li>
                <% end %>
              </ul>
              <p class="mt-3 hidden text-sm text-gray-500 dark:text-gray-400 group-not-has-[li]/habits:block">No habits configured or recorded this week.</p>
            </section>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <aside class="mt-10 rounded-xl border border-primary-200 bg-primary-50 p-5 text-sm text-primary-950 dark:border-primary-500/20 dark:bg-primary-500/10 dark:text-primary-100">
    <p class="font-semibold">Informational tracking only</p>
    <p class="mt-1">Hearth helps your household record routines and notice patterns. It does not provide medical advice, diagnosis, or treatment.</p>
  </aside>
</section>
