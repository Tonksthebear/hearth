<div class="space-y-8">
  <% if alert = flash[:alert] %>
    <p id="alert" class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-amber-900"><%= alert %></p>
  <% end %>

  <section aria-labelledby="household-heading" class="rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">Shared household</p>
    <h1 id="household-heading" class="mt-2 text-4xl font-bold tracking-tight"><%= @household.name %></h1>
    <p class="mt-3 text-stone-600">Household-wide plans and shopping views will live here as they are added.</p>
  </section>

  <section aria-labelledby="current-person-heading" class="rounded-xl border border-amber-200 bg-amber-50 p-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">Current person</p>
    <h2 id="current-person-heading" class="mt-2 text-3xl font-bold tracking-tight"><%= @person.name %></h2>
    <p class="mt-2 text-stone-600">Meals, training, habits, and recovery will live here as they are added.</p>
  </section>
</div>
