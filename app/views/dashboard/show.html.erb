<section aria-labelledby="household-heading">
  <% if notice = flash[:notice] %>
    <p id="notice" class="mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-800"><%= notice %></p>
  <% end %>

  <% if alert = flash[:alert] %>
    <p id="alert" class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-amber-900"><%= alert %></p>
  <% end %>

  <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">Household</p>
  <h1 id="household-heading" class="mt-2 text-4xl font-bold tracking-tight"><%= @household.name %></h1>
  <p class="mt-3 text-lg text-stone-600">Signed in as <span class="font-medium text-stone-900"><%= @person.name %></span>.</p>

  <div class="mt-10 rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold">Your Hearth is ready</h2>
    <p class="mt-2 text-stone-600">Meals, training, habits, and recovery will live here as they are added.</p>
  </div>
</section>
