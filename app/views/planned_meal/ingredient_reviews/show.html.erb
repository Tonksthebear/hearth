<% content_for :title, "Ingredient check · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="ingredient-review-heading">
  <div class="lg:flex lg:items-end lg:justify-between lg:gap-4">
    <div class="min-w-0 flex-1">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Ingredient check</p>
      <h1 id="ingredient-review-heading" class="mt-2 text-3xl font-semibold tracking-tight"><%= @planned_meal.recipe.title %></h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        <%= @planned_meal.planned_on.to_fs(:long) %> ·
        <%= @planned_meal.person ? @planned_meal.person.name : "Whole household" %>
      </p>
      <% if @ingredient_review.closed? %>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          This plan has been cooked, so it has left the allocation queue and already drew the stock it was holding.
          Its decisions are kept as history and can no longer be changed here.
        </p>
      <% else %>
        <p class="mt-3">
          <%= render "shared/readiness_badge", readiness: @ingredient_review.readiness %>
        </p>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          Answering a requirement changes what your household's pantry evidence can cover, so every queued meal is
          recalculated. Marking one on hand records pantry evidence for it; it never takes stock off your shelves.
        </p>
      <% end %>
    </div>
    <%= link_to "Back to the week", meal_week_path(date: @meal_week),
      class: yass(btn: [ :base, { lg: :base }, { neutral: :outline }, "mt-5 lg:mt-0" ]) %>
  </div>

  <% if @ingredient_review.awaiting_review? %>
    <div class="mt-8 bg-white shadow-sm sm:rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">Everything is on hand</h2>
        <div class="mt-2 sm:flex sm:items-start sm:justify-between">
          <div class="max-w-xl text-sm text-gray-500 dark:text-gray-400">
            <p>
              Answers every requirement you have not decided yet and records the pantry evidence each one asserts.
              Requirements you already marked missing, substituted, or not needed are left exactly as they are.
            </p>
          </div>
          <div class="mt-5 sm:mt-0 sm:ml-6 sm:flex sm:shrink-0 sm:items-center">
            <%= button_to "Everything is on hand", planned_meal_on_hand_confirmation_path(@planned_meal),
              class: yass(btn: [ :base, { md: :base }, { primary: :solid } ]) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="mt-8 overflow-hidden bg-white shadow-sm sm:rounded-md dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
    <ul id="ingredient-requirements" role="list" class="divide-y divide-gray-200 dark:divide-white/10">
      <%= render partial: "planned_meal/ingredient_reviews/requirement",
        collection: @ingredient_review.rows,
        as: :row,
        locals: { resolvable: @ingredient_review.resolvable? } %>
    </ul>

    <% if @ingredient_review.rows.empty? %>
      <div class="px-6 py-10 text-center">
        <%= icon "clipboard-document-list", class: "mx-auto size-10 text-gray-400" %>
        <h2 class="mt-3 font-semibold text-gray-900 dark:text-white">Nothing to check</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          <% if @ingredient_review.closed? %>
            This plan was cooked, so its requirements are no longer part of the household's allocation queue.
          <% else %>
            This recipe lists no ingredients yet, so there is nothing for the household to confirm.
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</section>
