<div id="workout_template_form">
  <%= form_with model: workout_template, class: "mt-8 space-y-8" do |form| %>
    <% if workout_template.errors.any? %>
      <div id="workout-template-errors" class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5"><% workout_template.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <fieldset class="grid gap-5 rounded-xl border border-stone-200 bg-white p-5 sm:grid-cols-2">
      <legend class="px-2 text-lg font-semibold">Template details</legend>
      <div class="sm:col-span-2">
        <%= form.label :title, class: "block text-sm font-medium" %>
        <%= form.text_field :title, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :description, class: "block text-sm font-medium" %>
        <%= form.text_area :description, rows: 3, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :provenance_status, "Provenance", class: "block text-sm font-medium" %>
        <%= form.select :provenance_status, provenance_statuses.map { |value| [ value.humanize, value ] }, {}, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :source_name, "Source name", class: "block text-sm font-medium" %>
        <%= form.text_field :source_name, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :source_url, "Source URL", class: "block text-sm font-medium" %>
        <%= form.url_field :source_url, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-stone-200 bg-white p-5">
      <div class="flex items-center justify-between gap-4">
        <legend class="text-lg font-semibold">Ordered workout blocks</legend>
        <%= form.button "Add block", name: "add_block", value: "1", formnovalidate: true, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold hover:bg-stone-100" %>
      </div>
      <div class="mt-5 space-y-5">
        <%= form.fields_for :workout_blocks do |block_form| %>
          <%= render "block_fields",
            form: block_form,
            block_kinds: block_kinds,
            dose_classes: dose_classes,
            entry_kinds: entry_kinds,
            exercises: exercises %>
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit class: "cursor-pointer rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-600" %>
      <%= link_to "Cancel", workout_template.persisted? ? workout_template_path(workout_template) : workout_templates_path, class: "text-sm font-medium text-stone-700 underline" %>
    </div>
  <% end %>
</div>
