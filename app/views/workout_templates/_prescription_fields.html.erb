<% coordinate = "#{block_index}:#{form.index}" %>
<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="rounded-lg border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-4">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="flex flex-wrap justify-between gap-2">
      <p class="text-sm font-semibold">Prescription <%= form.object.position %></p>
      <div class="flex gap-2">
        <% if form.object.position > 1 %>
          <%= form.button "Up", name: "move_prescription", value: "#{coordinate}:up", formnovalidate: true, class: { btn: [ :base, { xs: :base }, { neutral: :outline } ] } %>
        <% end %>
        <% if form.object.position < prescription_count %>
          <%= form.button "Down", name: "move_prescription", value: "#{coordinate}:down", formnovalidate: true, class: { btn: [ :base, { xs: :base }, { neutral: :outline } ] } %>
        <% end %>
        <%= form.button "Remove", name: "remove_prescription", value: coordinate, formnovalidate: true, class: { btn: [ :base, { xs: :base }, { danger: :outline } ] } %>
      </div>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2"><%= form.label :exercise_id, "Catalog exercise", class: :label %><%= form.elements_autocomplete :exercise_id, exercise_options, {}, { placeholder: "Choose exercise", required: true } %></div>
      <div><%= form.label :entry_kind, class: :label %><%= form.elements_select :entry_kind, entry_kinds.map { |value| [ value.humanize, value ] }, {} %></div>
      <div><%= form.label :sets_count, "Sets / rounds", class: :label %><%= form.number_field :sets_count, min: 1, class: :text_field %></div>
      <div><%= form.label :rep_min, "Min reps", class: :label %><%= form.number_field :rep_min, min: 1, class: :text_field %></div>
      <div><%= form.label :rep_max, "Max reps", class: :label %><%= form.number_field :rep_max, min: 1, class: :text_field %></div>
      <div><%= form.label :work_seconds, class: :label %><%= form.number_field :work_seconds, min: 1, class: :text_field %></div>
      <div><%= form.label :rest_seconds, class: :label %><%= form.number_field :rest_seconds, min: 0, class: :text_field %></div>
      <div><%= form.label :target_rpe, "Target RPE", class: :label %><%= form.number_field :target_rpe, min: 0, max: 10, step: 0.5, class: :text_field %></div>
      <div><%= form.label :target_rir, "Target RIR", class: :label %><%= form.number_field :target_rir, min: 0, max: 10, step: 0.5, class: :text_field %></div>
      <div><%= form.label :dose_class, "Dose override", class: :label %><%= form.elements_select :dose_class, dose_classes.map { |value| [ value.humanize, value ] }, { include_blank: "Use block default" } %></div>
      <div class="sm:col-span-2"><%= form.label :load_guidance, class: :label %><%= form.text_field :load_guidance, class: :text_field %></div>
      <div class="sm:col-span-2"><%= form.label :notes, class: :label %><%= form.text_field :notes, class: :text_field %></div>
    </div>
  </div>
<% end %>
