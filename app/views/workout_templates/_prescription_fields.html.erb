<% coordinate = "#{block_index}:#{form.index}" %>
<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="rounded-lg border border-stone-200 bg-white p-4">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="flex flex-wrap justify-between gap-2">
      <p class="text-sm font-semibold">Prescription <%= form.object.position %></p>
      <div class="flex gap-2">
        <%= form.button "Up", name: "move_prescription", value: "#{coordinate}:up", formnovalidate: true, class: "rounded border border-stone-300 px-2 py-1 text-xs" %>
        <%= form.button "Down", name: "move_prescription", value: "#{coordinate}:down", formnovalidate: true, class: "rounded border border-stone-300 px-2 py-1 text-xs" %>
        <%= form.button "Remove", name: "remove_prescription", value: coordinate, formnovalidate: true, class: "rounded border border-red-200 px-2 py-1 text-xs text-red-800" %>
      </div>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2"><%= form.label :exercise_id, "Catalog exercise", class: "block text-xs font-medium" %><%= form.collection_select :exercise_id, exercises, :id, :name, { prompt: "Choose exercise" }, required: true, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :entry_kind, class: "block text-xs font-medium" %><%= form.select :entry_kind, entry_kinds.map { |value| [ value.humanize, value ] }, {}, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :sets_count, "Sets / rounds", class: "block text-xs font-medium" %><%= form.number_field :sets_count, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :rep_min, "Min reps", class: "block text-xs font-medium" %><%= form.number_field :rep_min, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :rep_max, "Max reps", class: "block text-xs font-medium" %><%= form.number_field :rep_max, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :work_seconds, class: "block text-xs font-medium" %><%= form.number_field :work_seconds, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :rest_seconds, class: "block text-xs font-medium" %><%= form.number_field :rest_seconds, min: 0, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :target_rpe, "Target RPE", class: "block text-xs font-medium" %><%= form.number_field :target_rpe, min: 0, max: 10, step: 0.5, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :target_rir, "Target RIR", class: "block text-xs font-medium" %><%= form.number_field :target_rir, min: 0, max: 10, step: 0.5, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :dose_class, "Dose override", class: "block text-xs font-medium" %><%= form.select :dose_class, dose_classes.map { |value| [ value.humanize, value ] }, { include_blank: "Use block default" }, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div class="sm:col-span-2"><%= form.label :load_guidance, class: "block text-xs font-medium" %><%= form.text_field :load_guidance, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div class="sm:col-span-2"><%= form.label :notes, class: "block text-xs font-medium" %><%= form.text_field :notes, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
    </div>
  </div>
<% end %>
