<% content_for :title, "Workout templates · Hearth" %>
<%= render "layouts/activities_navigation" %>
<section aria-labelledby="templates-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared household catalog</p>
      <h1 id="templates-heading" class="mt-2 text-3xl font-semibold tracking-tight">Workout templates</h1>
    </div>
    <%= link_to "Add workout template", new_workout_template_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
  </div>
  <div class="mt-8 grid gap-4">
    <% @workout_templates.each do |workout_template| %>
      <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
        <h2 class="text-xl font-semibold"><%= link_to workout_template.title, workout_template, class: "text-primary-900 dark:text-primary-300 underline hover:no-underline" %></h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Source: <%= workout_template.source_name.presence || "From your household" %> · <%= workout_template.provenance_status.humanize %></p>
      </article>
    <% end %>
  </div>
</section>
