<div id="habit_form">
  <%= form_with model: habit, class: "mt-8 space-y-8" do |form| %>
    <% if habit.errors.any? %>
      <div id="habit-errors" class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5"><% habit.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <fieldset class="grid gap-5 rounded-xl border border-stone-200 bg-white p-5">
      <legend class="px-2 text-lg font-semibold">Habit details</legend>
      <div>
        <%= form.label :name, class: "block text-sm font-medium" %>
        <%= form.text_field :name, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :description, class: "block text-sm font-medium" %>
        <%= form.text_area :description, rows: 3, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-stone-200 bg-white p-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <legend class="text-lg font-semibold">Optional measurements</legend>
          <p class="mt-1 text-sm text-stone-500">Remove every row for a completion-only habit.</p>
        </div>
        <%= form.button "Add metric", name: "add_metric", value: "1", formnovalidate: true, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold hover:bg-stone-100" %>
      </div>
      <div class="mt-5 space-y-4">
        <% metric_count = habit.habit_metrics.count { |metric| !metric.marked_for_destruction? } %>
        <% active_metric_index = -1 %>
        <%= form.fields_for :habit_metrics do |metric_form| %>
          <% active_metric_index += 1 unless metric_form.object.marked_for_destruction? %>
          <%= render "metric_fields",
            form: metric_form,
            active_metric_index: active_metric_index,
            metric_count: metric_count,
            value_types: value_types %>
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit class: "cursor-pointer rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-600" %>
      <%= link_to "Cancel", habits_path, class: "text-sm font-medium text-stone-700 underline" %>
    </div>
  <% end %>
</div>
