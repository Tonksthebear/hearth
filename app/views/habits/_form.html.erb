<div id="habit_form">
  <%= form_with model: habit, class: "mt-8 space-y-8" do |form| %>
    <% if habit.errors.any? %>
      <div id="habit-errors" class="rounded-lg border border-danger-200 bg-danger-50 dark:bg-danger-500/10 p-4 text-danger-800 dark:text-danger-300">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5"><% habit.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <fieldset class="grid gap-5 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <legend class="px-2 text-lg font-semibold">Habit details</legend>
      <div>
        <%= form.label :name, class: :label %>
        <%= form.text_field :name, required: true, class: :text_field %>
      </div>
      <div>
        <%= form.label :description, class: :label %>
        <%= form.text_area :description, rows: 3, class: :text_field %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <legend class="text-lg font-semibold">Optional measurements</legend>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Remove every row for a completion-only habit.</p>
        </div>
        <%= form.button "Add metric", name: "add_metric", value: "1", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
      </div>
      <div class="mt-5 space-y-4">
        <% metric_count = habit.habit_metrics.count { |metric| !metric.marked_for_destruction? } %>
        <% active_metric_index = -1 %>
        <%= form.fields_for :habit_metrics do |metric_form| %>
          <% active_metric_index += 1 unless metric_form.object.marked_for_destruction? %>
          <%= render "metric_fields",
            form: metric_form,
            active_metric_index: active_metric_index,
            metric_count: metric_count,
            value_types: value_types %>
        <% end %>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <%= form.submit class: { btn: [ :base, { lg: :base }, { primary: :solid } ] } %>
      <%= link_to "Cancel", habits_path, class: "text-sm font-medium text-gray-700 underline" %>
    </div>
  <% end %>
</div>
