<% content_for :title, "Recovery habits" %>
<%= render "layouts/activities_navigation" %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Household catalog</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Recovery habits</h1>
    <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">Define shared habits here, then activate and configure them independently for <%= @current_person.name %>.</p>
  </div>
  <%= link_to "New habit", new_habit_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
</div>

<div class="mt-8 space-y-4">
  <% @habits.each do |habit| %>
    <% person_habit = @person_habits_by_habit_id[habit.id] %>
    <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="text-xl font-semibold"><%= habit.name %></h2>
          <% if habit.description.present? %><p class="mt-2 text-gray-600 dark:text-gray-400"><%= habit.description %></p><% end %>
          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
            <%= habit.habit_metrics.any? ? habit.habit_metrics.map(&:label).to_sentence : "Completion only" %>
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Edit definition", edit_habit_path(habit), class: "text-sm font-semibold text-primary-800 dark:text-primary-300 underline" %>
          <% if person_habit %>
            <%= link_to "Configure for #{@current_person.name}", edit_person_habit_path(person_habit), class: "text-sm font-semibold text-primary-800 dark:text-primary-300 underline" %>
          <% else %>
            <%= button_to "Activate for #{@current_person.name}", person_habits_path, params: { habit_id: habit.id }, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
          <% end %>
        </div>
      </div>
    </article>
  <% end %>
  <% if @habits.empty? %>
    <p class="rounded-xl border border-dashed border-gray-300 p-8 text-center text-gray-600 dark:text-gray-400">No recovery habits yet.</p>
  <% end %>
</div>
