<% metric = form.object %>
<% index = form.index.to_i %>
<% if metric.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if metric.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
<section class="grid gap-4 rounded-lg border border-stone-200 p-4 sm:grid-cols-2">
  <%= form.hidden_field :id if metric.persisted? %>
  <%= form.hidden_field :position %>
  <div>
    <%= form.label :key, "Stable key", class: "block text-sm font-medium" %>
    <%= form.text_field :key, placeholder: "duration", required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :label, class: "block text-sm font-medium" %>
    <%= form.text_field :label, placeholder: "Duration", required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :value_type, "Value type", class: "block text-sm font-medium" %>
    <%= form.select :value_type, value_types.map { |value| [ value.humanize, value ] }, {}, required: true, class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :unit, "Unit (number and duration only)", class: "block text-sm font-medium" %>
    <%= form.text_field :unit, placeholder: "minutes, oz, °F", class: "mt-2 block w-full rounded-lg border border-stone-300 px-3 py-2" %>
  </div>
  <div class="flex flex-wrap gap-2 sm:col-span-2">
    <% if index.positive? %>
      <%= form.button "Move up", name: "move_metric", value: "#{index}:up", formnovalidate: true, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold" %>
    <% end %>
    <% if index < metric_count - 1 %>
      <%= form.button "Move down", name: "move_metric", value: "#{index}:down", formnovalidate: true, class: "rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold" %>
    <% end %>
    <%= form.button "Remove metric", name: "remove_metric", value: index, formnovalidate: true, class: "rounded-lg border border-red-200 px-3 py-2 text-sm font-semibold text-red-800" %>
  </div>
</section>
<% end %>
