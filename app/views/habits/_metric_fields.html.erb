<% metric = form.object %>
<% if metric.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if metric.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
<section class="grid gap-4 rounded-lg border border-gray-200 p-4 sm:grid-cols-2">
  <%= form.hidden_field :id if metric.persisted? %>
  <%= form.hidden_field :position %>
  <div>
    <%= form.label :key, "Stable key", class: :label %>
    <%= form.text_field :key, placeholder: "duration", required: true, class: :text_field %>
  </div>
  <div>
    <%= form.label :label, class: :label %>
    <%= form.text_field :label, placeholder: "Duration", required: true, class: :text_field %>
  </div>
  <div>
    <%= form.label :value_type, "Value type", class: :label %>
    <%= form.elements_select :value_type, value_types.map { |value| [ value.humanize, value ] }, {}, required: true %>
  </div>
  <div>
    <%= form.label :unit, "Unit (number and duration only)", class: :label %>
    <%= form.text_field :unit, placeholder: "minutes, oz, °F", class: :text_field %>
  </div>
  <div class="flex flex-wrap gap-2 sm:col-span-2">
    <% if active_metric_index.positive? %>
      <%= form.button "Move up", name: "move_metric", value: "#{active_metric_index}:up", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
    <% end %>
    <% if active_metric_index < metric_count - 1 %>
      <%= form.button "Move down", name: "move_metric", value: "#{active_metric_index}:down", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
    <% end %>
    <%= form.button "Remove metric", name: "remove_metric", value: form.index, formnovalidate: true, class: { btn: [ :base, { md: :base }, { danger: :outline } ] } %>
  </div>
</section>
<% end %>
