<% content_for :title, "Training · Hearth" %>
<%= render "layouts/activities_navigation" %>
<section aria-labelledby="training-week-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @training_week.person.name %>'s weekly review</p>
      <h1 id="training-week-heading" class="mt-2 text-3xl font-semibold tracking-tight">Training</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400"><%= @training_week.start_date.to_fs(:long) %>–<%= @training_week.end_date.to_fs(:long) %>.</p>
    </div>
    <%= link_to "Log ad hoc workout", new_training_session_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
  </div>

  <nav aria-label="Training week" class="mt-6 flex items-center justify-between rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-4">
    <%= link_to "Previous week", training_week_path(date: @training_week.previous_date), class: "font-medium text-primary-800 dark:text-primary-300 underline" %>
    <%= link_to "Next week", training_week_path(date: @training_week.next_date), class: "font-medium text-primary-800 dark:text-primary-300 underline" %>
  </nav>

  <section aria-labelledby="progress-heading" class="mt-8">
    <h2 id="progress-heading" class="text-xl font-semibold">Weekly dose progress</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% @training_week.metrics.each do |metric| %>
        <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
          <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-400"><%= metric.label %></h3>
          <p class="mt-2 text-3xl font-semibold"><%= number_with_precision(metric.actual, precision: 1, strip_insignificant_zeros: true) %> <span class="text-sm font-normal text-gray-500 dark:text-gray-400"><%= metric.unit %></span></p>
          <% if metric.configured? %>
            <p class="mt-2 text-sm <%= metric.reached? ? "text-success-700" : "text-gray-600 dark:text-gray-400" %>">Target <%= metric.target %> · <%= metric.reached? ? "Reached" : "#{number_with_precision(metric.remaining, precision: 1, strip_insignificant_zeros: true)} remaining" %> · <%= metric.percent %>%</p>
          <% else %>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Target not configured.</p>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="targets-heading" class="mt-8 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
    <h2 id="targets-heading" class="text-xl font-semibold">Personal weekly targets</h2>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Optional tracking goals only—not medical advice or published defaults.</p>
    <% if @training_week.person.errors.any? %>
      <%= render "layouts/alert",
            class: "mt-3",
            title: "The week could not be updated:",
            messages: @training_week.person.errors.full_messages %>
    <% end %>
    <%= form_with model: @training_week.person, url: weekly_dose_target_path, method: :patch, class: "mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" do |form| %>
      <%= hidden_field_tag :date, @training_week.to_param %>
      <div><%= form.label :weekly_structured_minutes_target, "Structured minutes", class: :label %><%= form.number_field :weekly_structured_minutes_target, min: 1, class: :text_field %></div>
      <div><%= form.label :weekly_strength_sessions_target, "Strength sessions", class: :label %><%= form.number_field :weekly_strength_sessions_target, min: 1, class: :text_field %></div>
      <div><%= form.label :weekly_zone2_minutes_target, "Zone 2 minutes", class: :label %><%= form.number_field :weekly_zone2_minutes_target, min: 1, class: :text_field %></div>
      <div><%= form.label :weekly_vigorous_minutes_target, "Vigorous minutes", class: :label %><%= form.number_field :weekly_vigorous_minutes_target, min: 1, class: :text_field %></div>
      <%= form.submit "Save targets", class: { btn: [ :base, { lg: :base }, { neutral: :outline }, "justify-self-start sm:col-span-2 lg:col-span-4" ] } %>
    <% end %>
  </section>

  <section aria-labelledby="drafts-heading" class="mt-8">
    <h2 id="drafts-heading" class="text-xl font-semibold">In-progress workouts</h2>
    <div class="mt-4 grid gap-3">
      <% @training_week.in_progress_sessions.each do |session| %>
        <article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-primary-200 bg-primary-50 p-4 dark:border-primary-500/20 dark:bg-primary-500/10">
          <div><p class="font-semibold"><%= session.snapshot_title %></p><p class="text-sm text-gray-600 dark:text-gray-400"><%= session.performed_on.to_fs(:long) %> · excluded from progress until completed</p></div>
          <%= link_to "Resume workout", edit_training_session_path(session), class: yass(btn: [ :base, { md: :base }, { primary: :solid } ]) %>
        </article>
      <% end %>
      <% if @training_week.in_progress_sessions.empty? %><p class="text-sm text-gray-500 dark:text-gray-400">No workouts in progress this week.</p><% end %>
    </div>
  </section>

  <section aria-labelledby="templates-heading" class="mt-8">
    <h2 id="templates-heading" class="text-xl font-semibold">Start from a template</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <% @workout_templates.each do |workout_template| %>
        <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-4">
          <h3 class="font-semibold"><%= link_to workout_template.title, workout_template, class: "text-primary-900 dark:text-primary-300 underline" %></h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Source: <%= workout_template.source_label %> · <%= workout_template.provenance_status.humanize %></p>
          <%= button_to "Start workout", training_sessions_path, params: { template_id: workout_template.id }, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] }, form_class: "mt-3" %>
        </article>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="history-heading" class="mt-8">
    <h2 id="history-heading" class="text-xl font-semibold">Completed workouts</h2>
    <div class="mt-4 grid gap-3">
      <% @training_week.completed_sessions.each do |session| %>
        <article class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-4">
          <h3 class="font-semibold"><%= link_to session.snapshot_title, session, class: "text-primary-900 dark:text-primary-300 underline" %></h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= session.performed_on.to_fs(:long) %> · <%= session.training_session_blocks.size %> structured blocks</p>
        </article>
      <% end %>
      <% if @training_week.completed_sessions.empty? %><p class="text-sm text-gray-500 dark:text-gray-400">No completed workouts this week.</p><% end %>
    </div>
  </section>
</section>
