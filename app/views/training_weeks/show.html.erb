<% content_for :title, "Training · Hearth" %>
<section aria-labelledby="training-week-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-amber-700"><%= @training_week.person.name %>'s weekly review</p>
      <h1 id="training-week-heading" class="mt-2 text-3xl font-semibold tracking-tight">Training</h1>
      <p class="mt-2 text-stone-600"><%= @training_week.start_date.to_fs(:long) %>–<%= @training_week.end_date.to_fs(:long) %>.</p>
    </div>
    <%= link_to "Log ad hoc workout", new_training_session_path, class: "rounded-lg bg-amber-700 px-4 py-2 font-semibold text-white hover:bg-amber-600" %>
  </div>

  <nav aria-label="Training week" class="mt-6 flex items-center justify-between rounded-xl border border-stone-200 bg-white p-4">
    <%= link_to "Previous week", training_week_path(date: @training_week.previous_date), class: "font-medium text-amber-800 underline" %>
    <%= link_to "Next week", training_week_path(date: @training_week.next_date), class: "font-medium text-amber-800 underline" %>
  </nav>

  <section aria-labelledby="progress-heading" class="mt-8">
    <h2 id="progress-heading" class="text-xl font-semibold">Weekly dose progress</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% @training_week.metrics.each do |metric| %>
        <article class="rounded-xl border border-stone-200 bg-white p-5">
          <h3 class="text-sm font-semibold text-stone-600"><%= metric.label %></h3>
          <p class="mt-2 text-3xl font-semibold"><%= number_with_precision(metric.actual, precision: 1, strip_insignificant_zeros: true) %> <span class="text-sm font-normal text-stone-500"><%= metric.unit %></span></p>
          <% if metric.configured? %>
            <p class="mt-2 text-sm <%= metric.reached? ? "text-green-700" : "text-stone-600" %>">Target <%= metric.target %> · <%= metric.reached? ? "Reached" : "#{number_with_precision(metric.remaining, precision: 1, strip_insignificant_zeros: true)} remaining" %> · <%= metric.percent %>%</p>
          <% else %>
            <p class="mt-2 text-sm text-stone-500">Target not configured.</p>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="targets-heading" class="mt-8 rounded-xl border border-stone-200 bg-white p-5">
    <h2 id="targets-heading" class="text-xl font-semibold">Personal weekly targets</h2>
    <p class="mt-1 text-sm text-stone-600">Optional tracking goals only—not medical advice or published defaults.</p>
    <% if @training_week.person.errors.any? %><p class="mt-3 text-sm text-red-800"><%= @training_week.person.errors.full_messages.to_sentence %></p><% end %>
    <%= form_with model: @training_week.person, url: weekly_dose_target_path, method: :patch, class: "mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" do |form| %>
      <%= hidden_field_tag :date, @training_week.to_param %>
      <div><%= form.label :weekly_structured_minutes_target, "Structured minutes", class: "block text-xs font-medium" %><%= form.number_field :weekly_structured_minutes_target, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :weekly_strength_sessions_target, "Strength sessions", class: "block text-xs font-medium" %><%= form.number_field :weekly_strength_sessions_target, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :weekly_zone2_minutes_target, "Zone 2 minutes", class: "block text-xs font-medium" %><%= form.number_field :weekly_zone2_minutes_target, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :weekly_vigorous_minutes_target, "Vigorous minutes", class: "block text-xs font-medium" %><%= form.number_field :weekly_vigorous_minutes_target, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <%= form.submit "Save targets", class: "cursor-pointer justify-self-start rounded-lg border border-stone-300 px-4 py-2 font-semibold sm:col-span-2 lg:col-span-4" %>
    <% end %>
  </section>

  <section aria-labelledby="drafts-heading" class="mt-8">
    <h2 id="drafts-heading" class="text-xl font-semibold">In-progress workouts</h2>
    <div class="mt-4 grid gap-3">
      <% @training_week.draft_sessions.each do |session| %>
        <article class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4">
          <div><p class="font-semibold"><%= session.snapshot_title %></p><p class="text-sm text-stone-600"><%= session.performed_on.to_fs(:long) %> · excluded from progress until completed</p></div>
          <%= link_to "Resume workout", edit_training_session_path(session), class: "rounded-lg bg-amber-700 px-3 py-2 text-sm font-semibold text-white" %>
        </article>
      <% end %>
      <% if @training_week.draft_sessions.empty? %><p class="text-sm text-stone-500">No workout drafts this week.</p><% end %>
    </div>
  </section>

  <section aria-labelledby="templates-heading" class="mt-8">
    <h2 id="templates-heading" class="text-xl font-semibold">Start from a template</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <% @workout_templates.each do |workout_template| %>
        <article class="rounded-xl border border-stone-200 bg-white p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-stone-500"><%= workout_template.provenance_status.humanize %></p>
          <h3 class="mt-1 font-semibold"><%= link_to workout_template.title, workout_template, class: "text-amber-900 underline" %></h3>
          <%= button_to "Start workout", training_sessions_path, params: { template_id: workout_template.id }, class: "mt-3 rounded-lg border border-stone-300 px-3 py-2 text-sm font-semibold" %>
        </article>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="history-heading" class="mt-8">
    <h2 id="history-heading" class="text-xl font-semibold">Completed workouts</h2>
    <div class="mt-4 grid gap-3">
      <% @training_week.completed_sessions.each do |session| %>
        <article class="rounded-xl border border-stone-200 bg-white p-4">
          <h3 class="font-semibold"><%= link_to session.snapshot_title, session, class: "text-amber-900 underline" %></h3>
          <p class="mt-1 text-sm text-stone-600"><%= session.performed_on.to_fs(:long) %> · <%= session.training_session_blocks.size %> structured blocks</p>
        </article>
      <% end %>
      <% if @training_week.completed_sessions.empty? %><p class="text-sm text-stone-500">No completed workouts this week.</p><% end %>
    </div>
  </section>
</section>
