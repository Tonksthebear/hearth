<% content_for :title, "Log meal · Hearth" %>
<%= render "layouts/meals_navigation" %>

<section aria-labelledby="meal-heading" class="mx-auto max-w-5xl">
  <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= Current.person.name %>'s meals</p>
  <h1 id="meal-heading" class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">Log a meal</h1>
  <p class="mt-2 text-gray-600 dark:text-gray-400">Record what was actually eaten. Add recipes, ingredients, or faithful free text without changing the catalog.</p>
  <%= render "form", meal: @meal, recipe_options: @recipe_options, ingredient_options: @ingredient_options %>
</section>
