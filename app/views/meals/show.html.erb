<% content_for :title, "#{@meal.description} · Hearth" %>
<%= render "layouts/meals_navigation" %>

<article aria-labelledby="meal-heading" class="mx-auto max-w-5xl">
  <div class="flex flex-wrap items-start justify-between gap-5">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @meal.person.name %> · <%= @meal.eaten_on.to_fs(:long) %></p>
      <h1 id="meal-heading" class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white"><%= @meal.description %></h1>
      <% if @meal.eaten_at %><p class="mt-2 text-gray-600 dark:text-gray-400">Known time: <%= @meal.eaten_at.to_fs(:time) %></p><% end %>
    </div>
    <% if @meal.person == Current.person %>
      <div class="flex gap-3">
        <%= link_to "Edit meal", edit_meal_path(@meal), class: yass(btn: [ :base, { lg: :base }, { neutral: :outline } ]) %>
        <%= button_to "Delete meal", @meal, method: :delete, form: { data: { turbo_confirm: "Delete this meal event?" } }, class: yass(btn: [ :base, { lg: :base }, { danger: :outline } ]) %>
      </div>
    <% end %>
  </div>

  <section aria-labelledby="meal-details-heading" class="mt-10 overflow-hidden bg-white shadow-sm sm:rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:inset-ring dark:inset-ring-white/10">
    <div class="px-4 py-6 sm:px-6">
      <h2 id="meal-details-heading" class="text-base/7 font-semibold text-gray-900 dark:text-white">Meal details</h2>
      <p class="mt-1 max-w-2xl text-sm/6 text-gray-500 dark:text-gray-300">The historical event remains stable if catalog entries later change.</p>
    </div>
    <div class="border-t border-gray-100 dark:border-white/5">
      <dl class="divide-y divide-gray-100 dark:divide-white/5">
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6"><dt class="text-sm font-medium text-gray-900 dark:text-gray-100">Person</dt><dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0 dark:text-gray-300"><%= @meal.person.name %></dd></div>
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6"><dt class="text-sm font-medium text-gray-900 dark:text-gray-100">Date eaten</dt><dd class="mt-1 text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0 dark:text-gray-300"><%= @meal.eaten_on.to_fs(:long) %></dd></div>
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6"><dt class="text-sm font-medium text-gray-900 dark:text-gray-100">Meal event notes</dt><dd class="mt-1 whitespace-pre-wrap text-sm/6 text-gray-700 sm:col-span-2 sm:mt-0 dark:text-gray-300"><%= @meal.notes.presence || "None" %></dd></div>
      </dl>
    </div>
  </section>

  <div class="mt-10">
    <%= render "shared/nutrition_summary",
      summary: @meal.nutrition_summary,
      id: "meal-nutrition-heading",
      title: "Nutrition snapshot",
      description: "These values were frozen when this meal item source or portion was saved." %>
  </div>

  <section aria-labelledby="meal-items-heading" class="mt-10">
    <h2 id="meal-items-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Items eaten</h2>
    <ul role="list" class="mt-4 divide-y divide-gray-100 overflow-hidden rounded-lg bg-white shadow-sm outline-1 outline-gray-900/5 dark:divide-white/5 dark:bg-gray-800/50 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10">
      <% @meal.meal_items.each do |item| %>
        <li class="px-4 py-5 sm:px-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold text-gray-900 dark:text-white"><%= item.recipe ? link_to(item.snapshot_label, item.recipe, class: "text-primary-800 underline dark:text-primary-300") : item.snapshot_label %></p>
              <p class="mt-1 text-sm/6 text-gray-500 dark:text-gray-400"><%= item.source_kind.humanize %><%= " · #{item.portion}" if item.portion.present? %></p>
              <% tone = item.nutrition_status.start_with?("complete") ? :complete : (item.nutrition_status == "estimated" ? :estimated : (item.nutrition_status.start_with?("incomplete") ? :incomplete : :unavailable)) %>
              <span class="mt-2 <%= yass(nutrition_badge: [ :base, :sm, tone ]) %>"><span aria-hidden="true" class="<%= yass(nutrition_badge_dot: [ :base, tone ]) %>"></span><span class="sr-only">Nutrition status:</span> <%= item.nutrition_status %></span>
            </div>
            <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 inset-ring inset-ring-gray-500/10 dark:bg-gray-400/10 dark:text-gray-300 dark:inset-ring-gray-400/20">Item <%= item.position %></span>
          </div>
          <% if item.substitutions.present? %><p class="mt-3 text-sm/6 text-gray-700 dark:text-gray-300"><span class="font-medium">Substitutions:</span> <%= item.substitutions %></p><% end %>
          <% if item.notes.present? %><p class="mt-1 text-sm/6 text-gray-700 dark:text-gray-300"><span class="font-medium">Item notes:</span> <%= item.notes %></p><% end %>
          <% if item.recipe_feedback&.body.present? %>
            <div class="mt-4 rounded-lg bg-primary-50 p-4 dark:bg-primary-500/10">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-300">Recipe feedback</p>
              <p class="mt-1 whitespace-pre-wrap text-sm/6 text-primary-950 dark:text-primary-100"><%= item.recipe_feedback.body %></p>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <p class="mt-8"><%= link_to "Back to meals", meal_week_path(date: @meal.eaten_on), class: "font-medium text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300" %></p>
</article>
