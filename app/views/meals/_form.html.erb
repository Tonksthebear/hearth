<div id="meal_form">
  <%= form_with model: meal, class: "mt-8 space-y-12" do |form| %>
    <% if meal.errors.any? || meal.meal_items.any? { |item| item.errors.any? } %>
      <% messages = [ *meal.errors.full_messages, *meal.meal_items.flat_map { |item| item.errors.full_messages } ].uniq %>
      <%= render "layouts/alert", id: "meal-errors", title: "Please correct the following:", messages: messages %>
    <% end %>

    <fieldset class="border-b border-gray-900/10 pb-12 dark:border-white/10">
      <legend class="text-base/7 font-semibold text-gray-900 dark:text-white">Meal details</legend>
      <p class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">The date is required. Add a known time only when it is useful.</p>
      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= form.label :eaten_on, "Date eaten", class: :label %>
          <div class="mt-2"><%= form.date_field :eaten_on, required: true, class: :text_field %></div>
        </div>
        <div class="sm:col-span-3">
          <%= form.label :eaten_at, "Time eaten (optional)", class: :label %>
          <div class="mt-2"><%= form.datetime_local_field :eaten_at, class: :text_field %></div>
        </div>
        <div class="col-span-full">
          <%= form.label :notes, "Meal event notes", class: :label %>
          <div class="mt-2"><%= form.text_area :notes, rows: 3, class: :text_field, placeholder: "Context about this meal as a whole" %></div>
          <p class="mt-3 text-sm/6 text-gray-600 dark:text-gray-400">Recipe feedback is recorded separately on recipe-backed items below.</p>
        </div>
      </div>
    </fieldset>

    <fieldset class="border-b border-gray-900/10 pb-12 dark:border-white/10">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <legend class="text-base/7 font-semibold text-gray-900 dark:text-white">What was eaten</legend>
          <p class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">Items remain in the order entered. Removing an item closes the gaps automatically.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= form.button "Add recipe", name: "add_recipe_item", value: "1", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
          <%= form.button "Add ingredient", name: "add_ingredient_item", value: "1", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
          <%= form.button "Add free text", name: "add_free_text_item", value: "1", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
        </div>
      </div>

      <ul role="list" class="mt-8 divide-y divide-gray-100 overflow-hidden rounded-lg bg-white shadow-sm outline-1 outline-gray-900/5 dark:divide-white/5 dark:bg-gray-800/50 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10">
        <%= form.fields_for :meal_items do |item_form| %>
          <%= render "meals/item_fields", form: item_form, recipe_options: recipe_options, ingredient_options: ingredient_options %>
        <% end %>
      </ul>
    </fieldset>

    <div class="flex items-center justify-end gap-x-6">
      <%= link_to "Cancel", meal.persisted? ? meal_path(meal) : meal_week_path(date: meal.eaten_on), class: "text-sm/6 font-semibold text-gray-900 hover:text-gray-700 dark:text-gray-300 dark:hover:text-white" %>
      <%= form.submit meal.persisted? ? "Save meal" : "Log meal", class: { btn: [ :base, { lg: :base }, { primary: :solid } ] } %>
    </div>
  <% end %>
</div>
