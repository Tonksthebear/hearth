<% if form.object.marked_for_destruction? %>
  <li hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </li>
<% else %>
  <li class="px-4 py-6 sm:px-6" data-meal-item-kind="<%= form.object.source_kind %>">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :source_kind %>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 inset-ring inset-ring-gray-500/10 dark:bg-gray-400/10 dark:text-gray-300 dark:inset-ring-gray-400/20"><%= form.object.source_kind.to_s.humanize %></span>
          <span class="text-sm font-semibold text-gray-900 dark:text-white">Item <%= form.object.position %></span>
        </div>

        <div class="mt-5 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
          <div class="sm:col-span-3">
            <% if form.object.recipe? %>
              <%= form.label :recipe_id, "Recipe", class: :label %>
              <div class="mt-2"><%= form.elements_autocomplete :recipe_id, recipe_options, {}, { placeholder: "Choose a recipe", required: true } %></div>
            <% elsif form.object.ingredient? %>
              <%= form.label :ingredient_id, "Ingredient", class: :label %>
              <div class="mt-2"><%= form.elements_autocomplete :ingredient_id, ingredient_options, {}, { placeholder: "Choose an ingredient", required: true } %></div>
            <% else %>
              <%= form.label :snapshot_label, "Food or meal", class: :label %>
              <div class="mt-2"><%= form.text_field :snapshot_label, required: true, autofocus: form.index.to_i.zero?, class: :text_field, placeholder: "For example: soup and toast" %></div>
            <% end %>
          </div>

          <div class="sm:col-span-3">
            <span class="block text-sm/6 font-medium text-gray-900 dark:text-white">Portion (optional)</span>
            <div class="mt-2 flex rounded-md bg-white outline-1 -outline-offset-1 outline-gray-300 focus-within:outline-2 focus-within:-outline-offset-2 focus-within:outline-primary-600 dark:bg-white/5 dark:outline-white/10 dark:focus-within:outline-primary-500">
              <%= form.number_field :portion_amount, min: 0, step: :any, aria: { label: "Portion amount" }, class: "block min-w-0 flex-1 bg-transparent py-1.5 pr-3 pl-3 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 dark:text-white dark:placeholder:text-gray-500" %>
              <%= form.text_field :portion_unit, aria: { label: "Portion unit" }, placeholder: "servings, cups, g", class: "w-40 border-l border-gray-300 bg-transparent px-3 py-1.5 text-base text-gray-900 placeholder:text-gray-400 focus:outline-none sm:text-sm/6 dark:border-white/10 dark:text-white dark:placeholder:text-gray-500" %>
            </div>
          </div>

          <div class="sm:col-span-3">
            <%= form.label :substitutions, class: :label %>
            <div class="mt-2"><%= form.text_field :substitutions, class: :text_field, placeholder: "What changed from the usual item" %></div>
          </div>
          <div class="sm:col-span-3">
            <%= form.label :notes, "Item notes", class: :label %>
            <div class="mt-2"><%= form.text_field :notes, class: :text_field, placeholder: "Notes about this item" %></div>
          </div>

          <% if form.object.recipe? && form.object.recipe_feedback %>
            <div class="col-span-full rounded-lg bg-primary-50 p-4 dark:bg-primary-500/10">
              <%= form.fields_for :recipe_feedback do |feedback_form| %>
                <%= feedback_form.hidden_field :id if feedback_form.object.persisted? %>
                <%= feedback_form.label :body, "Recipe feedback (optional)", class: :label %>
                <div class="mt-2"><%= feedback_form.text_area :body, rows: 2, class: :text_field, placeholder: "What should your household remember about this recipe next time?" %></div>
                <p class="mt-2 text-xs/5 text-gray-600 dark:text-gray-400">Shown read-only on the recipe with <%= form.object.meal.person.name %> and the meal date.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%= form.button "Remove",
        name: "remove_item",
        value: form.index,
        formnovalidate: true,
        class: { btn: [ :base, { md: :base }, { danger: :outline } ] },
        aria: { label: "Remove item #{form.object.position}" } %>
    </div>
  </li>
<% end %>
