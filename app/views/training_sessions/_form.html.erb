<div id="training_session_form">
  <%= form_with model: training_session, class: "mt-8 space-y-8" do |form| %>
    <% if training_session.errors.any? %>
      <div id="training-session-errors" class="rounded-lg border border-danger-200 bg-danger-50 dark:bg-danger-500/10 p-4 text-danger-800 dark:text-danger-300">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5"><% training_session.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <fieldset class="grid gap-5 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5 sm:grid-cols-2">
      <legend class="px-2 text-lg font-semibold">Workout details</legend>
      <div>
        <%= form.label :snapshot_title, "Workout title", class: :label %>
        <%= form.text_field :snapshot_title, required: true, class: :text_field %>
      </div>
      <div>
        <%= form.label :performed_on, "Workout date", class: :label %>
        <%= form.date_field :performed_on, required: true, class: :text_field %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :notes, class: :label %>
        <%= form.text_area :notes, rows: 3, class: :text_field %>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
      <div class="flex items-center justify-between gap-4">
        <legend class="text-lg font-semibold">Performed blocks</legend>
        <%= form.button "Add block", name: "add_session_block", value: "1", formnovalidate: true, class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
      </div>
      <div class="mt-5 space-y-5">
        <%= form.fields_for :training_session_blocks do |block_form| %>
          <%= render "block_fields",
            form: block_form,
            exercise_options: exercise_options,
            modalities: modalities,
            movement_patterns: movement_patterns,
            block_kinds: block_kinds,
            dose_classes: dose_classes,
            entry_kinds: entry_kinds %>
        <% end %>
      </div>
    </fieldset>

    <div class="flex flex-wrap items-center gap-4">
      <%= form.submit "Save draft", class: { btn: [ :base, { lg: :base }, { neutral: :outline } ] } %>
      <% if training_session.persisted? %>
        <%= form.submit "Complete workout", name: "complete", class: { btn: [ :base, { lg: :base }, { primary: :solid } ] } %>
      <% end %>
      <%= link_to "Cancel", training_week_path(date: training_session.performed_on), class: "text-sm font-medium text-gray-700 underline" %>
    </div>
  <% end %>
</div>
