<% content_for :title, "#{@training_session.snapshot_title} · Hearth" %>
<%= render "layouts/activities_navigation" %>
<article aria-labelledby="training-session-heading">
  <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400"><%= @training_session.completed? ? "Completed workout" : "Workout in progress" %></p>
  <h1 id="training-session-heading" class="mt-2 text-3xl font-semibold tracking-tight"><%= @training_session.snapshot_title %></h1>
  <p class="mt-2 text-gray-600 dark:text-gray-400"><%= @training_session.performed_on.to_fs(:long) %> · <%= @training_session.person.name %></p>

  <% unless @training_session.completed? %>
    <div class="mt-5 flex gap-3">
      <%= link_to "Resume workout", edit_training_session_path(@training_session), class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
      <%= button_to "Delete in-progress workout", training_session_path(@training_session),
            method: :delete,
            form: { data: { turbo_confirm: "Delete this in-progress workout?" } },
            class: yass(btn: [ :base, { lg: :base }, { danger: :outline } ]) %>
    </div>
  <% end %>

  <div class="mt-8 space-y-4">
    <% @training_session.training_session_blocks.each do |block| %>
      <section class="rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400"><%= block.snapshot_block_kind.humanize %> · <%= block.snapshot_dose_class.humanize %></p>
        <h2 class="mt-1 text-xl font-semibold"><%= block.position %>. <%= block.snapshot_title %></h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= number_with_precision(block.actual_duration_seconds.to_f / 60, precision: 1, strip_insignificant_zeros: true) %> actual minutes</p>
        <div class="mt-4 space-y-3">
          <% block.training_session_exercises.each do |exercise| %>
            <div class="flex items-start gap-3 rounded-lg bg-gray-50 p-4 dark:bg-white/5">
              <%= render "exercises/thumbnail", exercise: exercise.exercise %>
              <div class="min-w-0 flex-1">
              <h3 class="font-semibold"><%= exercise.snapshot_name %></h3>
              <p class="text-sm text-gray-600 dark:text-gray-400"><%= exercise.snapshot_modality.humanize %> · <%= exercise.snapshot_movement_pattern.humanize %></p>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= exercise.target_summary %><% if exercise.cue_summary.present? %> · <%= exercise.cue_summary %><% end %><% if exercise.completed_at %> · completed <%= l exercise.completed_at, format: :short %><% end %></p>
              <ol class="mt-3 space-y-2">
                <% exercise.training_sets.each do |set| %>
                  <li class="text-sm">
                    <span class="font-medium">Row <%= set.position %></span>:
                    <%= set.performance_summary %>
                    · <%= set.dose_class.humanize %> · <%= set.completed? ? "completed" : "not completed" %>
                  </li>
                <% end %>
              </ol>
              <% if exercise.feedback_summary.present? %><p class="mt-3 text-sm text-gray-600 dark:text-gray-400"><%= exercise.feedback_summary %></p><% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <% if @training_session.snapshot_provenance_status.present? %>
    <p class="mt-8 border-t border-gray-200 pt-5 text-sm text-gray-500 dark:border-white/10 dark:text-gray-400">
      Source details: <%= @training_session.snapshot_source_label %> · <%= @training_session.snapshot_provenance_status.humanize %>. Attribution is not clinical endorsement or medical advice.
    </p>
  <% end %>
  <p class="mt-8"><%= link_to "Back to training week", training_week_path(date: @training_session.performed_on), class: "font-medium text-primary-800 dark:text-primary-300 underline" %></p>
</article>
