<% content_for :title, "Log ad hoc workout · Hearth" %>
<section aria-labelledby="new-training-session-heading">
  <p class="text-sm font-semibold uppercase tracking-wider text-amber-700"><%= Current.person.name %>'s training</p>
  <h1 id="new-training-session-heading" class="mt-2 text-3xl font-semibold tracking-tight">Log an ad hoc workout</h1>
  <%= render "form", training_session: @training_session, exercises: @exercises, modalities: @modalities, movement_patterns: @movement_patterns, block_kinds: @block_kinds, dose_classes: @dose_classes, entry_kinds: @entry_kinds %>
</section>
