<% set_coordinate = "#{coordinate}:#{form.index}" %>
<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="rounded-lg bg-gray-50 p-3 dark:bg-white/5">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <div><%= form.label :entry_kind, class: :label %><%= form.elements_select :entry_kind, entry_kinds.map { |value| [ value.humanize, value ] }, {} %></div>
      <div><%= form.label :dose_class, class: :label %><%= form.elements_select :dose_class, dose_classes.map { |value| [ value.humanize, value ] }, {} %></div>
      <div><%= form.label :reps, class: :label %><%= form.number_field :reps, min: 1, class: :text_field %></div>
      <div><%= form.label :load_amount, "Load", class: :label %><%= form.number_field :load_amount, min: 0, step: 0.01, class: :text_field %></div>
      <div><%= form.label :load_unit, class: :label %><%= form.elements_select :load_unit, TrainingSet::LOAD_UNITS, { include_blank: true } %></div>
      <div><%= form.label :duration_seconds, "Duration sec", class: :label %><%= form.number_field :duration_seconds, min: 1, class: :text_field %></div>
      <div><%= form.label :distance_amount, "Distance", class: :label %><%= form.number_field :distance_amount, min: 0, step: 0.01, class: :text_field %></div>
      <div><%= form.label :distance_unit, class: :label %><%= form.elements_select :distance_unit, TrainingSet::DISTANCE_UNITS, { include_blank: true } %></div>
      <div><%= form.label :rpe, "RPE", class: :label %><%= form.number_field :rpe, min: 0, max: 10, step: 0.5, class: :text_field %></div>
      <div><%= form.label :rir, "RIR", class: :label %><%= form.number_field :rir, min: 0, max: 10, step: 0.5, class: :text_field %></div>
      <div class="flex items-end gap-2"><%= form.toggle :completed %><%= form.label :completed, class: :label %></div>
      <div class="flex items-end"><%= form.button "Remove", name: "remove_training_set", value: set_coordinate, formnovalidate: true, class: { btn: [ :base, { sm: :base }, { danger: :outline } ] } %></div>
      <div class="sm:col-span-3 lg:col-span-6"><%= form.label :notes, class: :label %><%= form.text_field :notes, class: :text_field %></div>
    </div>
  </div>
<% end %>
