<% set_coordinate = "#{coordinate}:#{form.index}" %>
<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <div class="rounded-lg bg-stone-50 p-3">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
      <div><%= form.label :entry_kind, class: "block text-xs font-medium" %><%= form.select :entry_kind, entry_kinds.map { |value| [ value.humanize, value ] }, {}, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :dose_class, class: "block text-xs font-medium" %><%= form.select :dose_class, dose_classes.map { |value| [ value.humanize, value ] }, {}, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :reps, class: "block text-xs font-medium" %><%= form.number_field :reps, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :load_amount, "Load", class: "block text-xs font-medium" %><%= form.number_field :load_amount, min: 0, step: 0.01, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :load_unit, class: "block text-xs font-medium" %><%= form.select :load_unit, TrainingSet::LOAD_UNITS, { include_blank: true }, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :duration_seconds, "Duration sec", class: "block text-xs font-medium" %><%= form.number_field :duration_seconds, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :distance_amount, "Distance", class: "block text-xs font-medium" %><%= form.number_field :distance_amount, min: 0, step: 0.01, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :distance_unit, class: "block text-xs font-medium" %><%= form.select :distance_unit, TrainingSet::DISTANCE_UNITS, { include_blank: true }, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :rpe, "RPE", class: "block text-xs font-medium" %><%= form.number_field :rpe, min: 0, max: 10, step: 0.5, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :rir, "RIR", class: "block text-xs font-medium" %><%= form.number_field :rir, min: 0, max: 10, step: 0.5, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div class="flex items-end gap-2"><%= form.check_box :completed, class: "h-5 w-5 rounded border-stone-300" %><%= form.label :completed, class: "text-xs font-medium" %></div>
      <div class="flex items-end"><%= form.button "Remove", name: "remove_training_set", value: set_coordinate, formnovalidate: true, class: "rounded border border-red-200 px-2 py-2 text-xs text-red-800" %></div>
      <div class="sm:col-span-3 lg:col-span-6"><%= form.label :notes, class: "block text-xs font-medium" %><%= form.text_field :notes, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
    </div>
  </div>
<% end %>
