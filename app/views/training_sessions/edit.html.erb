<% content_for :title, "Record #{@training_session.snapshot_title} · Hearth" %>
<section aria-labelledby="edit-training-session-heading">
  <p class="text-sm font-semibold uppercase tracking-wider text-amber-700"><%= Current.person.name %>'s draft</p>
  <h1 id="edit-training-session-heading" class="mt-2 text-3xl font-semibold tracking-tight">Record <%= @training_session.snapshot_title %></h1>
  <%= render "form", training_session: @training_session, exercises: @exercises, modalities: @modalities, movement_patterns: @movement_patterns, block_kinds: @block_kinds, dose_classes: @dose_classes, entry_kinds: @entry_kinds %>
</section>
