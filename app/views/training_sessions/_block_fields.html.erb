<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <section class="rounded-xl bg-stone-50 p-5">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h3 class="font-semibold">Block <%= form.object.position %></h3>
      <%= form.button "Remove block", name: "remove_session_block", value: form.index, formnovalidate: true, class: "rounded border border-red-200 px-2 py-1 text-xs text-red-800" %>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div><%= form.label :snapshot_title, "Block title", class: "block text-xs font-medium" %><%= form.text_field :snapshot_title, required: true, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :snapshot_block_kind, "Block kind", class: "block text-xs font-medium" %><%= form.select :snapshot_block_kind, block_kinds.map { |value| [ value.humanize, value ] }, {}, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :snapshot_dose_class, "Block dose", class: "block text-xs font-medium" %><%= form.select :snapshot_dose_class, dose_classes.map { |value| [ value.humanize, value ] }, {}, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div><%= form.label :actual_duration_seconds, "Actual duration (seconds)", class: "block text-xs font-medium" %><%= form.number_field :actual_duration_seconds, min: 1, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
      <div class="sm:col-span-2 lg:col-span-4"><%= form.label :notes, class: "block text-xs font-medium" %><%= form.text_area :notes, rows: 2, class: "mt-1 block w-full rounded border border-stone-300 px-2 py-2" %></div>
    </div>
    <div class="mt-5 flex items-center justify-between gap-3">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-stone-500">Performed exercises</h4>
      <%= form.button "Add exercise", name: "add_session_exercise", value: form.index, formnovalidate: true, class: "rounded border border-stone-300 px-3 py-2 text-xs font-semibold" %>
    </div>
    <div class="mt-3 space-y-3">
      <%= form.fields_for :training_session_exercises do |exercise_form| %>
        <%= render "exercise_fields",
          form: exercise_form,
          block_index: form.index,
          exercises: exercises,
          modalities: modalities,
          movement_patterns: movement_patterns,
          dose_classes: dose_classes,
          entry_kinds: entry_kinds %>
      <% end %>
    </div>
  </section>
<% end %>
