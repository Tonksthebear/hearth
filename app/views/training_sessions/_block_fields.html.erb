<% if form.object.marked_for_destruction? %>
  <div hidden>
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "1" %>
  </div>
<% else %>
  <section class="rounded-xl bg-gray-50 p-5 dark:bg-white/5">
    <%= form.hidden_field :id if form.object.persisted? %>
    <%= form.hidden_field :position %>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h3 class="font-semibold">Block <%= form.object.position %></h3>
      <%= form.button "Remove block", name: "remove_session_block", value: form.index, formnovalidate: true, class: { btn: [ :base, { xs: :base }, { danger: :outline } ] } %>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div><%= form.label :snapshot_title, "Block title", class: :label %><%= form.text_field :snapshot_title, required: true, class: :text_field %></div>
      <div><%= form.label :snapshot_block_kind, "Block kind", class: :label %><%= form.elements_select :snapshot_block_kind, block_kinds.map { |value| [ value.humanize, value ] }, {} %></div>
      <div><%= form.label :snapshot_dose_class, "Block dose", class: :label %><%= form.elements_select :snapshot_dose_class, dose_classes.map { |value| [ value.humanize, value ] }, {} %></div>
      <div><%= form.label :actual_duration_seconds, "Actual duration (seconds)", class: :label %><%= form.number_field :actual_duration_seconds, min: 1, class: :text_field %></div>
      <div class="sm:col-span-2 lg:col-span-4"><%= form.label :notes, class: :label %><%= form.text_area :notes, rows: 2, class: :text_field %></div>
    </div>
    <div class="mt-5 flex items-center justify-between gap-3">
      <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Performed exercises</h4>
      <%= form.button "Add exercise", name: "add_session_exercise", value: form.index, formnovalidate: true, class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] } %>
    </div>
    <div class="mt-3 space-y-3">
      <%= form.fields_for :training_session_exercises do |exercise_form| %>
        <%= render "exercise_fields",
          form: exercise_form,
          block_index: form.index,
          exercise_options: exercise_options,
          modalities: modalities,
          movement_patterns: movement_patterns,
          dose_classes: dose_classes,
          entry_kinds: entry_kinds %>
      <% end %>
    </div>
  </section>
<% end %>
