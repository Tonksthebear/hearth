<%= form_with model: person, class: "mt-8 space-y-6" do |form| %>
  <% if person.errors.any? %>
    <div id="person-errors" class="rounded-lg border border-danger-200 bg-danger-50 dark:bg-danger-500/10 p-4 text-danger-800 dark:text-danger-300">
      <p class="font-semibold">Please correct the following:</p>
      <ul class="mt-2 list-disc pl-5">
        <% person.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Name", class: :label %>
    <%= form.text_field :name, required: true, autocomplete: "name", class: :text_field %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit class: { btn: [ :base, { lg: :base }, { primary: :solid } ] } %>
    <%= link_to "Cancel", people_path, class: "text-sm font-medium text-gray-700 underline hover:no-underline" %>
  </div>
<% end %>
