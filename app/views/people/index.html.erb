<section aria-labelledby="people-heading">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Shared household</p>
      <h1 id="people-heading" class="mt-2 text-4xl font-bold tracking-tight">People</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">Each person can have their own login for private, direct access to their daily health data.</p>
    </div>
    <%= link_to "Add person", new_person_path, class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
  </div>

  <ul class="mt-8 divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white dark:border-white/10 dark:bg-gray-800/50 shadow-sm">
    <% @people.each do |person| %>
      <li class="flex items-center justify-between gap-4 px-5 py-4">
        <div>
          <%= link_to person.name, person_path(person), class: "font-medium text-primary-800 underline hover:no-underline dark:text-primary-300" %>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= person.user ? "Has a login" : "No login yet" %></p>
        </div>
        <%= link_to "Edit", edit_person_path(person), class: "text-sm font-medium text-primary-800 dark:text-primary-300 underline hover:no-underline", "aria-label": "Edit #{person.name}" %>
      </li>
    <% end %>
  </ul>
</section>
