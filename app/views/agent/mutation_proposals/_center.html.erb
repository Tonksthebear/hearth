<div id="agent_confirmation_center">
  <% if proposal&.pending_confirmation? %>
      <%= render Elements::DialogComponent.new(id: "agent-mutation-confirmation-#{proposal.id}", open: true) do |dialog| %>
        <div class="sm:flex sm:items-start">
          <div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-warning-100 sm:mx-0 sm:size-10 dark:bg-warning-500/10">
            <%= icon "key", class: "size-6 text-warning-600 dark:text-warning-400" %>
          </div>
          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
            <%= dialog.title "Confirm agent operation for #{proposal.person.name}" %>
            <div class="mt-2 text-sm text-gray-500 dark:text-gray-400">
              <%= dialog.description proposal.preview["effect"] %>
              <p class="mt-2 text-xs">Decision due <%= time_tag proposal.deadline_at, proposal.deadline_at.to_fs(:short) %></p>
            </div>
            <% if confirmation_token %>
              <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row-reverse">
                <%= button_to "Approve once", agent_mutation_proposal_decision_path(proposal), params: { outcome: "approved", confirmation_token: confirmation_token }, class: yass(btn: [ :base, { lg: :base }, { primary: :solid }, "w-full sm:w-auto" ]) %>
                <%= button_to "Deny", agent_mutation_proposal_decision_path(proposal), params: { outcome: "denied", confirmation_token: confirmation_token }, class: yass(btn: [ :base, { lg: :base }, { danger: :solid }, "w-full sm:w-auto" ]) %>
                <%= button_to "Cancel", agent_mutation_proposal_decision_path(proposal), method: :delete, class: yass(btn: [ :base, { lg: :base }, { neutral: :solid }, "w-full sm:w-auto" ]) %>
              </div>
            <% else %>
              <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">This one-time request is no longer actionable. Ask the agent to create a fresh proposal.</p>
            <% end %>
          </div>
        </div>
      <% end %>
  <% end %>
</div>
