<div class="fixed right-4 bottom-4 z-30 rounded-lg bg-white p-3 shadow-lg outline-1 outline-black/5 dark:bg-gray-800 dark:outline-white/10" data-agent-operational-access>
  <% if authorization %>
    <p class="text-xs font-medium text-gray-900 dark:text-white">Agent operations enabled for <%= authorization.person.name %></p>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Expires <%= time_tag authorization.expires_at, authorization.expires_at.to_fs(:short) %></p>
    <%= button_to "Disable", agent_operational_authorization_path(authorization), method: :delete, class: yass(btn: [ :base, { xs: :base }, { danger: :ghost }, "mt-2" ]) %>
  <% else %>
    <p class="text-xs font-medium text-gray-900 dark:text-white">Agent access is read-only</p>
    <%= button_to "Enable operations", agent_operational_authorizations_path,
      params: { agent_session_id: agent_session.id, reason: "Enabled for this conversation and person" },
      class: yass(btn: [ :base, { xs: :base }, { primary: :solid }, "mt-2" ]) %>
  <% end %>
</div>
