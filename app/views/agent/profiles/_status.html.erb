<% styles = {
  "not_checked" => [ "bg-gray-100 text-gray-600 dark:bg-gray-400/10 dark:text-gray-400", "fill-gray-400" ],
  "pending" => [ "bg-blue-100 text-blue-700 dark:bg-blue-400/10 dark:text-blue-400", "fill-blue-500 dark:fill-blue-400" ],
  "running" => [ "bg-yellow-100 text-yellow-800 dark:bg-yellow-400/10 dark:text-yellow-500", "fill-yellow-500 dark:fill-yellow-400" ],
  "succeeded" => [ "bg-green-100 text-green-700 dark:bg-green-400/10 dark:text-green-400", "fill-green-500 dark:fill-green-400" ],
  "failed" => [ "bg-red-100 text-red-700 dark:bg-red-400/10 dark:text-red-400", "fill-red-500 dark:fill-red-400" ],
  "cancelled" => [ "bg-gray-100 text-gray-600 dark:bg-gray-400/10 dark:text-gray-400", "fill-gray-400" ],
  "expired" => [ "bg-red-100 text-red-700 dark:bg-red-400/10 dark:text-red-400", "fill-red-500 dark:fill-red-400" ]
} %>
<% badge_style, dot_style = styles.fetch(status) %>
<span class="inline-flex items-center gap-x-1.5 rounded-md px-2 py-1 text-xs font-medium <%= badge_style %>">
  <svg viewBox="0 0 6 6" aria-hidden="true" class="size-1.5 <%= dot_style %>">
    <circle r="3" cx="3" cy="3" />
  </svg>
  <%= status.humanize %>
</span>
