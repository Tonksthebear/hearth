<% request = provider.request %>
<% detection = provider.detection %>
<% connection_state = provider.connection_state %>
<% status_style = {
  connected: "bg-green-100 text-green-700 dark:bg-green-400/10 dark:text-green-400",
  failed: "bg-red-100 text-red-700 dark:bg-red-400/10 dark:text-red-400",
  in_progress: "bg-blue-100 text-blue-700 dark:bg-blue-400/10 dark:text-blue-400",
  cancelled: "bg-gray-100 text-gray-600 dark:bg-gray-400/10 dark:text-gray-400",
  authentication_required: "bg-yellow-100 text-yellow-800 dark:bg-yellow-400/10 dark:text-yellow-400",
  not_connected: "bg-gray-100 text-gray-600 dark:bg-gray-400/10 dark:text-gray-400"
}.fetch(connection_state) %>
<% status_message = {
  connected: "Hearth starts this agent when a conversation needs it. Hearth restores active conversations after each restart.",
  failed: "Review the setup error and complete the required recovery step.",
  in_progress: "Hearth is checking the provider and saving its connection.",
  cancelled: "Setup stopped. You can continue when you are ready.",
  authentication_required: "Choose one provider authentication method to finish setup.",
  not_connected: "Connect this provider to use it in Coach conversations."
}.fetch(connection_state) %>

<article id="agent_provider_<%= provider.definition.key %>" class="overflow-hidden rounded-xl bg-white ring-1 ring-gray-950/5 shadow-sm dark:bg-gray-800/50 dark:ring-white/10 dark:shadow-none">
  <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-start sm:justify-between sm:p-6">
    <div class="min-w-0 space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white"><%= provider.definition.name %></h2>
        <div class="rounded-md px-2 py-1 text-base font-medium sm:text-sm <%= status_style %>"><%= provider.connection_status %></div>
      </div>

      <p class="max-w-2xl text-base/7 text-pretty text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= status_message %></p>
    </div>

    <% unless provider.enabled? || provider.setup_in_progress? %>
      <%= button_to "Connect", agent_setup_requests_path,
            params: { setup_request: { certified_key: provider.definition.key, action: "enable", idempotency_key: SecureRandom.uuid } },
            class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] } %>
    <% end %>
  </div>

  <% if request&.error_message.present? && !provider.configured? %>
    <div class="border-t border-red-950/10 bg-red-50 p-5 dark:border-red-400/20 dark:bg-transparent" role="alert">
      <div class="flex items-start gap-3">
        <%= icon "x-mark", variant: :mini, class: "size-4 h-lh shrink-0 text-red-500 dark:text-red-400" %>
        <div class="min-w-0 space-y-3">
          <div class="space-y-1">
            <h3 class="font-medium text-red-900 dark:text-red-200">Hearth could not connect this agent</h3>
            <p class="text-base/7 text-pretty text-red-700 sm:text-sm/6 dark:text-red-300"><%= request.error_message %></p>
          </div>
          <div class="flex flex-wrap gap-2">
            <%= link_to "Provider installation guide", provider.definition.guidance_url,
                  class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] },
                  target: "_blank", rel: "noopener noreferrer" %>
            <% unless provider.authentication_required? %>
              <%= button_to "Try again", agent_setup_requests_path,
                    params: { setup_request: { certified_key: provider.definition.key, action: "enable", idempotency_key: SecureRandom.uuid } },
                    class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] } %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if provider.authentication_required? && !provider.setup_in_progress? %>
    <div class="border-t border-gray-950/5 p-5 sm:p-6 dark:border-white/10">
      <%= form_with url: agent_setup_requests_path, scope: :setup_request, class: "space-y-5" do |form| %>
        <%= form.hidden_field :certified_key, value: provider.definition.key %>
        <%= form.hidden_field :action, value: provider.authentication_status == "failed" ? "reauthenticate" : "authenticate" %>
        <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>

        <fieldset class="space-y-3">
          <legend class="font-medium text-gray-900 dark:text-white">Authentication method</legend>
          <p class="text-base/7 text-pretty text-gray-600 sm:text-sm/6 dark:text-gray-400">
            Hearth saves your selection. The provider keeps all credentials.
          </p>
          <div class="divide-y divide-gray-950/5 rounded-lg ring-1 ring-gray-950/10 dark:divide-white/10 dark:ring-white/10">
            <% provider.authentication_methods.each do |method| %>
              <% raw_name = method["name"].presence || method.fetch("id") %>
              <% method_name = raw_name == method.fetch("id") ? raw_name.humanize : raw_name %>
              <label aria-label="<%= method_name %>" aria-description="Provider authentication method <%= method.fetch("id") %>" class="group flex cursor-pointer items-start gap-3 p-4 has-checked:bg-primary-50 first:rounded-t-lg last:rounded-b-lg dark:has-checked:bg-primary-500/10">
                <span class="group inline-grid size-5 shrink-0 grid-cols-1 sm:size-4">
                  <%= form.radio_button :authentication_method_id, method.fetch("id"), required: true,
                        class: "checked:border-primary-600 checked:bg-primary-600 focus-visible:outline-primary-600 dark:checked:border-primary-500 dark:checked:bg-primary-500 dark:focus-visible:outline-primary-500 col-start-1 row-start-1 appearance-none rounded-full border border-gray-300 bg-white focus-visible:outline-2 focus-visible:outline-offset-2 disabled:border-gray-300 disabled:bg-gray-100 disabled:checked:bg-gray-100 dark:border-white/10 dark:bg-white/5 dark:disabled:border-white/5 dark:disabled:bg-white/10 dark:disabled:checked:bg-white/10 forced-colors:appearance-auto" %>
                  <span class="pointer-events-none col-start-1 row-start-1 size-[round(down,40%,1px)] self-center justify-self-center rounded-full bg-white group-not-has-checked:opacity-0"></span>
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="break-words font-medium text-gray-900 dark:text-white"><%= method_name %></span>
                  <span class="break-all text-gray-600 dark:text-gray-400"><%= method.fetch("id") %></span>
                </span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <%= form.submit "Finish connection", class: { btn: [ :base, { md: :base }, { neutral: :outline } ] } %>
      <% end %>
    </div>
  <% end %>

  <% if provider.enabled? || request&.cancellable? %>
    <div class="flex flex-col gap-3 border-t border-gray-950/5 bg-gray-50 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6 dark:border-white/10 dark:bg-white/2.5">
      <% if !provider.enabled? %>
        <p class="text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Hearth will enable this agent after setup completes.</p>
      <% elsif provider.runtime_online? %>
        <p class="text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400">Available automatically while Hearth is running.</p>
      <% else %>
        <div class="space-y-1" role="status">
          <p class="font-medium text-gray-900 dark:text-white"><%= provider.runtime_heading %></p>
          <p class="text-base/7 text-pretty text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= provider.runtime_message %></p>
        </div>
      <% end %>

      <div class="flex shrink-0 flex-wrap gap-2">
        <% if request&.cancellable? %>
          <%= button_to "Cancel setup", agent_setup_request_cancellation_path(request), class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] } %>
        <% end %>
        <% if provider.enabled? %>
          <%= button_to "Disconnect", agent_setup_requests_path,
                params: { setup_request: { certified_key: provider.definition.key, action: "disable", idempotency_key: SecureRandom.uuid } },
                form: { data: { turbo_confirm: "Disconnect this agent and revoke its Hearth access? Provider credentials will not change." } },
                class: { btn: [ :base, { sm: :base }, { danger: :outline } ] } %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if provider.configured? && detection %>
    <details class="border-t border-gray-950/5 px-5 py-4 dark:border-white/10">
      <summary class="cursor-pointer font-medium text-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-gray-300">Connection details</summary>
      <dl class="grid grid-cols-1 gap-4 pt-4 sm:grid-cols-3">
        <div class="min-w-0">
          <dt class="font-medium text-gray-900 dark:text-white">Provider software</dt>
          <dd class="break-all text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= detection.cli_version.presence || "Installed" %></dd>
        </div>
        <div class="min-w-0">
          <dt class="font-medium text-gray-900 dark:text-white">Agent connection</dt>
          <dd class="break-all text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= detection.adapter_version.presence || "Available" %></dd>
        </div>
        <div class="min-w-0">
          <dt class="font-medium text-gray-900 dark:text-white">Authentication</dt>
          <dd class="text-base/7 text-gray-600 sm:text-sm/6 dark:text-gray-400"><%= provider.authentication_status.humanize %></dd>
        </div>
      </dl>
    </details>
  <% end %>
</article>
