<% request = provider.request %>
<% detection = provider.detection %>
<article id="agent_provider_<%= provider.definition.key %>" class="overflow-hidden bg-white shadow-sm sm:rounded-lg dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
  <div class="px-4 py-5 sm:px-6">
    <div class="flex min-w-0 flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="truncate text-base font-semibold text-gray-900 dark:text-white"><%= provider.definition.name %></h2>
          <%= render "agent/profiles/status", status: provider.request_status %>
        </div>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Certified provider: <%= provider.definition.key %></p>
      </div>
      <%= button_to "Re-check availability", agent_setup_requests_path,
            params: { setup_request: { certified_key: provider.definition.key, action: "detect", idempotency_key: SecureRandom.uuid } },
            class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] } %>
    </div>

    <dl class="mt-5 grid grid-cols-1 gap-4 border-t border-gray-100 pt-5 sm:grid-cols-3 dark:border-white/10">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Provider CLI</dt>
        <dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white"><%= detection ? (detection.cli_available? ? "Installed" : "Not detected") : "Not checked" %></dd>
        <% if detection&.cli_version.present? %><dd class="truncate text-xs text-gray-500 dark:text-gray-400"><%= detection.cli_version %></dd><% end %>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">ACP adapter</dt>
        <dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white"><%= detection ? (detection.adapter_available? ? "Available" : "Missing") : "Not checked" %></dd>
        <% if detection&.adapter_version.present? %><dd class="truncate text-xs text-gray-500 dark:text-gray-400"><%= detection.adapter_version %></dd><% end %>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Hearth profile</dt>
        <dd class="mt-1 text-sm font-medium text-gray-900 dark:text-white"><%= provider.enabled? ? "Enabled" : "Disabled" %></dd>
        <dd class="text-xs text-gray-500 dark:text-gray-400">Authentication: <%= provider.authentication_status.humanize.downcase %></dd>
      </div>
    </dl>
  </div>

  <% if request&.error_message.present? %>
    <div class="border-t border-red-200 bg-red-50 px-4 py-4 sm:px-6 dark:border-red-500/20 dark:bg-red-500/10" role="alert">
      <div class="flex">
        <div class="shrink-0"><%= icon "x-mark", variant: :mini, class: "size-5 text-red-400" %></div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Setup request failed</h3>
          <div class="mt-2 text-sm text-red-700 dark:text-red-200/85"><p><%= request.error_message %></p></div>
          <div class="mt-4">
            <div class="-mx-2 -my-1.5 flex">
              <%= button_to "Re-check availability", agent_setup_requests_path,
                    params: { setup_request: { certified_key: provider.definition.key, action: "detect", idempotency_key: SecureRandom.uuid } },
                    form: { class: "inline-flex" },
                    class: "rounded-md bg-red-50 px-2 py-1.5 text-sm font-medium text-red-800 hover:bg-red-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 dark:bg-transparent dark:text-red-200 dark:hover:bg-white/10 dark:focus-visible:outline-offset-1 dark:focus-visible:outline-red-500/50" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% elsif detection && !detection.adapter_available? %>
    <div class="border-t border-yellow-200 bg-yellow-50 px-4 py-4 sm:px-6 dark:border-yellow-500/20 dark:bg-yellow-500/10" role="status">
      <div class="flex">
        <div class="shrink-0"><%= icon "key", variant: :mini, class: "size-5 text-yellow-400" %></div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800 dark:text-yellow-200">ACP adapter missing</h3>
          <div class="mt-2 text-sm text-yellow-700 dark:text-yellow-200/85"><p>Hearth cannot install provider software. Follow the provider's official installation guidance, then re-check.</p></div>
          <div class="mt-4">
            <div class="-mx-2 -my-1.5 flex flex-wrap gap-1">
              <%= link_to "Open provider guidance", provider.definition.guidance_url,
                    class: "rounded-md bg-yellow-50 px-2 py-1.5 text-sm font-medium text-yellow-800 hover:bg-yellow-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-600 dark:bg-transparent dark:text-yellow-200 dark:hover:bg-white/10 dark:focus-visible:outline-offset-1 dark:focus-visible:outline-yellow-500/50",
                    target: "_blank", rel: "noopener noreferrer" %>
              <%= button_to "Re-check", agent_setup_requests_path,
                    params: { setup_request: { certified_key: provider.definition.key, action: "detect", idempotency_key: SecureRandom.uuid } },
                    form: { class: "inline-flex" },
                    class: "rounded-md bg-yellow-50 px-2 py-1.5 text-sm font-medium text-yellow-800 hover:bg-yellow-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-600 dark:bg-transparent dark:text-yellow-200 dark:hover:bg-white/10 dark:focus-visible:outline-offset-1 dark:focus-visible:outline-yellow-500/50" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if provider.enabled? && provider.authentication_methods.any? %>
    <% reauthentication = provider.authentication_status.in?(%w[ authenticated failed ]) %>
    <div class="border-t border-gray-100 px-4 py-5 sm:px-6 dark:border-white/10">
      <%= form_with url: agent_setup_requests_path, scope: :setup_request, class: "space-y-4" do |form| %>
        <%= form.hidden_field :certified_key, value: provider.definition.key %>
        <%= form.hidden_field :action, value: reauthentication ? "reauthenticate" : "authenticate" %>
        <%= form.hidden_field :idempotency_key, value: SecureRandom.uuid %>
          <fieldset class="space-y-3">
          <legend class="text-sm font-semibold text-gray-900 dark:text-white"><%= reauthentication ? "Choose and re-approve an authentication method" : "Choose and approve an authentication method" %></legend>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Selection is required even when the provider advertises only one method. Hearth stores the method ID and name, never provider instructions or credential paths.</p>
          <div class="-space-y-px rounded-md bg-white dark:bg-gray-800/50">
            <% provider.authentication_methods.each do |method| %>
              <% method_name = method["name"].presence || method.fetch("id") %>
              <label aria-label="<%= method_name %>" aria-description="Provider-advertised authentication method <%= method.fetch("id") %>" class="group flex cursor-pointer border border-gray-200 p-4 first:rounded-tl-md first:rounded-tr-md last:rounded-br-md last:rounded-bl-md focus:outline-hidden has-checked:relative has-checked:border-primary-200 has-checked:bg-primary-50 dark:border-gray-700 dark:has-checked:border-primary-800 dark:has-checked:bg-primary-500/10">
                <%= form.radio_button :authentication_method_id, method.fetch("id"), required: true,
                      class: "relative mt-0.5 size-4 shrink-0 appearance-none rounded-full border border-gray-300 bg-white before:absolute before:inset-1 before:rounded-full before:bg-white not-checked:before:hidden checked:border-primary-600 checked:bg-primary-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:before:bg-gray-400 dark:border-white/10 dark:bg-white/5 dark:checked:border-primary-500 dark:checked:bg-primary-500 dark:focus-visible:outline-primary-500 dark:disabled:border-white/5 dark:disabled:bg-white/10 dark:disabled:before:bg-white/20 forced-colors:appearance-auto forced-colors:before:hidden" %>
                <span class="ml-3 flex min-w-0 flex-col">
                  <span class="block text-sm font-medium text-gray-900 group-has-checked:text-primary-900 dark:text-white dark:group-has-checked:text-primary-300"><%= method_name %></span>
                  <span class="block truncate text-sm text-gray-500 group-has-checked:text-primary-700 dark:text-gray-400 dark:group-has-checked:text-primary-300/75"><%= method.fetch("id") %></span>
                </span>
              </label>
            <% end %>
          </div>
        </fieldset>
        <%= form.submit reauthentication ? "Re-authenticate" : "Approve authentication", class: { btn: [ :base, { md: :base }, { primary: :solid } ] } %>
      <% end %>
    </div>
  <% end %>

  <div class="border-t border-gray-100 bg-gray-50 px-4 py-4 sm:flex sm:items-center sm:justify-between sm:px-6 dark:border-white/10 dark:bg-white/2.5">
    <% if provider.runtime_online? %>
      <p class="text-sm text-gray-600 dark:text-gray-400">Sibling ACP runtime online</p>
    <% else %>
      <div class="flex" role="status">
        <div class="shrink-0"><%= icon "bolt", variant: :mini, class: "size-5 text-blue-400" %></div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800 dark:text-blue-200"><%= provider.runtime_heading %></h3>
          <div class="mt-2 text-sm text-blue-700 dark:text-blue-200/85"><p><%= provider.runtime_message %></p></div>
          <div class="mt-4">
            <div class="-mx-2 -my-1.5 flex">
              <%= button_to "Queue availability check", agent_setup_requests_path,
                    params: { setup_request: { certified_key: provider.definition.key, action: "detect", idempotency_key: SecureRandom.uuid } },
                    form: { class: "inline-flex" },
                    class: "rounded-md bg-transparent px-2 py-1.5 text-sm font-medium text-blue-800 hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:text-blue-200 dark:hover:bg-white/10 dark:focus-visible:outline-offset-1 dark:focus-visible:outline-blue-500/50" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <div class="mt-3 flex flex-wrap gap-2 sm:mt-0">
      <% if request&.cancellable? %>
        <%= button_to "Cancel request", agent_setup_request_cancellation_path(request), class: { btn: [ :base, { sm: :base }, { neutral: :outline } ] } %>
      <% end %>
      <% if !provider.enabled? && detection&.adapter_available? %>
        <%= button_to "Enable", agent_setup_requests_path, params: { setup_request: { certified_key: provider.definition.key, action: "enable", idempotency_key: SecureRandom.uuid } }, class: { btn: [ :base, { sm: :base }, { primary: :solid } ] } %>
      <% elsif provider.enabled? %>
        <%= button_to "Disable and revoke", agent_setup_requests_path,
              params: { setup_request: { certified_key: provider.definition.key, action: "disable", idempotency_key: SecureRandom.uuid } },
              form: { data: { turbo_confirm: "Disable this agent and revoke its Hearth access? Provider credentials will not be changed." } },
              class: { btn: [ :base, { sm: :base }, { danger: :outline } ] } %>
      <% end %>
    </div>
  </div>
</article>
