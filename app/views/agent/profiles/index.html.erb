<% content_for :title, "Agent settings · Hearth" %>

<%= turbo_stream_from Current.household %>

<div class="mx-auto max-w-5xl">
  <div class="border-b border-gray-200 pb-5 dark:border-white/10">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary-700 dark:text-primary-400">Settings</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Agents</h1>
    <p class="mt-2 max-w-3xl text-sm/6 text-gray-600 dark:text-gray-400">Certified ACP agents can read the household context you authorize. Provider credentials stay in the provider-owned credential store; Hearth saves only setup status and the authentication method identity you explicitly approve.</p>
  </div>

  <div class="mt-8 space-y-5">
    <%= render partial: "provider", collection: @providers %>
  </div>

  <p class="mt-8 text-sm text-gray-500 dark:text-gray-400">Conversation permissions are separate from installation and authentication. Hearth asks again before any operational write.</p>
</div>
