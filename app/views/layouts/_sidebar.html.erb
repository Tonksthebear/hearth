<div class="relative flex grow flex-col gap-y-5 overflow-y-auto bg-primary-700 px-6 pb-4 dark:bg-primary-900 dark:ring-1 dark:ring-white/10">
  <div class="flex h-16 shrink-0 items-center">
    <%= link_to root_path, class: "flex items-center gap-3 rounded-md text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" do %>
      <span class="flex size-9 items-center justify-center rounded-lg bg-white/15">
        <%= icon "heart", variant: :solid, class: "size-6" %>
      </span>
      <span class="text-lg font-bold tracking-tight">Hearth</span>
    <% end %>
  </div>

  <nav class="flex-1" aria-label="Primary">
    <ul role="list" class="-mx-2 space-y-1">
      <% @primary_navigation.each do |item| %>
        <%= render "layouts/sidebar_link", **item %>
      <% end %>
    </ul>
  </nav>

  <div class="mt-auto">
    <%= render "layouts/account_menu" %>
  </div>
</div>
