<!DOCTYPE html>
<html class="h-full bg-gray-50 dark:bg-gray-900">
  <head>
    <title><%= content_for(:title) || "Hearth" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hearth">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-gray-900 dark:text-white" style="--sidebar-width: 18rem">
    <% if authenticated? %>
      <%= render Elements::SidebarComponent.new do |sidebar| %>
        <% sidebar.with_sidebar do %>
          <%= render "layouts/sidebar" %>
        <% end %>

        <% sidebar.with_header(class: "border-b border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-900 dark:shadow-none lg:flex") do %>
          <div class="flex flex-1 items-center justify-between gap-x-4">
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-gray-900 dark:text-white" data-household-name><%= @household.name %></p>
              <p class="truncate text-xs text-gray-500 dark:text-gray-400"><%= @current_person.name %></p>
            </div>
            <div class="flex items-center gap-2">
              <%= render "layouts/person_menu" %>
              <%= button_to "Sign out", session_path,
                    method: :delete,
                    form: { data: { turbo_confirm: "Sign out of Hearth?" } },
                    class: yass(btn: [ :base, { md: :base }, { neutral: :ghost } ]) %>
            </div>
          </div>
        <% end %>

        <div class="py-8 sm:py-10">
          <div class="px-4 sm:px-6 lg:px-8">
            <%= render "layouts/flash" %>
            <%= yield %>
          </div>
        </div>
      <% end %>
    <% else %>
      <main class="min-h-full">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
