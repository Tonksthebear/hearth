<nav aria-label="Meals" class="mb-8">
  <div class="<%= yass(nav_tabs: :list) %>">
    <% @secondary_navigation.each do |item| %>
      <%= link_to item[:label], item[:path],
            aria: (item[:active] ? { current: "page" } : {}),
            data: item[:data],
            class: yass(nav_tabs: :tab) %>
    <% end %>
  </div>
</nav>
