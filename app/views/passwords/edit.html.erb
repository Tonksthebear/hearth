<% content_for :title, "Update password · Hearth" %>

<div class="flex min-h-full flex-1 flex-col justify-center px-4 py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="mx-auto flex size-12 items-center justify-center rounded-xl bg-primary-600 text-white shadow-sm dark:bg-primary-500">
      <%= icon "lock-closed", class: "size-7" %>
    </div>
    <h1 class="mt-6 text-center text-2xl/9 font-bold tracking-tight text-gray-900 dark:text-white">Update your password</h1>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-white px-6 py-12 shadow-sm sm:rounded-lg sm:px-12 dark:bg-gray-800/50 dark:shadow-none dark:outline dark:-outline-offset-1 dark:outline-white/10">
      <%= form_with url: password_path(@token), method: :put, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :password, "New password", class: :label %>
          <div class="mt-2">
            <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72, class: :text_field %>
          </div>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm new password", class: :label %>
          <div class="mt-2">
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72, class: :text_field %>
          </div>
        </div>

        <%= form.submit "Save", class: { btn: [ :base, { xl: :base }, { primary: :solid }, "w-full" ] } %>
      <% end %>
    </div>
  </div>
</div>
