<% import_run = local_assigns[:import_run] %>
<div id="workout_guide_import">
  <div class="border-b border-gray-200 pb-5 sm:flex sm:items-center sm:justify-between dark:border-white/10">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white">Workout Guide catalog</h2>
    <div class="mt-3 sm:mt-0 sm:ml-4">
      <%= button_to import_action_label, workout_guide_import_path,
            disabled: !catalog_import_available,
            class: yass(btn: [ :base, { lg: :base }, { primary: :solid } ]) %>
    </div>
  </div>

  <% if import_run.nil? %>
    <div class="relative mt-6 block w-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center dark:border-white/15">
      <p class="text-sm font-semibold text-gray-900 dark:text-white">No catalog import yet</p>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Import the Workout Guide to add source-linked exercises. This does not overwrite household-authored values on later updates.</p>
    </div>
  <% elsif import_run.active? %>
    <div class="mt-6">
      <%= render "layouts/alert",
            color: :warning,
            title: "Catalog import #{import_run.status}",
            list: false,
            messages: [
              "Queued #{time_ago_in_words(import_run.created_at)} ago#{import_run.started_at.present? ? ". Started #{time_ago_in_words(import_run.started_at)} ago" : ""}.",
              "Queue or operator repair is required if this run stays queued or running. Elapsed time cannot mark it finished."
            ] %>
    </div>
  <% elsif import_run.status == "failed" %>
    <div class="mt-6">
      <%= render "layouts/alert",
            color: :danger,
            title: "Catalog import failed",
            list: false,
            messages: [ Array(import_run.failures).filter_map { |failure| failure["message"] }.first || "The import could not be completed." ] %>
    </div>
  <% else %>
    <div class="mt-6">
      <h3 class="text-base font-semibold text-gray-900 dark:text-white">Last import summary</h3>
      <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
        <% WorkoutGuide::Import::STATUSES.each do |status| %>
          <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow-sm sm:p-6 dark:bg-gray-800/75 dark:inset-ring dark:inset-ring-white/10">
            <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400"><%= status.humanize %></dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white"><%= import_run.counts.fetch(status, 0) %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% skipped = Array(import_run.skipped) %>
    <% if skipped.any? %>
      <h3 class="mt-8 text-base font-semibold text-gray-900 dark:text-white">Skipped name collisions</h3>
      <ul role="list" class="mt-3 divide-y divide-gray-100 dark:divide-white/5">
        <% skipped.each do |entry| %>
          <li class="flex gap-x-4 py-5">
            <div class="flex-auto">
              <div class="flex items-baseline justify-between gap-x-4">
                <p class="text-sm/6 font-semibold text-gray-900 dark:text-white"><%= entry["name"] %></p>
                <p class="flex-none text-xs text-gray-600 dark:text-gray-400">skipped</p>
              </div>
              <p class="mt-1 line-clamp-2 text-sm/6 text-gray-600 dark:text-gray-400">Collides with household exercise <%= entry["colliding_name"] %>.</p>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% details = Array(import_run.details) %>
    <% if details.any? %>
      <h3 class="mt-8 text-base font-semibold text-gray-900 dark:text-white">Record results</h3>
      <ul role="list" class="mt-3 divide-y divide-gray-100 dark:divide-white/5">
        <% details.each do |entry| %>
          <li class="flex gap-x-4 py-5">
            <div class="flex-auto">
              <div class="flex items-baseline justify-between gap-x-4">
                <p class="text-sm/6 font-semibold text-gray-900 dark:text-white"><%= entry["name"] %></p>
                <p class="flex-none text-xs text-gray-600 dark:text-gray-400"><%= entry["status"] %></p>
              </div>
              <p class="mt-1 line-clamp-2 text-sm/6 text-gray-600 dark:text-gray-400">
                Changed: <%= Array(entry["changes"]).presence&.join(", ") || "none" %>.
                Preserved: <%= Array(entry["preserved"]).presence&.join(", ") || "none" %>.
                <% if Array(entry["reasons"]).any? %>Reasons: <%= entry["reasons"].join(", ") %>.<% end %>
              </p>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
