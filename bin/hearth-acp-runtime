#!/usr/bin/env ruby

require "optparse"

File.umask(0o077)

options = {
  conversation_id: nil,
  development: false,
  evidence: nil,
  hold: 0,
  hold_until: nil,
  once: false,
  prompt: nil,
  root: Dir.pwd,
  session_id: nil
}

parser = OptionParser.new do |arguments|
  arguments.banner = "Usage: bin/hearth-acp-runtime [options]"
  arguments.on("--development", "Use checkout-local development databases and tmp state") { options[:development] = true }
  arguments.on("--root PATH", "Previously initialized Hearth instance root") { |value| options[:root] = value }
  arguments.on("--conversation ID", Integer, "Create an ACP session for this persisted conversation") { |value| options[:conversation_id] = value }
  arguments.on("--session ID", Integer, "Recover this persisted Agent::Session") { |value| options[:session_id] = value }
  arguments.on("--prompt TEXT", "Send one text prompt after start or recovery") { |value| options[:prompt] = value }
  arguments.on("--hold SECONDS", Float, "Keep the child alive before prompting (boundary proof)") { |value| options[:hold] = value }
  arguments.on("--hold-until PATH", "Wait for this release file before prompting (boundary proof)") { |value| options[:hold_until] = value }
  arguments.on("--evidence PATH", "Append one sanitized ACP-only runtime JSONL row") { |value| options[:evidence] = value }
  arguments.on("--once", "Perform due recovery or the selected operation, then stop") { options[:once] = true }
end
parser.parse!(ARGV)
abort parser.to_s unless ARGV.empty?
abort "Choose either --conversation or --session, not both" if
  options.values_at(:conversation_id, :session_id).compact.length > 1

ENV["RAILS_ENV"] ||= options[:development] ? "development" : "production"
require_relative "../app/models/hearth/instance"
if options[:development]
  abort "--development requires RAILS_ENV=development" unless ENV["RAILS_ENV"] == "development"
  instance = Hearth::Instance.new(File.expand_path("..", __dir__))
else
  instance = Hearth::Instance.new(options[:root]).require_initialized!.prepare_runtime!
  instance.environment(runtime: true).each { |name, value| ENV[name] ||= value } if ENV["RAILS_ENV"] == "production"
end
instance_root = instance.root
require_relative "../config/environment"
require "json"

stop_requested = false
fatal_error = nil
%w[ INT TERM ].each { |signal| Signal.trap(signal) { stop_requested = true } }

real_grok_acceptance = ENV["HEARTH_REAL_GROK_SYSTEM_TEST"] == "1"
acceptance_environment = real_grok_acceptance ? Agent::Profile::Certified::GROK_ACCEPTANCE_ENVIRONMENT : nil
runtime_directory = Acp::RuntimeDirectory.new(instance_root: instance_root, development: options[:development]).acquire!
at_exit { runtime_directory.release! }

if options[:development]
  delays = [ 0.25, 0.5, 1, 2, 5 ].freeze
  attempt = 0
  until stop_requested
    begin
      ActiveRecord::Migration.check_all_pending!
      ready = ActiveRecord::Base.connection.data_source_exists?("households") &&
        ActiveRecord::Base.connection.data_source_exists?("agent_runtime_statuses") &&
        Household.exists?
      break if ready

      message = "database migrations and household setup"
    rescue ActiveRecord::ActiveRecordError, SQLite3::Exception => error
      message = "database readiness (#{error.class.name})"
    end
    delay = delays.fetch([ attempt, delays.length - 1 ].min)
    warn "Hearth ACP is waiting for #{message} (retrying in #{delay}s)"
    sleep delay
    attempt += 1
  end
end

exit 0 if stop_requested

supervisor = Acp::Supervisor.new(
  instance_root: instance_root,
  runtime_directory: runtime_directory,
  runtime_capability_groups: real_grok_acceptance ? Agent::Grant::READ_ONLY_RUNTIME_GROUPS : nil,
  acceptance_environment: acceptance_environment,
  on_fatal: ->(_agent_session, error) {
    fatal_error ||= error
    stop_requested = true
  }
).start!
runtime_owner = "runtime-#{Process.pid}"
Agent::RuntimeStatus.start_all!(owner: runtime_owner)
turn_runtime = Agent::Turn::Runtime.new(
  supervisor: supervisor,
  owner: runtime_owner,
  stopping: -> { stop_requested }
)
setup_runtime = Agent::SetupRequest::Runtime.new(
  instance: instance,
  supervisor: supervisor,
  owner: runtime_owner,
  acceptance_environment: acceptance_environment
)
Agent::RuntimeStatus.heartbeat_all!(owner: runtime_owner)

agent_session = nil
operation = "recover_due"
operation_error = nil
begin
  if options[:conversation_id]
    conversation = Agent::Conversation.find(options[:conversation_id])
    agent_session = supervisor.start_session(conversation: conversation)
    operation = "new"
  elsif options[:session_id]
    agent_session = supervisor.recover_session(Agent::Session.find(options[:session_id]))
    operation = "recover"
  else
    operation = "request_queue"
    setup_request = setup_runtime.run_next
    agent_session = turn_runtime.run_next&.agent_session unless setup_request
    supervisor.tick unless setup_request
  end

  sleep(options[:hold]) if options[:hold].positive?
  while options[:hold_until] && !File.exist?(options[:hold_until]) && !stop_requested
    sleep 0.05
  end
  turn = if options[:prompt] && agent_session&.status == "connected"
    supervisor.prompt(agent_session, [ { type: "text", text: options[:prompt] } ])
  end
  operation_error = agent_session&.recovery_error unless agent_session&.status.in?([ nil, "connected" ])

  if options[:evidence]
    connection = supervisor.connection_for(agent_session) if agent_session&.status == "connected"
    updates = connection ? connection.drain_events : []
    storage = instance.storage_path.expand_path
    database_targets = if Rails.env.production?
      ActiveRecord::Base.configurations.configs_for(env_name: Rails.env).to_h do |configuration|
        database = Pathname.new(configuration.database).expand_path
        relative = if database.to_s.start_with?("#{storage}#{File::SEPARATOR}")
          database.relative_path_from(storage).to_s
        else
          "[outside-instance]"
        end
        [ configuration.name, relative ]
      end
    end
    evidence = {
      evidence_schema: "hearth_acp_runtime/v1",
      observed_at: Time.current.iso8601,
      outcome: fatal_error || operation_error ? "failed" : "observed",
      operation: operation,
      protocol_version: agent_session&.installation&.protocol_version,
      agent: agent_session && {
        name: File.basename(agent_session.installation.external_id),
        version: agent_session.installation.agent_version
      },
      capabilities: agent_session && {
        load_session: !!agent_session.advertised_capabilities["loadSession"],
        session: %w[ list resume close ].select do |name|
          agent_session.advertised_capabilities.dig("sessionCapabilities", name)
        end
      },
      session_persisted: agent_session&.persisted? || false,
      stop_reason: turn&.fetch("stopReason", nil),
      update_types: updates.filter_map { |entry| entry.dig("params", "update", "sessionUpdate") }.uniq,
      update_count: updates.length + (connection&.dropped_event_count || 0),
      retained_update_count: updates.length,
      dropped_update_count: connection&.dropped_event_count || 0,
      lifecycle: {
        list_observed: supervisor.session_list_observations.key?(agent_session&.id),
        recovery_method: supervisor.recovery_methods[agent_session&.id],
        transport_status: agent_session&.status,
        mcp_authorization_status: agent_session&.mcp_authorization_status,
        recovery_error: agent_session&.recovery_error
      },
      database_targets: database_targets,
      mcp_servers: (connection&.mcp_servers || []).map do |server|
        {
          name: server["name"],
          transport: server["type"] || "stdio",
          authenticated: server.key?("headers") || server.fetch("env", []).any? { |entry| entry["name"] == "HEARTH_MCP_BEARER" }
        }
      end,
      mcp_tool_calls: agent_session ? Agent::ToolActivity.where(agent_session: agent_session).order(:id).pluck(:tool_name, :status).map { |name, status| { name: name, status: status } } : [],
      proof_scope: "ACP runtime and sanitized MCP configuration",
      supervisor_pid: Process.pid,
      agent_pid: connection&.pid,
      stderr_present: connection ? connection.stderr.present? : false
    }
    File.open(options[:evidence], "a", 0o600) { |file| file.puts(JSON.generate(evidence)) }
    puts JSON.generate(evidence)
  end

  unless options[:once]
    next_runtime_heartbeat = Time.current
    until stop_requested
      supervisor.tick
      if Time.current >= next_runtime_heartbeat
        Agent::RuntimeStatus.heartbeat_all!(owner: runtime_owner)
        next_runtime_heartbeat = Time.current + 2.seconds
      end
      processed = setup_runtime.run_next || turn_runtime.run_next
      sleep 0.1 unless processed
    end
  end
ensure
  supervisor.shutdown!
  Agent::RuntimeStatus.stop_all!(owner: runtime_owner, failed: fatal_error.present?,
    failure_category: fatal_error.present? ? "runtime_error" : nil)
end

abort "ACP runtime stopped after recovery exhaustion: #{fatal_error.message}" if fatal_error
abort "ACP runtime operation failed: #{operation_error}" if options[:once] && operation_error
